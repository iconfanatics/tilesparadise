{% assign tiny_template_suffix = template.suffix | append: ".liquid" %}{% assign tiny_page_name = template.name | replace: tiny_template_suffix, "" %}
{%- assign modified_content_for_header = content_for_header | remove: "https:\/\/boostsales.apps.avada.io\/scripttag\/avada-tracking.min.js?shop=alpha-tiles.myshopify.com" | remove: "https:\/\/boostsales.apps.avada.io\/scripttag\/avada-tracking.min.js" -%}

{%- comment -%} Delay Vitals App Scripts {%- endcomment -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: '<script data-ver=', '<script type="text/lazyload" data-ver=' -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: '<script id="vtlsAeb', '<script type="text/lazyload" id="vtlsAeb' -%}

{%- comment -%} Delay Shopify Web Pixels, Trekkie, and GTM {%- endcomment -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://cdn.shopify.com/s/trekkie.storefront', ' type="text/lazyload" src="https://cdn.shopify.com/s/trekkie.storefront' -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://cdn.shopify.com/wpm', ' type="text/lazyload" src="https://cdn.shopify.com/wpm' -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://load.gtm', ' type="text/lazyload" src="https://load.gtm' -%}

{%- comment -%} Async load all App and Shopify injected CSS (like accelerated-checkout) {%- endcomment -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: 'rel="stylesheet" type="text/css" media="all"', 'rel="stylesheet" type="text/css" media="print" onload="this.media=\'all\'"' -%}


{%- comment -%} Delay Trustpilot and Shopify Inbox Chat {%- endcomment -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://widget.trustpilot.com', ' type="text/lazyload" src="https://widget.trustpilot.com' -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://cdn.shopify.com/s/javascripts/tricorder', ' type="text/lazyload" src="https://cdn.shopify.com/s/javascripts/tricorder' -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://shopify-chat.shopifyapps.com', ' type="text/lazyload" src="https://shopify-chat.shopifyapps.com' -%}


{%- comment -%} Delay Facebook Pixel, Clarity, and Klaviyo {%- endcomment -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://connect.facebook.net', ' type="text/lazyload" src="https://connect.facebook.net' -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://scripts.clarity.ms', ' type="text/lazyload" src="https://scripts.clarity.ms' -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://static.klaviyo.com', ' type="text/lazyload" src="https://static.klaviyo.com' -%}

{%- comment -%} Delay Pickeasy {%- endcomment -%}
{%- assign modified_content_for_header = modified_content_for_header | replace: ' src="https://cdn.shopify.com/extensions/019ff06d-bb38-74aa-9b33-d78209c55f92/order-delivery-date-time-105', ' type="text/lazyload" src="https://cdn.shopify.com/extensions/019ff06d-bb38-74aa-9b33-d78209c55f92/order-delivery-date-time-105' -%}

