{%- assign selected_variant = product.selected_or_first_available_variant -%}

{%- if block.settings.show_share_buttons -%}
  {%- capture share_buttons -%}
    {%- assign share_url = shop.url | append: product.url | url_param_escape -%}
    {%- assign twitter_text = product.title | url_param_escape -%}
    {%- assign pinterest_description = product.description | strip_html | truncatewords: 15 | url_param_escape -%}
    {%- assign pinterest_image = product.featured_media | img_url: '1024x' | prepend: 'https:' -%}

    <ul class="social-media__item-list list--unstyled" role="list">
      <li class="social-media__item social-media__item--facebook">
        <a href="https://www.facebook.com/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.facebook_share' | t }}">{%- render 'icon', icon: 'facebook' -%}</a>
      </li>

      <li class="social-media__item social-media__item--pinterest">
        <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}{% if pinterest_image != blank %}&media={{ pinterest_image }}{% endif %}&description={{ pinterest_description }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.pinterest_pin' | t }}">{%- render 'icon', icon: 'pinterest' -%}</a>
      </li>

      <li class="social-media__item social-media__item--twitter">
        <a href="https://twitter.com/share?{% if twitter_text != blank %}text={{twitter_text}}&{% endif %}url={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.twitter_tweet' | t }}">{%- render 'icon', icon: 'twitter' -%}</a>
      </li>

      <li class="social-media__item">
        <a href="mailto:?&subject={{ product.title | escape }}&body={{ share_url }}" aria-label="{{ 'general.social.email_share' | t }}">{% render 'icon', icon: 'email' %}</a>
      </li>
    </ul>
  {%- endcapture -%}
{%- endif -%}

<div class="product-meta new-design-meta">
  {%- if template.name == 'product' and template != 'product.quick-view' -%}
    <h1 class="product-meta__title heading h1">{{ product.title }}</h1>
  {%- else -%}
    <h3 class="product-meta__title heading h2">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
  {%- endif -%}

  {%- if product.metafields.custom.size != blank -%}
    <div class="product-meta__size-subtitle">{{ product.metafields.custom.size }}</div>
  {%- endif -%}

  {%- if product.metafields.custom.box_quantity != blank -%}
    <div class="product-meta__pack-subtitle">Pack of {{ product.metafields.custom.box_quantity }}</div>
  {%- endif -%}

  {%- if block.settings.show_sku -%}
    <div class="product-meta__sku-subtitle" {% if selected_variant.sku == blank %}style="display: none"{% endif %}>
      <strong>Part No:</strong> <span class="product-meta__sku-number">{{ selected_variant.sku }}</span>
    </div>
  {%- endif -%}

  {%- comment -%} PRICE SECTION (ONLY FOR TILES) {%- endcomment -%}
  {%- if product.metafields.custom.tiles_per_sq != blank -%}
  <div class="product-meta__price-section">
    {%- assign price_per_m2 = selected_variant.price -%}
    {%- assign box_qty = product.metafields.custom.box_quantity | default: 1 -%}
    {%- assign sqm_per_tile = product.metafields.custom.tiles_per_sq | default: 0.72 | replace: ',', '.' | times: 1.0 -%}
    {%- assign m2_per_box = box_qty | times: sqm_per_tile -%}
    {%- assign price_per_box = price_per_m2 | times: m2_per_box -%}

    <div class="price-large">
      <span class="price-large-amount">{{ price_per_m2 | money }}</span>
      <span class="price-large-unit">/m²</span>
      {%- if selected_variant.compare_at_price > selected_variant.price -%}
        <span class="price-large-rrp" style="font-size: 16px; color: #666; text-decoration: line-through; margin-left: 10px;">RRP {{ selected_variant.compare_at_price | money }}</span>
        {%- assign savings_amount = selected_variant.compare_at_price | minus: selected_variant.price -%}
        {%- assign savings_percent = savings_amount | times: 100.0 | divided_by: selected_variant.compare_at_price | round -%}
        <span class="save_amount" style="font-size: 14px; margin-left: 10px; background: #eaf6ee; color: #1f8a4c; padding: 4px 8px; border-radius: 4px; font-weight: bold;">Save {{ savings_percent }}%</span>
      {%- endif -%}
    </div>

    <div class="price-box-info">
      <span>Price per box: <strong>{{ price_per_box | money }}</strong></span>
      <span class="price-divider">|</span>
      <span>Tiles per box: <strong>{{ box_qty }}</strong></span>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} IN STOCK & REVIEWS ROW {%- endcomment -%}
  <div class="product-meta__stock-reviews-row">
    <div class="product-meta__stock-status">
      {%- if selected_variant.inventory_management == "shopify" -%}
        {%- if selected_variant.inventory_quantity > 0 -%}
          <span class="stock-badge in-stock">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="white"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>
          </span>
          <span class="stock-text">In Stock</span>
        {%- else -%}
          <span class="stock-badge out-of-stock"></span>
          <span class="stock-text" style="color: #c8102e;">Out of Stock</span>
        {%- endif -%}
      {%- else -%}
        <span class="stock-badge in-stock">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="white"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>
        </span>
        <span class="stock-text">In Stock</span>
      {%- endif -%}
    </div>

    {%- if block.settings.show_reviews_badge -%}
      <div class="product-meta__reviews">
        <a href="#product-reviews" class="product-meta__reviews-badge link" data-offset="30">
          {%- render 'product-rating', product: product -%}
        </a>
      </div>
    {%- endif -%}
  </div>

  <hr class="product-meta__divider">

  {%- if block.settings.show_share_buttons -%}
    <div class="product-meta__share-buttons hidden-phone">
      {{ share_buttons }}
    </div>
  {%- endif -%}
</div>

