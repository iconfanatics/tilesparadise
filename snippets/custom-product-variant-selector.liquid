</div>

<!-- jquery for the actual price functionality -->
<script>
document.addEventListener("DOMContentLoaded", function () {

  const qtyInput = document.querySelector(".special-qty-display");

  const realQtyInput =
    document.getElementById("real-quantity-input");

  if (!qtyInput || !realQtyInput) return;

  const plusBtn =
    document.querySelector(".special-plus");

  const minusBtn =
    document.querySelector(".special-minus");

  /*
  ============================================
  UPDATE FUNCTION
  ============================================
  */

  function syncQty(qty) {

    qty = Math.max(1, parseInt(qty) || 1);

    /*
    Visible input
    */

    qtyInput.value = qty;

    /*
    Shopify real quantity input
    */

    realQtyInput.value = qty;

    /*
    Trigger Shopify update
    */

    realQtyInput.dispatchEvent(
      new Event("input", { bubbles: true })
    );

    realQtyInput.dispatchEvent(
      new Event("change", { bubbles: true })
    );

  }

  /*
  ============================================
  PLUS
  ============================================
  */

  plusBtn?.addEventListener("click", function () {

    syncQty(
      parseInt(qtyInput.value || 1) + 1
    );

  });

  /*
  ============================================
  MINUS
  ============================================
  */

  minusBtn?.addEventListener("click", function () {

    syncQty(
      Math.max(
        1,
        parseInt(qtyInput.value || 1) - 1
      )
    );

  });

  /*
  ============================================
  MANUAL INPUT
  ============================================
  */

  qtyInput.addEventListener("input", function () {

    syncQty(this.value);

  });

});
</script>

