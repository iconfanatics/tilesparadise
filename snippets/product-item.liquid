              {%- endif -%}
            {%- else -%}
              <button class="{{ quick_buy_classes | replace: 'button--primary', 'button--disabled' }}" disabled>{{ 'collection.product.sold_out' | t }}</button>
            {%- endif -%} {% endcomment %}

            <div class="custom-product-buttons">

              {%- if product.available -%}

                {% if show_shop_button %}
                  {%- if product.variants.size == 1 -%}
                    <button type="submit" class="{{ quick_buy_classes }}" data-action="add-to-cart">
                      {{ shop_button_label }}
                    </button>
                  {%- else -%}
                    <a href="{{ product.url }}" class="{{ quick_buy_classes }}">
                      {{ shop_button_label }}
                    </a>
                  {%- endif -%}
                {% endif %}

                {% if enable_sample_button and product.metafields.custom.item_has_a_free_sample == true and product.metafields.custom.sample_product %}
                  {% assign sampleProduct = all_products[product.metafields.custom.sample_product] %}
                  
                  <button 
                    type="button"
                    class="sample-btn cst_add"
                    data-id="{{ sampleProduct.variants.first.id }}"
                  >
                    {{ sample_button_label }}
                  </button>
                {% endif %}

              {%- else -%}

                <button class="{{ quick_buy_classes | replace: 'button--primary', 'button--disabled' }}" disabled>
                  {{ 'collection.product.sold_out' | t }}
                </button>

              {%- endif -%}

            </div>

            {%- if section.settings.show_quick_view == 'list_grid' -%}
              {%- assign quick_view_classes = 'product-item__action-button button button--small button--ternary hidden-phone' -%}
            {%- else -%}
              {%- assign quick_view_classes = 'product-item__action-button product-item__action-button--list-view-only button button--small button--ternary hidden-phone' -%}
            {%- endif -%}

            <button type="button" class="quic_mod {{ quick_view_classes }}" data-action="open-modal" data-secondary-action="open-quick-view" aria-controls="modal-quick-view-{{ section.id }}" data-product-url="{{ product.url }}">Buy</button>
            {% if show_view_button %}
              <a href="{{ product.url }}">
                <button type="button" class="view_cls">View</button>
              </a>
            {% endif %}
      {%- endform -%}
        {%- endcapture -%}

        {%- if complementary_products != true -%}
          {{- quick_buy_form -}}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </div>
{% if enable_sample_button and product.metafields.custom.item_has_a_free_sample == true and product.metafields.custom.sample_product %}
