<script>
$(document).on('click', '.modal__inner ul.tabs-nav li', function() {
    var a = $(this).index();
    $(this).addClass("tab-active");
    $(this).siblings().removeClass("tab-active");
    $(".tabs-stage .custom_tabing").eq(a).show();
    $(".tabs-stage .custom_tabing").eq(a).siblings().hide();
});

const squareMetreInput = document.getElementsByClassName("changing_class");
const step = parseFloat(squareMetreInput.value);
const price_total = document.getElementsByClassName("price_now").value;

function increaseSquareMeter() {
    const squareMeterInput = document.getElementsByClassName("changing_class");
    const step = parseFloat(squareMetreInput.value);
    const currentValue = parseFloat(squareMeterInput.value);
    squareMeterInput.value = (currentValue + step).toFixed(2);
    // Don't update the actual price here to keep it constant
}

function decreaseSquareMeter() {
    const squareMeterInput = document.getElementsByClassName("changing_class");

    const currentValue = parseFloat(squareMeterInput.value);
    if (currentValue >= step) {
        squareMeterInput.value = (currentValue - step).toFixed(2);
        // Don't update the actual price here to keep it constant
    }
}

function updateActualPrice() {
    const quantityInput = document.getElementsByClassName("quantity-selector__value");
    const squareMeterInput = document.getElementsByClassName("changing_class");
    const actualPriceInput = document.getElementsByClassName("price_now");
