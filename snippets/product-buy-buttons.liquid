<style>
  /* Outer card */
.finance-delivery-card {
  border: 1px solid #e5e5e5;
  border-radius: 6px;
  background: #fff;
  overflow: hidden;
  margin: 0 0 15px 0;
  font-size: 14px;
}
.delivery-row.second .delivery-text > div {
    position: relative;
    padding-left: 20px;
}
.delivery-row.second .delivery-text > div::before {
  content: "•";
  position: absolute;
  left: 0;
  top: 0;
  color: #111;
  font-size: 25px;
  line-height: 1;
}
.delivery-row.second .delivery-text {
    margin-left: 15px;
}
/* Klarna row */
.klarna-row {
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px;
}
.delivery-heading {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}
.delivery-heading strong {
    color: #000;
}
.delivery-heading .delivery-icon {
  color: #2e7d32;
  font-weight: 700;
  font-size: 14px;
}

/* Divider */
.delivery-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 16px;
  border-top: 1px solid #e5e5e5;
}

/* Left groups */
.klarna-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.klarna-badge svg {
  width: 48px;
  display: block;
}

/* Text */
.klarna-text,
.delivery-text {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #111;
}

.klarna-sub,
.delivery-sub {
  color: #555;
  font-weight: 400;
}

.klarna-monthly {
  color: #0081b9;
}

/* Icons */
.delivery-icon {
  color: #2e7d32;
  font-weight: 700;
}

.klarna-arrow {
  font-size: 20px;
  line-height: 1;
}

</style>


<script>

document.addEventListener("DOMContentLoaded", function () {

  function updateKlarnaMonthly(price) {
    if (!price) return;

    const months = 12;
    const monthly = (price / months).toFixed(2);

    document.querySelectorAll(".klarna-monthly").forEach(el => {
      el.textContent = `£${monthly}`;
    });
  }

  {% if product.selected_or_first_available_variant %}
    updateKlarnaMonthly({{ product.selected_or_first_available_variant.price | divided_by: 100 }});
  {% endif %}

  document.addEventListener("variant:change", function (event) {
    if (event.detail && event.detail.variant) {
      updateKlarnaMonthly(event.detail.variant.price / 100);
    }
  });

});
</script>





