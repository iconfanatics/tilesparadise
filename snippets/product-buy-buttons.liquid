    font-size:22px !important;line-height:1.3 !important;font-weight:800 !important;
    letter-spacing:-.01em !important;color:var(--tp-ink) !important;
  }

  /* ---- Price block ---- */
  .product-form__info-title{
    font-size:12px !important;font-weight:700 !important;color:var(--tp-ink) !important;
    text-transform:none !important;
  }
  .price-list .price--highlight,
  .price-list > .price{
    font-size:30px !important;font-weight:800 !important;color:var(--tp-ink) !important;
    letter-spacing:-.02em !important;line-height:1.05 !important;
  }
  .price-list .price--highlight > span,
  .price-list > .price > span{
    font-size:13px !important;font-weight:600 !important;color:var(--tp-muted) !important;
    letter-spacing:0 !important;
  }
  .price--compare{
    font-size:13px !important;font-weight:500 !important;color:var(--tp-muted) !important;
  }
  .price--compare b{font-weight:600 !important;}
  .save_amount{
    display:inline-block !important;
    font-size:15px !important;font-weight:800 !important;color:var(--tp-green-dark) !important;
    background:#eaf6ee !important;border-radius:6px !important;padding:3px 9px !important;
    margin-left:8px !important;line-height:1.2 !important;
  }
  .save_amount b{font-weight:800 !important;margin-right:2px !important;}

  /* ---- Trust strip ---- */
  .tp-trust{
    display:flex;flex-wrap:wrap;gap:12px 18px;align-items:center;justify-content:center;
    margin:18px 0 0;padding:15px 6px 0;border-top:1px solid var(--tp-line);
  }
  .tp-trust__item{
    display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:var(--tp-muted);
    font-family:"Open Sans",sans-serif;
