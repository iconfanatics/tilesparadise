{%- comment -%} ============ TP PRODUCT SKIN — match mockup (green ATC, green delivery, bold title/price) ============ {%- endcomment -%}
<style id="tp-product-skin">
  :root{
    --tp-brand:#c8102e;--tp-green:#1f8a4c;--tp-green-dark:#19733f;
    --tp-ink:#1a1d24;--tp-muted:#6b7280;--tp-line:#e6e8eb;--tp-tint:#f7f8f9;
