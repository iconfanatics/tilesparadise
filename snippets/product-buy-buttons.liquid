{%- comment -%} ============ SAMPLES (real sample variant, AJAX add — no nested form, no cloud function) ============
  Shows whenever a sample product is linked via metafields:
    custom.sample_product  /  custom.second_sample_product
  type="button" so it never submits the parent product form; adds the
  actual sample variant to cart, then opens the basket.
{%- endcomment -%}
{%- assign s1 = product.metafields.custom.sample_product.value -%}
{%- assign s2 = product.metafields.custom.second_sample_product.value -%}
{%- if s1 != blank or s2 != blank -%}
  <div class="tp-samples">
    <span class="tp-samples__h">Try before you buy</span>

    {%- if s1 != blank -%}
      <button type="button" class="tp-sample-btn js-tp-sample" data-variant-id="{{ s1.selected_or_first_available_variant.id }}"{% unless s1.available %} disabled{% endunless %}>
        <span class="lbl">Order a Cut Sample</span><b>{{ s1.price | money }}</b>
      </button>
    {%- endif -%}

    {%- if s2 != blank -%}
      <button type="button" class="tp-sample-btn js-tp-sample" data-variant-id="{{ s2.selected_or_first_available_variant.id }}"{% unless s2.available %} disabled{% endunless %}>
        <span class="lbl">Order a 20×50cm Sample</span><b>{{ s2.price | money }}</b>
      </button>
    {%- endif -%}
  </div>

  <script>
  (function(){
    var btns = document.querySelectorAll('.js-tp-sample');
    btns.forEach(function(btn){
      btn.addEventListener('click', function(){
        var id = btn.getAttribute('data-variant-id');
        if(!id){ return; }
        var lbl = btn.querySelector('.lbl');
        var original = lbl ? lbl.textContent : '';
        btn.disabled = true;
        if(lbl){ lbl.textContent = 'Adding…'; }
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
        })
        .then(function(r){ if(!r.ok){ throw new Error('add failed'); } return r.json(); })
        .then(function(){ window.location.href = '/cart'; })
        .catch(function(){
          btn.disabled = false;
          if(lbl){ lbl.textContent = original; }
          alert('Sorry, that sample could not be added. Please try again.');
        });
      });
    });
  })();
  </script>
{%- endif -%}
{%- comment -%} ============ /SAMPLES ============ {%- endcomment -%}


