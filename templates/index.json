    "faq_tDXLaa": {
      "type": "faq",
      "blocks": {
        "separator_VW97fg": {
          "type": "separator",
          "settings": {
            "title": "Samples & delivery"
          }
        },
        "question_NYkC7G": {
          "type": "question",
          "settings": {
            "title": "How long will delivery take?",
            "answer": "<p>Because everything is held in our own UK warehouse, most orders can arrive between 1-3 working days to the majority of the UK (a little longer for the Highlands and islands).<br/><br/></p>"
          }
        },
        "question_YwynjT": {
          "type": "question",
          "settings": {
            "title": "Do you offer samples?",
            "answer": "<p>Yes — order a cut sample of any tile and we'll deliver it to your door, then refund the cost against your order when you buy. It's the best way to check colour and finish in your own light.<br/><br/></p>"
          }
        },
        "question_3xCC9L": {
          "type": "question",
          "settings": {
            "title": "What if my tiles arrive damaged?",
            "answer": "<p>Tiles are well protected on the pallet, but if anything arrives damaged, take a photo while it's still on the pallet and tell us within 2 working days — we'll sort a replacement.<br/><br/></p>"
          }
        },
        "separator_fPHky4": {
          "type": "separator",
          "settings": {
            "title": "Payment, returns & help"
          }
        },
        "question_prWbjK": {
          "type": "question",
          "settings": {
            "title": "Can I pay in instalments?",
            "answer": "<p>Yes — split the cost with 0% interest-free finance through PayPal Pay in 3 or Klarna at checkout.<br/><br/></p>"
          }
        },
        "question_9gRb9m": {
          "type": "question",
          "settings": {
            "title": "Why are your prices lower than the high street?",
            "answer": "<p>We import our tiles and bathroom products directly from the factories that make them, with no middleman markup — so you get the same designer looks for less.<br/><br/></p>"
          }
        },
        "question_pQxhNR": {
          "type": "question",
          "settings": {
            "title": "Do you offer trade or bulk pricing?",
            "answer": "<p>Yes — we offer trade accounts and pallet/bulk pricing. Apply through our trade enquiry page or get in touch.<br/><br/></p>"
          }
        }
      },
