            "liquid": "<style>\n/* ---------- container ---------- */\n.tp-range-options {\n  margin: 1.5rem 0;\n  padding: 1.3rem;\n  background-color: #fcfbfa;\n  border: 1px solid #e8e8e1;\n  border-radius: 8px;\n}\n.tp-range-colours,\n.tp-range-sizes {\n  margin-bottom: 1.25rem;\n}\n.tp-range-colours:last-child,\n.tp-range-sizes:last-child {\n  margin-bottom: 0;\n}\n.tp-range-options__label {\n  font-family: var(--font-body-family), sans-serif;\n  font-size: 0.95rem;\n  margin-bottom: 0.6rem;\n  color: #3b3337;\n}\n.tp-range-options__label strong {\n  font-weight: 700;\n  margin-right: 6px;\n}\n\n/* ---------- list basics ---------- */\n.tp-range-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n.tp-range-list li {\n  margin: 0;\n  padding: 0;\n}\n\n/* ---------- COLOUR SWATCHES ---------- */\n.tp-range-swatch {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 42px;\n  height: 42px;\n  border-radius: 50%;\n  border: 2px solid transparent;\n  padding: 3px;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  text-decoration: none;\n}\n.tp-range-swatch.is-current {\n  border-color: #3b3337;\n  pointer-events: none;\n}\n.tp-range-swatch:hover:not(.is-current) {\n  border-color: #d1cdcb;\n  transform: scale(1.05);\n}\n.tp-range-swatch.is-soldout {\n  opacity: 0.4;\n  position: relative;\n}\n.tp-range-swatch.is-soldout::after {\n  content: \"\";\n  position: absolute;\n  top: 50%;\n  left: 10%;\n  right: 10%;\n  height: 2px;\n  background: #3b3337;\n  transform: translateY(-50%) rotate(-45deg);\n}\n.tp-range-swatch__image {\n  display: block;\n  width: 100%;\n  height: 100%;\n  border-radius: 50%;\n  overflow: hidden;\n  box-shadow: 0 0 0 1px rgba(0,0,0,0.1) inset;\n}\n.tp-range-swatch__image img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.tp-range-swatch__colour {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n.tp-range-swatch__fallback {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n  background: #eee;\n  color: #666;\n  font-size: 14px;\n  font-weight: bold;\n  text-transform: uppercase;\n}\n\n/* ---------- SIZE BLOCKS ---------- */\n.tp-range-size-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 60px;\n  padding: 8px 14px;\n  background: #fff;\n  border: 1px solid #d1cdcb;\n  border-radius: 6px;\n  color: #3b3337;\n  font-family: var(--font-body-family), sans-serif;\n  font-size: 0.9rem;\n  font-weight: 500;\n  text-decoration: none;\n  transition: all 0.2s ease;\n}\n.tp-range-size-btn:hover:not(.is-current) {\n  border-color: #3b3337;\n  background: #fcfbfa;\n}\n.tp-range-size-btn.is-current {\n  border-color: #3b3337;\n  background: #3b3337;\n  color: #fff;\n  pointer-events: none;\n}\n.tp-range-size-btn.is-soldout {\n  opacity: 0.5;\n  text-decoration: line-through;\n}\n</style>\n\n{%- if product.metafields.custom.range != blank -%}\n  {%- liquid\n    assign siblings = product.metafields.custom.range.value.products.value\n    assign cur_size_raw = product.metafields.custom.size.value | strip\n    assign cur_colour_raw = product.metafields.custom.colour_name.value | strip\n    assign cur_colour = cur_colour_raw | default: \"Default\"\n    \n    assign printed_colours = \"\"\n    assign printed_sizes = \"\"\n    \n    assign total_colours = 0\n    assign total_sizes = 0\n    \n    for sib in siblings\n      assign s_col = sib.metafields.custom.colour_name.value | strip\n      assign s_size = sib.metafields.custom.size.value | strip\n      \n      if s_col != blank\n        assign col_check = \"||\" | append: s_col | append: \"||\"\n        unless printed_colours contains col_check\n          assign total_colours = total_colours | plus: 1\n          assign printed_colours = printed_colours | append: col_check\n        endunless\n      endif\n      \n      if s_size != blank\n        assign size_check = \"||\" | append: s_size | append: \"||\"\n        unless printed_sizes contains size_check\n          assign total_sizes = total_sizes | plus: 1\n          assign printed_sizes = printed_sizes | append: size_check\n        endunless\n      endif\n    endfor\n  -%}\n\n  <div class=\"tp-range-options\">\n\n    {%- comment -%} ===== 1. COLOUR SWATCHES ===== {%- endcomment -%}\n    {%- if total_colours > 0 -%}\n      <div class=\"tp-range-colours\">\n        <div class=\"tp-range-options__label\">\n          <strong>Colour:</strong><span>{{ cur_colour }}</span>\n        </div>\n        <ul class=\"tp-range-list\" role=\"list\">\n          {%- assign output_colours = \"\" -%}\n          {%- for sib in siblings -%}\n            {%- assign s_col = sib.metafields.custom.colour_name.value | strip -%}\n            {%- if s_col != blank -%}\n              {%- assign col_check = \"||\" | append: s_col | append: \"||\" -%}\n              {%- unless output_colours contains col_check -%}\n                {%- assign output_colours = output_colours | append: col_check -%}\n                {%- liquid\n                  assign swatch_hex = sib.metafields.custom.colour_hex.value | strip\n                  if swatch_hex != blank\n                    unless swatch_hex contains '#'\n                      assign swatch_hex = '#' | append: swatch_hex\n                    endunless\n                  endif\n                -%}\n                <li>\n                  <a href=\"{{ sib.url }}\"\n                     class=\"tp-range-swatch{% if s_col == cur_colour_raw %} is-current{% endif %}{% unless sib.available %} is-soldout{% endunless %}\"\n                     title=\"{{ s_col | escape }}{% unless sib.available %} — sold out{% endunless %}\"\n                     aria-label=\"Choose colour {{ s_col | escape }}{% unless sib.available %}, sold out{% endunless %}\"\n                     {% if s_col == cur_colour_raw %}aria-current=\"page\"{% endif %}>\n                    <span class=\"tp-range-swatch__image\">\n                      {%- if swatch_hex != blank -%}\n                        <span class=\"tp-range-swatch__colour\" style=\"background-color: {{ swatch_hex | escape }};\"></span>\n                      {%- elsif sib.featured_image -%}\n                        <img src=\"{{ sib.featured_image | image_url: width: 240 }}\" alt=\"{{ s_col | escape }}\" width=\"34\" height=\"34\" loading=\"lazy\">\n                      {%- else -%}\n                        <span class=\"tp-range-swatch__fallback\">{{ s_col | slice: 0 }}</span>\n                      {%- endif -%}\n                    </span>\n                  </a>\n                </li>\n              {%- endunless -%}\n            {%- endif -%}\n          {%- endfor -%}\n        </ul>\n      </div>\n    {%- endif -%}\n\n    {%- comment -%} ===== 2. SIZES ===== {%- endcomment -%}\n    {%- if total_sizes > 0 -%}\n      <div class=\"tp-range-sizes\">\n        <div class=\"tp-range-options__label\">\n          <strong>Size:</strong>\n        </div>\n        <ul class=\"tp-range-list\" role=\"list\">\n          {%- assign output_sizes = \"\" -%}\n          {%- for sib in siblings -%}\n            {%- assign s_size = sib.metafields.custom.size.value | strip -%}\n            {%- if s_size != blank -%}\n              {%- assign size_check = \"||\" | append: s_size | append: \"||\" -%}\n              {%- unless output_sizes contains size_check -%}\n                {%- assign output_sizes = output_sizes | append: size_check -%}\n                <li>\n                  <a href=\"{{ sib.url }}\"\n                     class=\"tp-range-size-btn{% if s_size == cur_size_raw %} is-current{% endif %}{% unless sib.available %} is-soldout{% endunless %}\"\n                     {% if s_size == cur_size_raw %}aria-current=\"page\"{% endif %}>\n                    {{ s_size | escape }}\n                  </a>\n                </li>\n              {%- endunless -%}\n            {%- endif -%}\n          {%- endfor -%}\n        </ul>\n      </div>\n    {%- endif -%}\n\n  </div>\n{%- endif -%}\n"
