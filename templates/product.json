            "liquid": "<div class=\"cstm_details\">\n<table>\n{% if product.first_available_variant.sku != blank %}\n<tr><td>SKU </td> \n<td>{{product.first_available_variant.sku}}</td> </tr>{%endif %}\n{% if product.metafields.custom.tile_material != blank %}\n<tr><td> Material</td> <td> {{product.metafields.custom.tile_material}}</td></tr>{%endif%}\n{% if product.metafields.custom.tile_color != blank %}\n<tr><td>Colour</td><td> {{product.metafields.custom.tile_color}}</td></tr>{%endif%}\n{% if product.metafields.custom.thickness != blank %}\n<tr><td>Thickness</td><td> {{product.metafields.custom.thickness}}</td></tr>{%endif%}\n{% if product.metafields.custom.slip_rating != blank %}\n<tr><td>Anti-Slip Rating</td><td> {{product.metafields.custom.slip_rating}}</td></tr>{%endif%}\n{% if product.metafields.custom.tile_finish != blank %}\n<tr><td>Finish</td><td> {{product.metafields.custom.tile_finish}}</td></tr>{%endif%}\n{% if product.metafields.custom.floor_or_wall != blank %}\n<tr><td>Floor or Wall</td><td> {{product.metafields.custom.floor_or_wall}}</td></tr>{%endif%}\n{% if product.metafields.custom.size != blank %}\n<tr><td>Size</td><td> {{product.metafields.custom.size}}</td></tr>{%endif%}\n</table>\n<table>\n\n{% if product.metafields.custom.rectified != blank %}\n<tr><td> Rectified</td> <td> {{product.metafields.custom.rectified}}</td></tr>{%endif%}\n{% if product.metafields.custom.suitable_for_underfloor_heating != blank %}\n<tr><td>Suitable for Underfloor Heating </td><td> {{ product.metafields.custom.suitable_for_underfloor_heating}}</td></tr>{%endif%}\n{% if product.metafields.custom.box_quantity != blank %}\n<tr><td>Box Quantity</td><td> {{product.metafields.custom.box_quantity}}</td></tr>{%endif%}\n{% if product.metafields.custom.weight != blank %}\n<tr><td>Weight</td><td> {{product.metafields.custom.weight}}</td></tr>{%endif%}\n{% if product.metafields.custom.pattern_repeats != blank %}\n<tr><td>Pattern Repeats</td><td> {{product.metafields.custom.pattern_repeats}}</td></tr>{%endif%}\n{% if product.metafields.custom.sale_by != blank %}\n<tr><td>Sale By</td><td> {{product.metafields.custom.sale_by}}</td></tr>{%endif%}\n</table>\n</div>",
