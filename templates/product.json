        "liquid_QbWTND": {
          "type": "liquid",
          "settings": {
            "title": "Reviews",
            "liquid": "<div id=\"bundle-product_reviews\"></div> <script>\ndocument.addEventListener('DOMContentLoaded', function () {\n  const anchor = document.getElementById('bundle-product_reviews');\n  if (!anchor) return;\n\n  const card = anchor.closest('.card');\n  if (!card) return;\n\n  // Force visible initially (theme hides it)\n  card.style.setProperty('display', 'block', 'important'); \n\n  const MAX_WAIT_MS = 3000;\n  const START = Date.now();\n\n  function getWidget() {\n    return anchor.parentElement.querySelector('.vtl-pr-main-widget');\n  }\n\n  function hasRealReviews() {\n    const widget = getWidget();\n    if (!widget) return false;\n\n    return !!widget.querySelector(\n      '.vtl-pr-review, [data-review-id], .vtl-star, img, svg'\n    );\n  }\n\n  function decide(final = false) {\n    const widget = getWidget();\n\n    if (hasRealReviews()) {\n      card.style.setProperty('display', 'block', 'important');\n      observer.disconnect();\n      return;\n    }\n\n    if (final) {\n      card.style.display = 'none';\n      observer.disconnect();\n    }\n  }\n\n  const observer = new MutationObserver(() => {\n    decide(false);\n    if (Date.now() - START > MAX_WAIT_MS) decide(true);\n  });\n\n  observer.observe(anchor.parentElement, {\n    childList: true,\n    subtree: true\n  });\n\n  setTimeout(() => decide(true), MAX_WAIT_MS);\n});\n</script>",
            "display_mode": "collapse"
          }
        },
