            "liquid": "{%- assign range = product.metafields.custom.range.value -%}\n{%- if range != blank -%}\n  {%- assign siblings = range.products.value -%}\n  {%- if siblings.size > 1 -%}\n    {%- assign current_colour = product.metafields.custom.colour_name.value | default: product.title -%}\n    <div class=\"tp-range-swatches\">\n      <div class=\"tp-range-swatches__heading\">\n        <strong>Colour:</strong>\n        <span>{{ current_colour }}</span>\n      </div>\n      <ul class=\"tp-range-swatches__list\" role=\"list\">\n        {%- for sib in siblings -%}\n          {%- assign swatch_name = sib.metafields.custom.colour_name.value | default: sib.title -%}\n          <li class=\"tp-range-swatches__item\">\n            <a href=\"{{ sib.url }}\" class=\"tp-range-swatch{% if sib.id == product.id %} is-current{% endif %}\" title=\"{{ swatch_name | escape }}\" aria-label=\"Choose colour {{ swatch_name | escape }}\" {% if sib.id == product.id %}aria-current=\"page\"{% endif %}>\n              <span class=\"tp-range-swatch__image\">\n                {%- if sib.featured_image -%}\n                  <img src=\"{{ sib.featured_image | image_url: width: 140 }}\" alt=\"{{ swatch_name | escape }}\" width=\"60\" height=\"60\" loading=\"lazy\">\n                {%- else -%}\n                  <span class=\"tp-range-swatch__fallback\">{{ swatch_name | slice: 0 }}</span>\n                {%- endif -%}\n              </span>\n            </a>\n          </li>\n        {%- endfor -%}\n      </ul>\n    </div>\n  {%- endif -%}\n{%- endif -%}"
