        "calculator_block": {
          "type": "liquid",
          "settings": {
            "title": "",
            "liquid": "{%- comment -%}\n  Liquid block (no title needed; set Display mode \"Show all\").\n  Banner linking to your standalone /pages/tile-calculator.\n{%- endcomment -%}\n<a class=\"tp-calcb\" href=\"/pages/tile-calculator\">\n  <div class=\"tp-calcb__txt\">\n    <h3>Doing a whole room?</h3>\n    <p>Use our free Tile Calculator \u2014 enter your wall and floor measurements, deduct doors and windows, and we'll work out exactly how many boxes you need, plus 10% for wastage.</p>\n  </div>\n  <span class=\"tp-calcb__btn\">Open the Tile Calculator &rarr;</span>\n</a>\n<style>\n  .tp-calcb, .tp-calcb * { text-decoration: none !important; background-image: none !important; border: none !important; box-shadow: none !important; outline: none !important; }\n  .tp-calcb{display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;\n    background:linear-gradient(120deg,#1a1d24,#2a3340);color:#fff;border-radius:14px;padding:24px 26px;\n    text-decoration:none;font-family:\"Open Sans\",sans-serif;}\n  .tp-calcb__txt h3{font-size:18px;font-weight:800;margin:0;}\n  .tp-calcb__txt p{font-size:13px;opacity:.85;margin:5px 0 0;max-width:560px;line-height:1.5;}\n  .tp-calcb__btn{background:#fff;color:#1a1d24;font-weight:800;font-size:14px;padding:13px 22px;border-radius:10px;white-space:nowrap;}\n  .tp-calcb:hover .tp-calcb__btn{background:#c8102e;color:#fff;}\n</style>",
            "display_mode": "show_all"
          }
        }
