    "custom_liquid_xki7ez": {
      "type": "custom-liquid",
      "name": "Complete the look",
      "settings": {
        "title": "",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  CAROUSEL 2 of 2 - \"NOT QUITE THE RIGHT LOOK\"\n  Paste this whole thing into its OWN Liquid block (Customize > product page >\n  Add block > Liquid > Display mode \"Show all\").\n  ONLY THING TO CHECK: this is preset to your tile-sale collection - no change needed\n  (the bit after /collections/ in its URL). If it shows nothing, the handle is wrong.\n{%- endcomment -%}\n\n{%- assign coll_handle = 'tile-sale' -%}\n{%- assign heading     = 'Not quite the right look? Browse similar tiles' -%}\n{%- assign uid         = 'browsesim' -%}\n{%- assign button_text = 'View product' -%}\n{%- assign products_limit = 12 -%}\n\n{%- assign coll = collections[coll_handle] -%}\n{%- if coll != blank and coll.products.size > 0 -%}\n<style>\n  .tpc-{{ uid }}{display:block;width:100%;font-family:\"Open Sans\",system-ui,sans-serif;padding:8px 0;}\n  .tpc-{{ uid }} .tpc__head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}\n  .tpc-{{ uid }} .tpc__title{font-size:22px;font-weight:800;letter-spacing:-.01em;color:#1a1d24;margin:0;}\n  .tpc-{{ uid }} .tpc__nav{display:flex;gap:10px;}\n  .tpc-{{ uid }} .tpc__btn{width:40px;height:40px;border-radius:50%;background:#f7f8f9;color:#1a1d24;border:1px solid #e6e8eb;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background-color .2s;}\n  .tpc-{{ uid }} .tpc__btn:hover{background:#ececef;}\n  .tpc-{{ uid }} .tpc__btn:disabled{opacity:.3;cursor:not-allowed;}\n  .tpc-{{ uid }} .tpc__track{display:flex;gap:16px;overflow-x:auto;scroll-behavior:smooth;scrollbar-width:none;-ms-overflow-style:none;}\n  .tpc-{{ uid }} .tpc__track::-webkit-scrollbar{display:none;}\n  .tpc-{{ uid }} .tpc__item{flex:0 0 calc((100% - 48px) / 4);min-width:0;}\n  .tpc-{{ uid }} .tpc__card{background:#fff;border:1px solid #e6e8eb;border-radius:12px;overflow:hidden;height:100%;display:flex;flex-direction:column;}\n  .tpc-{{ uid }} .tpc__img{position:relative;width:100%;padding-bottom:100%;background:#f7f8f9;overflow:hidden;display:block;}\n  .tpc-{{ uid }} .tpc__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}\n  .tpc-{{ uid }} .tpc__body{padding:14px;flex-grow:1;display:flex;flex-direction:column;}\n  .tpc-{{ uid }} .tpc__name{font-size:13px;font-weight:700;line-height:1.35;color:#1a1d24;margin:0 0 8px;text-decoration:none;display:block;min-height:38px;}\n  .tpc-{{ uid }} .tpc__name:hover{color:#1f8a4c;}\n  .tpc-{{ uid }} .tpc__price{font-size:14px;font-weight:800;color:#1a1d24;margin-bottom:12px;}\n  .tpc-{{ uid }} .tpc__price.is-sale{color:#c8102e;}\n  .tpc-{{ uid }} .tpc__price small{color:#6b7280;font-weight:600;font-size:11px;}\n  .tpc-{{ uid }} .tpc__rrp{text-decoration:line-through;opacity:.55;margin-left:8px;font-weight:500;font-size:13px;color:#6b7280;}\n  .tpc-{{ uid }} .tpc__cta{margin-top:auto;background:#c8102e;color:#fff;border:none;padding:12px 18px;border-radius:10px;font-weight:700;text-align:center;text-decoration:none;display:block;transition:background-color .2s;}\n  .tpc-{{ uid }} .tpc__cta:hover{background:#a50d26;}\n  @media(max-width:749px){\n    .tpc-{{ uid }} .tpc__item{flex:0 0 calc((100% - 16px) / 2);}\n    .tpc-{{ uid }} .tpc__title{font-size:18px;}\n    .tpc-{{ uid }} .tpc__nav{display:none;}\n  }\n</style>\n\n<tp-carousel-{{ uid }} class=\"tpc-{{ uid }}\">\n  <div class=\"tpc__head\">\n    <h2 class=\"tpc__title\">{{ heading }}</h2>\n    <div class=\"tpc__nav\">\n      <button class=\"tpc__btn tpc__prev\" aria-label=\"Previous\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"15 18 9 12 15 6\"></polyline></svg></button>\n      <button class=\"tpc__btn tpc__next\" aria-label=\"Next\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg></button>\n    </div>\n  </div>\n  <div class=\"tpc__track\">\n    {%- for p in coll.products limit: products_limit -%}\n      <div class=\"tpc__item\">\n        <div class=\"tpc__card\">\n          <a href=\"{{ p.url }}\" class=\"tpc__img\">\n            {% if p.featured_image %}<img src=\"{{ p.featured_image | image_url: width: 600 }}\" alt=\"{{ p.featured_image.alt | escape }}\" loading=\"lazy\" width=\"600\" height=\"600\">{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}\n          </a>\n          <div class=\"tpc__body\">\n            <a href=\"{{ p.url }}\" class=\"tpc__name\">{{ p.title }}</a>\n            <div class=\"tpc__price {% if p.compare_at_price > p.price %}is-sale{% endif %}\">\n              {{ p.price | money }}{% if p.metafields.custom.sale_by != blank %} <small>{{ p.metafields.custom.sale_by }}</small>{% endif %}\n              {% if p.compare_at_price > p.price %}<span class=\"tpc__rrp\">{{ p.compare_at_price | money }}</span>{% endif %}\n            </div>\n            <a href=\"{{ p.url }}\" class=\"tpc__cta\">{{ button_text }}</a>\n          </div>\n        </div>\n      </div>\n    {%- endfor -%}\n  </div>\n</tp-carousel-{{ uid }}>\n\n<script>\n  (function(){\n    class TpCarousel{{ uid }} extends HTMLElement {\n      connectedCallback(){\n        this.track = this.querySelector('.tpc__track');\n        this.prev  = this.querySelector('.tpc__prev');\n        this.next  = this.querySelector('.tpc__next');\n        if(!this.track || !this.prev || !this.next) return;\n        this.prev.addEventListener('click', () => this.scroll(-1));\n        this.next.addEventListener('click', () => this.scroll(1));\n        this.track.addEventListener('scroll', () => this.update());\n        this.update();\n      }\n      scroll(dir){ this.track.scrollLeft += dir * this.track.offsetWidth; }\n      update(){\n        this.prev.disabled = this.track.scrollLeft <= 0;\n        this.next.disabled = this.track.scrollLeft + this.track.offsetWidth >= this.track.scrollWidth - 1;\n      }\n    }\n    if(!customElements.get('tp-carousel-{{ uid }}')){\n      customElements.define('tp-carousel-{{ uid }}', TpCarousel{{ uid }});\n    }\n  })();\n</script>\n{%- endif -%}"
      }
    },
    "custom_liquid_CxGYaH": {
      "type": "custom-liquid",
      "name": "Product Details",
      "settings": {
        "title": "Product Details",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  HOW TO USE: Customize > product page > Add block > \"Liquid\".\n  Title the block \"Product Details\", Display mode \"Show all\", paste this in.\n  Rows auto-hide when a metafield is empty, so it stays tidy across products.\n\n  KEY CHECK: these use the namespace \"custom\" with the keys below. If any row is\n  missing on the live page, the key differs - check Settings > Custom data >\n  Metafields, and just change the key in the matching line here.\n{%- endcomment -%}\n\n{%- liquid\n  assign c = product.metafields.custom\n  assign sku = product.selected_or_first_available_variant.sku\n-%}\n\n<div class=\"tp-spec\">\n  {%- if sku != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">SKU</span><span class=\"v\">{{ sku }}</span></div>{%- endif -%}\n  {%- if c.material != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Material</span><span class=\"v\">{{ c.material }}</span></div>{%- endif -%}\n  {%- if c.colour != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Colour</span><span class=\"v\">{{ c.colour }}</span></div>{%- endif -%}\n  {%- if c.thickness != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Thickness</span><span class=\"v\">{{ c.thickness }}</span></div>{%- endif -%}\n  {%- if c.tile_finish != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Finish</span><span class=\"v\">{{ c.tile_finish }}</span></div>{%- endif -%}\n  {%- if c.floor_or_wall != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Floor or Wall</span><span class=\"v\">{{ c.floor_or_wall }}</span></div>{%- endif -%}\n  {%- if c.size != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Size</span><span class=\"v\">{{ c.size }}</span></div>{%- endif -%}\n  {%- if c.rectified != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Rectified</span><span class=\"v\">{% if c.rectified == true %}Yes{% elsif c.rectified == false %}No{% else %}{{ c.rectified }}{% endif %}</span></div>{%- endif -%}\n  {%- if c.suitable_for_underfloor_heating != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Suitable for Underfloor Heating</span><span class=\"v\">{% if c.suitable_for_underfloor_heating == true %}Yes{% elsif c.suitable_for_underfloor_heating == false %}No{% else %}{{ c.suitable_for_underfloor_heating }}{% endif %}</span></div>{%- endif -%}\n  {%- if c.box_quantity != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Box Quantity</span><span class=\"v\">{{ c.box_quantity }}</span></div>{%- endif -%}\n  {%- if c.weight != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Weight</span><span class=\"v\">{{ c.weight }}</span></div>{%- endif -%}\n  {%- if c.sale_by != blank -%}<div class=\"tp-spec__row\"><span class=\"k\">Sale By</span><span class=\"v\">{{ c.sale_by }}</span></div>{%- endif -%}\n</div>\n\n<style>\n  .tp-spec{display:grid;grid-template-columns:1fr 1fr;border:1px solid #e6e8eb;border-radius:8px;overflow:hidden;font-family:\"Open Sans\",sans-serif;}\n  .tp-spec__row{display:flex;justify-content:space-between;gap:14px;padding:13px 18px;font-size:14px;border-bottom:1px solid #eef0f2;}\n  .tp-spec__row:nth-child(4n+1),.tp-spec__row:nth-child(4n+2){background:#f7f8f9;}\n  .tp-spec .k{font-weight:700;color:#1a1d24;}\n  .tp-spec .v{color:#4a4f57;text-align:right;}\n  @media(max-width:600px){.tp-spec{grid-template-columns:1fr;}.tp-spec__row:nth-child(n){background:#fff;}.tp-spec__row:nth-child(odd){background:#f7f8f9;}}\n</style>"
      }
    },
    "custom_liquid_t77pJf": {
      "type": "custom-liquid",
      "name": "Paired With",
      "settings": {
        "title": "",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  \"CUSTOMERS PAIRED WITH\" — multi-collection carousel.\n  Paste this into the SAME Custom Liquid section where carousel 1 currently is\n  (replace all of its code). It pulls a few products from each collection listed\n  below and shows them as one carousel.\n\n  To change which collections / how many from each, edit the two lines marked CHANGE.\n{%- endcomment -%}\n\n{%- assign handles = 'led-mirrors,stylish-radiators-heated-towel-rails,luxury-shower-sets,toilets' | split: ',' -%}  {%- comment -%} CHANGE collections {%- endcomment -%}\n{%- assign per_collection = 3 -%}                  {%- comment -%} CHANGE how many from each {%- endcomment -%}\n{%- assign heading = 'Customers Paired With' -%}\n{%- assign button_text = 'View product' -%}\n{%- assign uid = 'paired' -%}\n\n{%- capture cards -%}\n  {%- for h in handles -%}\n    {%- assign coll = collections[h] -%}\n    {%- if coll != blank -%}\n      {%- for p in coll.products limit: per_collection -%}\n        <div class=\"tpc__item\">\n          <div class=\"tpc__card\">\n            <a href=\"{{ p.url }}\" class=\"tpc__img\">\n              {% if p.featured_image %}<img src=\"{{ p.featured_image | image_url: width: 600 }}\" alt=\"{{ p.featured_image.alt | escape }}\" loading=\"lazy\" width=\"600\" height=\"600\">{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}\n            </a>\n            <div class=\"tpc__body\">\n              <a href=\"{{ p.url }}\" class=\"tpc__name\">{{ p.title }}</a>\n              <div class=\"tpc__price {% if p.compare_at_price > p.price %}is-sale{% endif %}\">\n                {{ p.price | money }}{% if p.metafields.custom.sale_by != blank %} <small>{{ p.metafields.custom.sale_by }}</small>{% endif %}\n                {% if p.compare_at_price > p.price %}<span class=\"tpc__rrp\">{{ p.compare_at_price | money }}</span>{% endif %}\n              </div>\n              <a href=\"{{ p.url }}\" class=\"tpc__cta\">{{ button_text }}</a>\n            </div>\n          </div>\n        </div>\n      {%- endfor -%}\n    {%- endif -%}\n  {%- endfor -%}\n{%- endcapture -%}\n\n{%- assign cards_check = cards | strip -%}\n{%- if cards_check != blank -%}\n<style>\n  .tpc-{{ uid }}{display:block;width:100%;font-family:\"Open Sans\",system-ui,sans-serif;padding:24px 0;}\n  .tpc-{{ uid }} .tpc__head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}\n  .tpc-{{ uid }} .tpc__title{font-size:22px;font-weight:800;letter-spacing:-.01em;color:#1a1d24;margin:0;}\n  .tpc-{{ uid }} .tpc__nav{display:flex;gap:10px;}\n  .tpc-{{ uid }} .tpc__btn{width:40px;height:40px;border-radius:50%;background:#f7f8f9;color:#1a1d24;border:1px solid #e6e8eb;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background-color .2s;}\n  .tpc-{{ uid }} .tpc__btn:hover{background:#ececef;}\n  .tpc-{{ uid }} .tpc__btn:disabled{opacity:.3;cursor:not-allowed;}\n  .tpc-{{ uid }} .tpc__track{display:flex;gap:16px;overflow-x:auto;scroll-behavior:smooth;scrollbar-width:none;-ms-overflow-style:none;}\n  .tpc-{{ uid }} .tpc__track::-webkit-scrollbar{display:none;}\n  .tpc-{{ uid }} .tpc__item{flex:0 0 calc((100% - 48px) / 4);min-width:0;}\n  .tpc-{{ uid }} .tpc__card{background:#fff;border:1px solid #e6e8eb;border-radius:12px;overflow:hidden;height:100%;display:flex;flex-direction:column;}\n  .tpc-{{ uid }} .tpc__img{position:relative;width:100%;padding-bottom:100%;background:#f7f8f9;overflow:hidden;display:block;}\n  .tpc-{{ uid }} .tpc__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}\n  .tpc-{{ uid }} .tpc__body{padding:14px;flex-grow:1;display:flex;flex-direction:column;}\n  .tpc-{{ uid }} .tpc__name{font-size:13px;font-weight:700;line-height:1.35;color:#1a1d24;margin:0 0 8px;text-decoration:none;display:block;min-height:38px;}\n  .tpc-{{ uid }} .tpc__name:hover{color:#1f8a4c;}\n  .tpc-{{ uid }} .tpc__price{font-size:14px;font-weight:800;color:#1a1d24;margin-bottom:12px;}\n  .tpc-{{ uid }} .tpc__price.is-sale{color:#c8102e;}\n  .tpc-{{ uid }} .tpc__price small{color:#6b7280;font-weight:600;font-size:11px;}\n  .tpc-{{ uid }} .tpc__rrp{text-decoration:line-through;opacity:.55;margin-left:8px;font-weight:500;font-size:13px;color:#6b7280;}\n  .tpc-{{ uid }} .tpc__cta{margin-top:auto;background:#c8102e;color:#fff;border:none;padding:12px 18px;border-radius:10px;font-weight:700;text-align:center;text-decoration:none;display:block;transition:background-color .2s;}\n  .tpc-{{ uid }} .tpc__cta:hover{background:#a50d26;}\n  @media(max-width:749px){\n    .tpc-{{ uid }}{padding:18px 0;}\n    .tpc-{{ uid }} .tpc__item{flex:0 0 calc((100% - 16px) / 2);}\n    .tpc-{{ uid }} .tpc__title{font-size:18px;}\n    .tpc-{{ uid }} .tpc__nav{display:none;}\n  }\n</style>\n\n<tp-carousel-{{ uid }} class=\"tpc-{{ uid }}\">\n  <div class=\"tpc__head\">\n    <h2 class=\"tpc__title\">{{ heading }}</h2>\n    <div class=\"tpc__nav\">\n      <button class=\"tpc__btn tpc__prev\" aria-label=\"Previous\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"15 18 9 12 15 6\"></polyline></svg></button>\n      <button class=\"tpc__btn tpc__next\" aria-label=\"Next\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg></button>\n    </div>\n  </div>\n  <div class=\"tpc__track\">{{ cards }}</div>\n</tp-carousel-{{ uid }}>\n\n<script>\n  (function(){\n    class TpCarousel{{ uid }} extends HTMLElement {\n      connectedCallback(){\n        this.track = this.querySelector('.tpc__track');\n        this.prev  = this.querySelector('.tpc__prev');\n        this.next  = this.querySelector('.tpc__next');\n        if(!this.track || !this.prev || !this.next) return;\n        this.prev.addEventListener('click', () => this.scroll(-1));\n        this.next.addEventListener('click', () => this.scroll(1));\n        this.track.addEventListener('scroll', () => this.update());\n        this.update();\n      }\n      scroll(dir){ this.track.scrollLeft += dir * this.track.offsetWidth; }\n      update(){\n        this.prev.disabled = this.track.scrollLeft <= 0;\n        this.next.disabled = this.track.scrollLeft + this.track.offsetWidth >= this.track.scrollWidth - 1;\n      }\n    }\n    if(!customElements.get('tp-carousel-{{ uid }}')){\n      customElements.define('tp-carousel-{{ uid }}', TpCarousel{{ uid }});\n    }\n  })();\n</script>\n{%- endif -%}"
      }
    },
    "custom_liquid_ekefkB": {
      "type": "custom-liquid",
      "name": "TILE FAQ",
      "settings": {
        "title": "Tile FAQs",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  HOW TO USE: Customize > product page > Add block > \"Liquid\".\n  Set the block Title to \"Tile FAQs\" and Display mode to \"Show all\".\n  Paste everything below. The JSON-LD makes you eligible for FAQ rich results\n  and feeds Google's AI overviews. Keep answers factual and generic.\n{%- endcomment -%}\n\n<div class=\"tp-faq\">\n  <details class=\"tp-faq__i\" open>\n    <summary>How many tiles do I need?</summary>\n    <div class=\"tp-faq__a\">Measure the width and height of each area to get the m&sup2;, add the areas together, then add 10% for cuts and wastage. The calculator at the top of this page does it for you and converts the area into the number of tiles.</div>\n  </details>\n  <details class=\"tp-faq__i\">\n    <summary>Can these tiles be used on the floor as well as the wall?</summary>\n    <div class=\"tp-faq__a\">Check the Suitability line in Product Details. Tiles marked \"Wall &amp; Floor\" are rated for both. For wet-room shower floors we recommend a textured or higher slip-rated finish.</div>\n  </details>\n  <details class=\"tp-faq__i\">\n    <summary>Do the samples cost anything?</summary>\n    <div class=\"tp-faq__a\">Samples are charged at a small amount which is then credited against your full order, so trying before you buy effectively costs nothing once you place your order.</div>\n  </details>\n  <details class=\"tp-faq__i\">\n    <summary>How quickly will my order arrive?</summary>\n    <div class=\"tp-faq__a\">In-stock tiles are dispatched for next-day UK delivery when ordered before the daily cut-off. Standard delivery is free on orders over &pound;499.</div>\n  </details>\n  <details class=\"tp-faq__i\">\n    <summary>Why should I order extra tiles?</summary>\n    <div class=\"tp-faq__a\">Tiles are produced in batches and shades can vary slightly between them. Ordering your full quantity plus 10% in one go means cuts, breakages and future repairs all come from the same batch.</div>\n  </details>\n</div>\n\n<style>\n  .tp-faq{border:1px solid #e6e8eb;border-radius:10px;overflow:hidden;max-width:820px;font-family:\"Open Sans\",sans-serif;}\n  .tp-faq__i{border-bottom:1px solid #e6e8eb;}\n  .tp-faq__i:last-child{border-bottom:0;}\n  .tp-faq__i summary{padding:15px 18px;font-weight:700;font-size:14px;cursor:pointer;display:flex;justify-content:space-between;list-style:none;color:#1a1d24;}\n  .tp-faq__i summary::-webkit-details-marker{display:none;}\n  .tp-faq__i summary::after{content:\"+\";color:#c8102e;font-weight:800;font-size:18px;margin-left:12px;}\n  .tp-faq__i[open] summary::after{content:\"\\2013\";}\n  .tp-faq__a{padding:0 18px 16px;font-size:13px;color:#3a3f48;line-height:1.6;}\n</style>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    { \"@type\": \"Question\", \"name\": \"How many tiles do I need?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Measure the width and height of each area to get the m2, add the areas together, then add 10% for cuts and wastage. The calculator on the product page works this out and converts the area into the number of tiles.\" } },\n    { \"@type\": \"Question\", \"name\": \"Can these tiles be used on the floor as well as the wall?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Tiles marked Wall and Floor in the Product Details are rated for both. For wet-room shower floors we recommend a textured or higher slip-rated finish.\" } },\n    { \"@type\": \"Question\", \"name\": \"Do the samples cost anything?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Samples are charged at a small amount which is then credited against your full order, so trying before you buy effectively costs nothing once you order.\" } },\n    { \"@type\": \"Question\", \"name\": \"How quickly will my order arrive?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"In-stock tiles are dispatched for next-day UK delivery when ordered before the daily cut-off. Standard delivery is free on orders over 499 pounds.\" } },\n    { \"@type\": \"Question\", \"name\": \"Why should I order extra tiles?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Tiles are produced in batches and shades can vary slightly between them. Ordering your full quantity plus 10% in one go means cuts, breakages and future repairs all come from the same batch.\" } }\n  ]\n}\n</script>"
      }
    },
    "custom_liquid_hYpwa8": {
      "type": "custom-liquid",
      "name": "Product Description",
      "settings": {
        "title": "Product Description",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  Liquid block titled \"Description\". Pulls product.description into its own block\n  with a \"Read more\" toggle. The toggle only appears when the text is long enough\n  to need clamping, so short descriptions show in full with no button.\n  (If you use this, delete the theme's native Description block to avoid duplication.)\n{%- endcomment -%}\n{%- if product.description != blank -%}\n  <div class=\"tp-desc-wrap\">\n    <div class=\"tp-desc rte\">\n      {{ product.description | remove: 'data-section-type=\"product\"' }}\n    </div>\n    <button type=\"button\" class=\"tp-desc-toggle\" style=\"display:none\">Read more</button>\n  </div>\n\n  <style>\n    .tp-desc-wrap{max-width:820px;font-family:\"Open Sans\",sans-serif;}\n    .tp-desc{font-size:15px;line-height:1.7;color:#3a3f48;position:relative;overflow:hidden;}\n    .tp-desc.is-clamped{max-height:230px;}\n    .tp-desc.is-clamped::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:80px;\n      background:linear-gradient(to bottom,rgba(255,255,255,0),#fff);pointer-events:none;}\n    .tp-desc h2,.tp-desc h3{color:#1a1d24;font-weight:800;margin:16px 0 6px;line-height:1.3;}\n    .tp-desc p{margin:0 0 11px;}\n    .tp-desc ul,.tp-desc ol{margin:8px 0 14px 20px;}\n    .tp-desc li{margin-bottom:5px;}\n    .tp-desc table{width:100%;border-collapse:collapse;margin:10px 0;}\n    .tp-desc td,.tp-desc th{border:1px solid #e6e8eb;padding:8px 12px;text-align:left;}\n    .tp-desc-toggle{margin-top:12px;background:none;border:0;color:#c8102e;font-weight:700;\n      cursor:pointer;font-size:14px;font-family:\"Open Sans\",sans-serif;padding:0;}\n    .tp-desc-toggle:hover{text-decoration:underline;}\n  </style>\n\n  <script>\n    (function(){\n      document.querySelectorAll('.tp-desc-wrap').forEach(function(wrap){\n        var desc = wrap.querySelector('.tp-desc');\n        var btn  = wrap.querySelector('.tp-desc-toggle');\n        if(!desc || !btn) return;\n        var CLAMP = 230;\n        if(desc.scrollHeight > CLAMP + 60){\n          desc.classList.add('is-clamped');\n          btn.style.display = 'inline-block';\n          btn.addEventListener('click', function(){\n            var clamped = desc.classList.toggle('is-clamped');\n            btn.textContent = clamped ? 'Read more' : 'Read less';\n          });\n        }\n      });\n    })();\n  </script>\n{%- endif -%}"
      }
    },
    "custom_liquid_6YVggk": {
      "type": "custom-liquid",
      "name": "CALCULATOR",
      "settings": {
        "title": "",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  Liquid block (no title needed; set Display mode \"Show all\").\n  Banner linking to your standalone /pages/tile-calculator.\n{%- endcomment -%}\n<a class=\"tp-calcb\" href=\"/pages/tile-calculator\">\n  <div class=\"tp-calcb__txt\">\n    <h3>Doing a whole room?</h3>\n    <p>Use our free Tile Calculator — enter your wall and floor measurements, deduct doors and windows, and we'll work out exactly how many boxes you need, plus 10% for wastage.</p>\n  </div>\n  <span class=\"tp-calcb__btn\">Open the Tile Calculator &rarr;</span>\n</a>\n<style>\n  .tp-calcb{display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;\n    background:linear-gradient(120deg,#1a1d24,#2a3340);color:#fff;border-radius:14px;padding:24px 26px;\n    text-decoration:none;font-family:\"Open Sans\",sans-serif;}\n  .tp-calcb__txt h3{font-size:18px;font-weight:800;margin:0;}\n  .tp-calcb__txt p{font-size:13px;opacity:.85;margin:5px 0 0;max-width:560px;line-height:1.5;}\n  .tp-calcb__btn{background:#fff;color:#1a1d24;font-weight:800;font-size:14px;padding:13px 22px;border-radius:10px;white-space:nowrap;}\n  .tp-calcb:hover .tp-calcb__btn{background:#c8102e;color:#fff;}\n</style>"
      }
    },
    "custom_liquid_WhPNfa": {
      "type": "custom-liquid",
      "name": "Tile USP",
      "settings": {
        "title": "",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  Liquid block (Display mode \"Show all\"), or paste into a Custom Liquid section\n  near the top of the page / under the header. Trust + USP bar.\n{%- endcomment -%}\n<div class=\"tp-usp\">\n  <span class=\"tp-usp__i\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 6h11v9H3z\"/><path d=\"M14 9h4l3 3v3h-7z\"/><circle cx=\"7\" cy=\"18\" r=\"1.6\"/><circle cx=\"17.5\" cy=\"18\" r=\"1.6\"/></svg>\n    Next-day UK delivery\n  </span>\n  <span class=\"tp-usp__i\">\n    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l2.9 6.2 6.8.8-5 4.6 1.3 6.7L12 17.8 5.7 21l1.3-6.7-5-4.6 6.8-.8z\"/></svg>\n    Rated Excellent on Trustpilot\n  </span>\n  <span class=\"tp-usp__i\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 10h18\"/></svg>\n    0% finance available\n  </span>\n  <span class=\"tp-usp__i\">\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4h16v12H4z\"/><path d=\"M9 20h6\"/></svg>\n    Free samples &middot; 14-day returns\n  </span>\n</div>\n<style>\n  .tp-usp{display:flex;flex-wrap:wrap;gap:14px 28px;align-items:center;justify-content:center;\n    background:#1a1d24;color:#fff;padding:11px 18px;border-radius:10px;\n    font-family:\"Open Sans\",sans-serif;font-size:13px;font-weight:600;}\n  .tp-usp__i{display:flex;align-items:center;gap:8px;opacity:.94;}\n  .tp-usp__i svg{width:16px;height:16px;color:#7fd3a0;flex:0 0 auto;}\n</style>"
      }
    },
