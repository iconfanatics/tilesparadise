rn_repeats}}</td></tr>{%endif%}\n{% if product.metafields.custom.sale_by != blank %}\n<tr><td>Sale By</td><td> {{product.metafields.custom.sale_by}}</td></tr>{%endif%}\n</table>\n</div>",
