    "custom_liquid_xki7ez": {
      "type": "custom-liquid",
      "name": "Complete the look",
      "settings": {
        "title": "",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  =====================================================================\n  MIRROR — \"Browse more mirrors\" carousel  (paste into a Liquid block)\n  Pulls from one collection. CSS scroll carousel (no JS needed).\n  Current product is auto-excluded. Edit the handle + heading below.\n  =====================================================================\n{%- endcomment -%}\n\n{%- assign source_handle = 'led-mirrors' -%}\n{%- assign heading = 'Browse more mirrors' -%}\n\n{%- assign coll = collections[source_handle] -%}\n{%- assign current_handle = product.handle -%}\n\n{%- if coll != blank and coll.products_count > 0 -%}\n<style>\n  .mcaro{font-family:\"Roboto\",sans-serif;max-width:1100px;margin:0 auto}\n  .mcaro__h{font-family:\"Fraunces\",serif;font-weight:700;font-size:30px;color:#016FD0;margin:0 0 18px}\n  .mcaro__track{display:flex;gap:16px;overflow-x:auto;padding:4px 4px 14px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}\n  .mcaro__track::-webkit-scrollbar{height:6px}\n  .mcaro__track::-webkit-scrollbar-thumb{background:#cfd6dd;border-radius:6px}\n  .mcaro__card{flex:0 0 220px;scroll-snap-align:start;border:2px solid #e6e8eb;border-radius:12px;overflow:hidden;background:#fff;text-decoration:none;color:#1a1d24;transition:border-color .15s}\n  .mcaro__card:hover{border-color:#016FD0}\n  .mcaro__img{position:relative;padding-bottom:100%;background:#f3f5f6}\n  .mcaro__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n  .mcaro__save{position:absolute;top:10px;left:10px;background:#c8102e;color:#fff;font-size:11px;font-weight:700;border-radius:6px;padding:3px 8px}\n  .mcaro__body{padding:12px 14px}\n  .mcaro__title{font-size:13.5px;font-weight:600;line-height:1.35;min-height:38px;margin-bottom:8px}\n  .mcaro__price{font-size:16px;font-weight:800}\n  .mcaro__price s{font-size:12.5px;color:#6b7280;font-weight:500;margin-left:6px}\n  @media(max-width:640px){.mcaro__h{font-size:24px}.mcaro__card{flex-basis:165px}}\n</style>\n\n<section class=\"mcaro\">\n  <h2 class=\"mcaro__h\">{{ heading }}</h2>\n  <div class=\"mcaro__track\">\n    {%- for p in coll.products limit: 12 -%}\n      {%- unless p.handle == current_handle -%}\n        <a class=\"mcaro__card\" href=\"{{ p.url }}\">\n          <div class=\"mcaro__img\">\n            {%- if p.compare_at_price > p.price -%}\n              {%- assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}\n              <span class=\"mcaro__save\">Save {{ pct }}%</span>\n            {%- endif -%}\n            {%- if p.featured_image -%}\n              <img src=\"{{ p.featured_image | image_url: width: 440 }}\" alt=\"{{ p.featured_image.alt | escape | default: p.title }}\" loading=\"lazy\">\n            {%- endif -%}\n          </div>\n          <div class=\"mcaro__body\">\n            <div class=\"mcaro__title\">{{ p.title }}</div>\n            <div class=\"mcaro__price\">{{ p.price | money }}{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}</div>\n          </div>\n        </a>\n      {%- endunless -%}\n    {%- endfor -%}\n  </div>\n</section>\n{%- endif -%}"
      }
    },
    "custom_liquid_CxGYaH": {
      "type": "custom-liquid",
      "name": "Product Details",
      "settings": {
        "title": "",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  =====================================================================\n  MIRROR — PRODUCT DETAILS spec block  (paste into a \"Liquid\" block)\n  Built from your real metafield definitions. Empty rows auto-hide.\n\n  KEYS USED (namespace.key) — VERIFY each on its definition page:\n    custom.width            custom.height          custom.orientation\n    custom.frame_type       custom.design          custom.colour\n    custom.lighting         custom.color_temprature  ← note the typo'd key\n    custom.demister         custom.bluetooth       custom.shaver_socket\n    custom.power\n  If any definition shows a different namespace or key, change it below.\n  =====================================================================\n{%- endcomment -%}\n\n{%- liquid\n  assign m = product.metafields.custom\n-%}\n\n<style>\n  .mspec{font-family:\"Roboto\",sans-serif;max-width:900px;margin:0 auto}\n  .mspec__h{font-family:\"Fraunces\",serif;font-weight:700;font-size:32px;line-height:1.15;color:#016FD0;margin:0 0 18px}\n  .mspec__grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 32px}\n  .mspec__row{display:flex;justify-content:space-between;gap:14px;padding:12px 15px;background:#f7f8f9;border-radius:9px;font-size:14.5px}\n  .mspec__row b{font-weight:700;color:#1a1d24}\n  .mspec__row span{color:#3a4047;text-align:right}\n  @media(max-width:640px){.mspec__h{font-size:25px}.mspec__grid{grid-template-columns:1fr}}\n</style>\n\n<section class=\"mspec\">\n  <h2 class=\"mspec__h\">Product Details</h2>\n  <div class=\"mspec__grid\">\n\n    {%- if m.width != blank and m.height != blank -%}\n      <div class=\"mspec__row\"><b>Size</b><span>{{ m.width }} &times; {{ m.height }}</span></div>\n    {%- elsif m.width != blank -%}\n      <div class=\"mspec__row\"><b>Width</b><span>{{ m.width }}</span></div>\n    {%- elsif m.height != blank -%}\n      <div class=\"mspec__row\"><b>Height</b><span>{{ m.height }}</span></div>\n    {%- endif -%}\n\n    {%- if m.orientation != blank -%}\n      <div class=\"mspec__row\"><b>Orientation</b><span>{{ m.orientation }}</span></div>\n    {%- endif -%}\n\n    {%- if m.design != blank -%}\n      <div class=\"mspec__row\"><b>Shape / Design</b><span>{{ m.design }}</span></div>\n    {%- endif -%}\n\n    {%- if m.frame_type != blank -%}\n      <div class=\"mspec__row\"><b>Frame</b><span>{{ m.frame_type }}</span></div>\n    {%- endif -%}\n\n    {%- if m.colour != blank -%}\n      <div class=\"mspec__row\"><b>Colour / Finish</b><span>{{ m.colour }}</span></div>\n    {%- endif -%}\n\n    {%- if m.lighting != blank -%}\n      <div class=\"mspec__row\"><b>Lighting</b><span>{{ m.lighting }}</span></div>\n    {%- endif -%}\n\n    {%- if m.color_temprature != blank -%}\n      <div class=\"mspec__row\"><b>Colour Temperature</b><span>{{ m.color_temprature }}</span></div>\n    {%- endif -%}\n\n    {%- if m.demister != blank -%}\n      <div class=\"mspec__row\"><b>Demister / Anti-Fog</b><span>{{ m.demister }}</span></div>\n    {%- endif -%}\n\n    {%- if m.bluetooth != blank -%}\n      <div class=\"mspec__row\"><b>Bluetooth</b><span>{{ m.bluetooth }}</span></div>\n    {%- endif -%}\n\n    {%- if m.shaver_socket != blank -%}\n      <div class=\"mspec__row\"><b>Shaver Socket</b><span>{{ m.shaver_socket }}</span></div>\n    {%- endif -%}\n\n    {%- if m.power != blank -%}\n      <div class=\"mspec__row\"><b>Power</b><span>{{ m.power }}</span></div>\n    {%- endif -%}\n\n  </div>\n</section>"
      }
    },
    "custom_liquid_t77pJf": {
      "type": "custom-liquid",
      "name": "Paired With",
      "settings": {
        "title": "",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  =====================================================================\n  MIRROR — \"Customers also paired with\" carousel  (Liquid block)\n  Cross-sells TILES + bathroom products on a mirror page.\n  Pulls a few products from each handle below. CSS scroll (no JS).\n  Edit the handles + per-collection count + heading to taste.\n  =====================================================================\n{%- endcomment -%}\n\n{%- assign source_handles = 'tile-sale,stylish-radiators-heated-towel-rails,luxury-shower-sets,toilets' | split: ',' -%}\n{%- assign per_collection = 3 -%}\n{%- assign heading = 'Customers also paired with' -%}\n\n<style>\n  .pcaro{font-family:\"Roboto\",sans-serif;max-width:1100px;margin:0 auto}\n  .pcaro__h{font-family:\"Fraunces\",serif;font-weight:700;font-size:30px;color:#016FD0;margin:0 0 18px}\n  .pcaro__track{display:flex;gap:16px;overflow-x:auto;padding:4px 4px 14px;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}\n  .pcaro__track::-webkit-scrollbar{height:6px}\n  .pcaro__track::-webkit-scrollbar-thumb{background:#cfd6dd;border-radius:6px}\n  .pcaro__card{flex:0 0 220px;scroll-snap-align:start;border:2px solid #e6e8eb;border-radius:12px;overflow:hidden;background:#fff;text-decoration:none;color:#1a1d24;transition:border-color .15s}\n  .pcaro__card:hover{border-color:#016FD0}\n  .pcaro__img{position:relative;padding-bottom:100%;background:#f3f5f6}\n  .pcaro__img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n  .pcaro__save{position:absolute;top:10px;left:10px;background:#c8102e;color:#fff;font-size:11px;font-weight:700;border-radius:6px;padding:3px 8px}\n  .pcaro__body{padding:12px 14px}\n  .pcaro__title{font-size:13.5px;font-weight:600;line-height:1.35;min-height:38px;margin-bottom:8px}\n  .pcaro__price{font-size:16px;font-weight:800}\n  .pcaro__price s{font-size:12.5px;color:#6b7280;font-weight:500;margin-left:6px}\n  @media(max-width:640px){.pcaro__h{font-size:24px}.pcaro__card{flex-basis:165px}}\n</style>\n\n<section class=\"pcaro\">\n  <h2 class=\"pcaro__h\">{{ heading }}</h2>\n  <div class=\"pcaro__track\">\n    {%- for h in source_handles -%}\n      {%- assign coll = collections[h] -%}\n      {%- if coll != blank -%}\n        {%- for p in coll.products limit: per_collection -%}\n          <a class=\"pcaro__card\" href=\"{{ p.url }}\">\n            <div class=\"pcaro__img\">\n              {%- if p.compare_at_price > p.price -%}\n                {%- assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}\n                <span class=\"pcaro__save\">Save {{ pct }}%</span>\n              {%- endif -%}\n              {%- if p.featured_image -%}\n                <img src=\"{{ p.featured_image | image_url: width: 440 }}\" alt=\"{{ p.featured_image.alt | escape | default: p.title }}\" loading=\"lazy\">\n              {%- endif -%}\n            </div>\n            <div class=\"pcaro__body\">\n              <div class=\"pcaro__title\">{{ p.title }}</div>\n              <div class=\"pcaro__price\">{{ p.price | money }}{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}</div>\n            </div>\n          </a>\n        {%- endfor -%}\n      {%- endif -%}\n    {%- endfor -%}\n  </div>\n</section>"
      }
    },
    "custom_liquid_hYpwa8": {
      "type": "custom-liquid",
      "name": "Product Description",
      "settings": {
        "title": "Product Description",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  Liquid block titled \"Description\". Pulls product.description into its own block\n  with a \"Read more\" toggle. The toggle only appears when the text is long enough\n  to need clamping, so short descriptions show in full with no button.\n  (If you use this, delete the theme's native Description block to avoid duplication.)\n{%- endcomment -%}\n{%- if product.description != blank -%}\n  <div class=\"tp-desc-wrap\">\n    <div class=\"tp-desc rte\">\n      {{ product.description | remove: 'data-section-type=\"product\"' }}\n    </div>\n    <button type=\"button\" class=\"tp-desc-toggle\" style=\"display:none\">Read more</button>\n  </div>\n\n  <style>\n    .tp-desc-wrap{max-width:820px;font-family:\"Open Sans\",sans-serif;}\n    .tp-desc{font-size:15px;line-height:1.7;color:#3a3f48;position:relative;overflow:hidden;}\n    .tp-desc.is-clamped{max-height:230px;}\n    .tp-desc.is-clamped::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:80px;\n      background:linear-gradient(to bottom,rgba(255,255,255,0),#fff);pointer-events:none;}\n    .tp-desc h2,.tp-desc h3{color:#1a1d24;font-weight:800;margin:16px 0 6px;line-height:1.3;}\n    .tp-desc p{margin:0 0 11px;}\n    .tp-desc ul,.tp-desc ol{margin:8px 0 14px 20px;}\n    .tp-desc li{margin-bottom:5px;}\n    .tp-desc table{width:100%;border-collapse:collapse;margin:10px 0;}\n    .tp-desc td,.tp-desc th{border:1px solid #e6e8eb;padding:8px 12px;text-align:left;}\n    .tp-desc-toggle{margin-top:12px;background:none;border:0;color:#c8102e;font-weight:700;\n      cursor:pointer;font-size:14px;font-family:\"Open Sans\",sans-serif;padding:0;}\n    .tp-desc-toggle:hover{text-decoration:underline;}\n  </style>\n\n  <script>\n    (function(){\n      document.querySelectorAll('.tp-desc-wrap').forEach(function(wrap){\n        var desc = wrap.querySelector('.tp-desc');\n        var btn  = wrap.querySelector('.tp-desc-toggle');\n        if(!desc || !btn) return;\n        var CLAMP = 230;\n        if(desc.scrollHeight > CLAMP + 60){\n          desc.classList.add('is-clamped');\n          btn.style.display = 'inline-block';\n          btn.addEventListener('click', function(){\n            var clamped = desc.classList.toggle('is-clamped');\n            btn.textContent = clamped ? 'Read more' : 'Read less';\n          });\n        }\n      });\n    })();\n  </script>\n{%- endif -%}"
      }
    },
