        "delivery_options_block": {
          "type": "delivery_options",
          "settings": {
            "get_it_text": "Get It Friday",
            "order_in_text": "Order in 21 hours and 4 minutes",
            "delivery_options_title": "Delivery Options",
            "delivery_options_subtitle": "Add postcode to view all options",
            "delivery_options_list": "<p></p><ul><li><strong>FREE Standard Pallet Delivery</strong><br/>Over £499 to UK mainland, 2-4 working days</li><li><strong>Standard Pallet Delivery</strong> <br/>£39.99 for orders £100-£499, 2-7 working days</li><li><strong>Next Day Pallet Service</strong> <br/>Available at checkout, subject to postcode</li><li><strong>Day Specific Pallet</strong> <br/>Available at checkout, subject to postcode</li></ul><p></p>",
            "delivery_drawer_content": "<p><strong>Free Standard Pallet Delivery</strong></p><p>Free on all orders over £499 to UK mainland. Estimated 2-7 working days.</p><p><strong>Standard Pallet Delivery</strong></p><p>£39.99 on orders between £100 and £499. Estimated 2-7 working days.</p><p><strong>Express / Next Day</strong></p><p>Available at checkout depending on your postcode.</p><p><strong>Day Specific Pallet</strong></p><p>Available at checkout depending on your postcode.</p><p><strong>Saturday Delivery</strong></p><p>Available at checkout depending on your postcode.</p><p>All tile and SPC flooring orders are delivered kerbside on a pallet. The driver cannot bring goods inside or unpack on your behalf, so please make sure someone is home on the day. You can add Extended Delivery Protection for £9.99 at checkout, which extends your damage reporting window from 2 to 7 working days.</p>",
            "faq_text": "Delivery, Damage & Returns",
            "faq_drawer_content": "<p><strong>Pallet Delivery (Tiles & SPC)</strong></p><p>Delivered on a pallet (kerbside only). Driver cannot unpack or move goods inside.</p><p><strong>Damage / Incorrect Delivery</strong></p><p>Notify us within 2 working days of delivery for replacements or refunds. Please provide photos while items are still on the pallet. If you added Extended Delivery Protection (£9.99), you have 4 working days. Do not dispose of goods or packaging.</p><p>Email: <a href=\"mailto:sales@tilesparadiseuk.com\">sales@tilesparadiseuk.com</a></p><p><strong>Check Before Installation</strong></p><p>Please inspect all tiles before cutting or installation. Claims cannot be accepted after cutting or installation. We recommend ordering a minimum 10% extra for cuts and wastage.</p><p><strong>Returns (Change of mind)</strong></p><p>You may cancel your entire order within 14 days of delivery. Returns must be unused, in original packaging and re-saleable. Tile & SPC returns are subject to a handling/restocking fee. No returns on leftovers.</p><p>View full policies: <a href=\"https://tilesparadiseuk.com/pages/shipping-policy\">Delivery</a>, <a href=\"https://tilesparadiseuk.com/pages/damages\">Damages</a> & <a href=\"https://tilesparadiseuk.com/pages/refund-policy\">Returns</a></p>"
          }
        },
