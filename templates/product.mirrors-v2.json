        "tile_swatches_custom": {
          "type": "custom_swatches",
          "settings": {
            "title": "Colour Swatches",
            "liquid": "<style>\n/* ---------- container ---------- */\n.tp-range-options {\n  margin: 1.5rem 0;\n  padding: 1.375rem 0;\n  border-top: 1px solid #ececec;\n  border-bottom: 1px solid #ececec;\n}\n.tp-range-options > * + * { margin-top: 1.375rem; }\n\n/* ---------- label ---------- */\n.tp-range-options__label {\n  display: flex; align-items: baseline; gap: .4rem;\n  margin-bottom: .875rem;\n  font-size: .9375rem; line-height: 1.4;\n}\n.tp-range-options__label strong { font-weight: 700; color: #111; }\n.tp-range-options__label span   { font-weight: 400; color: #555; }\n\n/* ---------- lists ---------- */\n.tp-range-list {\n  display: flex; flex-wrap: wrap; gap: .75rem;\n  list-style: none; margin: 0; padding: 0;\n}\n\n/* ---------- colour swatches ---------- */\n.tp-range-swatch {\n  display: block; width: 34px; height: 34px;\n  border-radius: 50%; padding: 3px;\n  box-shadow: inset 0 0 0 1px #e3e3e3;\n  transition: box-shadow .18s ease;\n}\n.tp-range-swatch__image {\n  display: block; width: 100%; height: 100%;\n  border-radius: 50%; overflow: hidden; position: relative;\n}\n.tp-range-swatch__image img {\n  width: 100%; height: 100%;\n  object-fit: cover; display: block;\n  transform: scale(1.9); transform-origin: center center;\n}\n.tp-range-swatch__colour {\n  display: block; width: 100%; height: 100%;\n  box-shadow: inset 0 0 0 1px rgba(0,0,0,.08);\n}\n.tp-range-swatch__fallback {\n  display: flex; align-items: center; justify-content: center;\n  width: 100%; height: 100%; background: #f2f2f2;\n  font-size: 1rem; font-weight: 600; color: #555;\n}\n.tp-range-swatch:hover { box-shadow: inset 0 0 0 1px #9a9a9a; }\n.tp-range-swatch.is-current { box-shadow: inset 0 0 0 2px #111; }\n\n/* ---------- pills (size + finish) ---------- */\n.tp-range-pill {\n  display: inline-flex; align-items: center; justify-content: center;\n  min-width: 112px; min-height: 44px; padding: .7rem 1.25rem;\n  border: 1px solid #dcdcdc; border-radius: 999px;\n  font-size: .875rem; font-weight: 600; line-height: 1;\n  color: #111; background: #fff; text-decoration: none;\n  transition: border-color .18s ease, box-shadow .18s ease, background .18s ease, color .18s ease;\n}\n.tp-range-pill:hover:not(.is-current) { border-color: #111; }\n.tp-range-pill.is-current {\n  background: #016FD0; border-color: #016FD0; color: #fff;\n  box-shadow: 0 1px 6px rgba(1,111,208,.28);\n}\n\n/* ---------- sold out ---------- */\n.tp-range-swatch.is-soldout { opacity: .4; }\n.tp-range-swatch.is-soldout .tp-range-swatch__image::after {\n  content: ''; position: absolute; inset: 0;\n  background: linear-gradient(to bottom right, transparent calc(50% - 1px), #8a8a8a 50%, transparent calc(50% + 1px));\n}\n.tp-range-pill.is-soldout {\n  color: #8a8a8a;\n  text-decoration: line-through;\n  text-decoration-thickness: 1.5px;\n  text-underline-offset: 2px;\n}\n.tp-range-pill.is-soldout.is-current { background: #fff; border-color: #dcdcdc; color: #8a8a8a; box-shadow: none; }\n\n/* ---------- mobile ---------- */\n@media (max-width: 480px) {\n  .tp-range-swatch { width: 34px; height: 34px; }\n  .tp-range-pill { min-width: 0; flex: 1 1 calc(50% - .75rem); padding: .7rem 1rem; }\n}\n\n.tp-visually-hidden {\n  position: absolute !important; width: 1px; height: 1px;\n  padding: 0; margin: -1px; overflow: hidden;\n  clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n}\n</style>\n\n{%- assign range = product.metafields.custom.range.value -%}\n{%- if range != blank -%}\n  {%- assign siblings = range.products.value -%}\n  {%- if siblings.size > 1 -%}\n\n    {%- liquid\n      assign cur_colour_raw = product.metafields.custom.colour_name.value\n      assign cur_size_raw   = product.metafields.custom.size.value\n      assign cur_finish_raw = product.metafields.custom.tile_finish.value\n\n      assign cur_colour = cur_colour_raw | default: product.title\n      assign cur_finish = cur_finish_raw\n\n      assign cur_size_label = product.metafields.custom.size_name.value\n      if cur_size_label == blank\n        assign cur_size_label = cur_size_raw\n        if cur_size_label contains '('\n          assign cur_size_label = cur_size_label | split: '(' | last | remove: ')'\n        endif\n      endif\n\n      assign colour_count = 0\n      assign size_count = 0\n      assign finish_count = 0\n\n      for sib in siblings\n        assign m_size = false\n        assign m_finish = false\n        assign m_colour = false\n        if cur_size_raw == blank or sib.metafields.custom.size.value == cur_size_raw\n          assign m_size = true\n        endif\n        if cur_finish_raw == blank or sib.metafields.custom.tile_finish.value == cur_finish_raw\n          assign m_finish = true\n        endif\n        if cur_colour_raw == blank or sib.metafields.custom.colour_name.value == cur_colour_raw\n          assign m_colour = true\n        endif\n\n        if m_size and m_finish\n          assign colour_count = colour_count | plus: 1\n        endif\n        if m_colour and m_finish\n          assign size_count = size_count | plus: 1\n        endif\n        if m_colour and m_size\n          assign finish_count = finish_count | plus: 1\n        endif\n      endfor\n    -%}\n\n\n    <div style=\"background:#fff3cd;border:1px solid #ffc107;padding:10px;margin:10px 0;font-size:13px;font-family:monospace;border-radius:6px;\">\n      <strong>🔍 DEBUG</strong><br>\n      siblings.size: {{ siblings.size }}<br>\n      cur_colour_raw: \"{{ cur_colour_raw }}\"<br>\n      cur_size_raw: \"{{ cur_size_raw }}\"<br>\n      cur_finish_raw: \"{{ cur_finish_raw }}\"<br>\n      colour_count: {{ colour_count }}<br>\n      size_count: {{ size_count }}<br>\n      finish_count: {{ finish_count }}<br>\n      {%- for sib in siblings -%}\n        <br>Sib[{{ forloop.index }}]: colour=\"{{ sib.metafields.custom.colour_name.value }}\" size=\"{{ sib.metafields.custom.size.value }}\" size_name=\"{{ sib.metafields.custom.size_name.value }}\"\n      {%- endfor -%}\n    </div>\n    <div class=\"tp-range-options\">\n\n      {%- comment -%} ===== 1. COLOUR — filtered by size + finish ===== {%- endcomment -%}\n      {%- if colour_count > 1 -%}\n        <div class=\"tp-range-colours\">\n          <div class=\"tp-range-options__label\">\n            <strong>Colour:</strong><span>{{ cur_colour }}</span>\n          </div>\n          <ul class=\"tp-range-list\" role=\"list\">\n            {%- for sib in siblings -%}\n              {%- if cur_size_raw == blank or sib.metafields.custom.size.value == cur_size_raw -%}\n                {%- if cur_finish_raw == blank or sib.metafields.custom.tile_finish.value == cur_finish_raw -%}\n                  {%- liquid\n                    assign swatch_name = sib.metafields.custom.colour_name.value | default: sib.title\n                    assign swatch_hex = sib.metafields.custom.colour_hex.value | strip\n                    if swatch_hex != blank\n                      unless swatch_hex contains '#'\n                        assign swatch_hex = '#' | append: swatch_hex\n                      endunless\n                    endif\n                  -%}\n                  <li>\n                    <a href=\"{{ sib.url }}\"\n                       class=\"tp-range-swatch{% if sib.id == product.id %} is-current{% endif %}{% unless sib.available %} is-soldout{% endunless %}\"\n                       title=\"{{ swatch_name | escape }}{% unless sib.available %} — sold out{% endunless %}\"\n                       aria-label=\"Choose colour {{ swatch_name | escape }}{% unless sib.available %}, sold out{% endunless %}\"\n                       {% if sib.id == product.id %}aria-current=\"page\"{% endif %}>\n                      <span class=\"tp-range-swatch__image\">\n                        {%- if swatch_hex != blank -%}\n                          <span class=\"tp-range-swatch__colour\" style=\"background-color: {{ swatch_hex | escape }};\"></span>\n                        {%- elsif sib.featured_image -%}\n                          <img src=\"{{ sib.featured_image | image_url: width: 240 }}\" alt=\"{{ swatch_name | escape }}\" width=\"34\" height=\"34\" loading=\"lazy\">\n                        {%- else -%}\n                          <span class=\"tp-range-swatch__fallback\">{{ swatch_name | slice: 0 }}</span>\n                        {%- endif -%}\n                      </span>\n                    </a>\n                  </li>\n                {%- endif -%}\n              {%- endif -%}\n            {%- endfor -%}\n          </ul>\n        </div>\n      {%- endif -%}\n\n      {%- comment -%} ===== 2. SIZE — filtered by colour + finish ===== {%- endcomment -%}\n      {%- if size_count > 0 -%}\n        <div class=\"tp-range-sizes\">\n          <div class=\"tp-range-options__label\">\n            <strong>Size:</strong><span>{{ cur_size_label }}</span>\n          </div>\n          <ul class=\"tp-range-list\" role=\"list\">\n            {%- for sib in siblings -%}\n              {%- if cur_colour_raw == blank or sib.metafields.custom.colour_name.value == cur_colour_raw -%}\n                {%- if cur_finish_raw == blank or sib.metafields.custom.tile_finish.value == cur_finish_raw -%}\n                  {%- liquid\n                    assign size_label = sib.metafields.custom.size_name.value\n                    if size_label == blank\n                      assign size_label = sib.metafields.custom.size.value\n                      if size_label contains '('\n                        assign size_label = size_label | split: '(' | last | remove: ')'\n                      endif\n                    endif\n                  -%}\n                  <li>\n                    <a href=\"{{ sib.url }}\"\n                       class=\"tp-range-pill{% if sib.id == product.id %} is-current{% endif %}{% unless sib.available %} is-soldout{% endunless %}\"\n                       {% if sib.id == product.id %}aria-current=\"page\"{% endif %}>\n                      {{ size_label }}\n                      {%- unless sib.available -%}<span class=\"tp-visually-hidden\">, sold out</span>{%- endunless -%}\n                    </a>\n                  </li>\n                {%- endif -%}\n              {%- endif -%}\n            {%- endfor -%}\n          </ul>\n        </div>\n      {%- endif -%}\n\n      {%- comment -%} ===== 3. FINISH — filtered by colour + size ===== {%- endcomment -%}\n      {%- if finish_count > 1 -%}\n        <div class=\"tp-range-finishes\">\n          <div class=\"tp-range-options__label\">\n            <strong>Finish:</strong><span>{{ cur_finish }}</span>\n          </div>\n          <ul class=\"tp-range-list\" role=\"list\">\n            {%- for sib in siblings -%}\n              {%- if cur_colour_raw == blank or sib.metafields.custom.colour_name.value == cur_colour_raw -%}\n                {%- if cur_size_raw == blank or sib.metafields.custom.size.value == cur_size_raw -%}\n                  <li>\n                    <a href=\"{{ sib.url }}\"\n                       class=\"tp-range-pill{% if sib.id == product.id %} is-current{% endif %}{% unless sib.available %} is-soldout{% endunless %}\"\n                       {% if sib.id == product.id %}aria-current=\"page\"{% endif %}>\n                      {{ sib.metafields.custom.tile_finish.value }}\n                      {%- unless sib.available -%}<span class=\"tp-visually-hidden\">, sold out</span>{%- endunless -%}\n                    </a>\n                  </li>\n                {%- endif -%}\n              {%- endif -%}\n            {%- endfor -%}\n          </ul>\n        </div>\n      {%- endif -%}\n\n    </div>\n\n  {%- endif -%}\n{%- endif -%}"
          }
