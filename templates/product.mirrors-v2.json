    "custom_liquid_cGhqfW": {
      "type": "custom-liquid",
      "name": "FRONT/BACKLIT",
      "settings": {
        "title": "",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  =====================================================================\n  MIRROR — \"Front-lit or backlit?\" lighting explainer (Liquid block)\n  Informational/SEO block + buyer decision aid. Inline SVG, no JS.\n  =====================================================================\n{%- endcomment -%}\n\n<style>\n  .mlx{font-family:\"Roboto\",sans-serif;max-width:1000px;margin:0 auto}\n  .mlx__h{font-family:\"Fraunces\",serif;font-weight:700;font-size:30px;color:#016FD0;margin:0 0 6px}\n  .mlx__sub{color:#5a6068;font-size:15px;margin:0 0 22px;max-width:680px}\n  .mlx__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}\n  .mlx__card{border:2px solid #e6e8eb;border-radius:14px;padding:22px;text-align:center;background:#fff}\n  .mlx__card svg{width:100%;height:120px;margin-bottom:14px}\n  .mlx__t{font-family:\"Fraunces\",serif;font-weight:700;font-size:19px;color:#1a1d24;margin-bottom:6px}\n  .mlx__d{font-size:13.5px;color:#3a4047;line-height:1.55}\n  .mlx__best{display:inline-block;margin-top:12px;font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#016FD0;background:#eaf3fc;border-radius:20px;padding:5px 12px}\n  @media(max-width:760px){.mlx__grid{grid-template-columns:1fr}.mlx__h{font-size:25px}}\n</style>\n\n<section class=\"mlx\">\n  <h2 class=\"mlx__h\">Front-lit or backlit?</h2>\n  <p class=\"mlx__sub\">The lighting style changes how the mirror looks and how well it lights your face. Here's how to choose.</p>\n\n  <div class=\"mlx__grid\">\n\n    <!-- FRONT-LIT -->\n    <div class=\"mlx__card\">\n      <svg viewBox=\"0 0 200 120\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n        <rect x=\"58\" y=\"18\" width=\"60\" height=\"84\" rx=\"6\" fill=\"#eaf1f8\" stroke=\"#016FD0\" stroke-width=\"2.5\"/>\n        <rect x=\"64\" y=\"24\" width=\"6\" height=\"72\" rx=\"3\" fill=\"#016FD0\"/>\n        <rect x=\"106\" y=\"24\" width=\"6\" height=\"72\" rx=\"3\" fill=\"#016FD0\"/>\n        <g stroke=\"#f5b301\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n          <line x1=\"120\" y1=\"38\" x2=\"150\" y2=\"32\"/>\n          <line x1=\"120\" y1=\"60\" x2=\"152\" y2=\"60\"/>\n          <line x1=\"120\" y1=\"82\" x2=\"150\" y2=\"88\"/>\n        </g>\n        <circle cx=\"170\" cy=\"60\" r=\"14\" fill=\"#cdd9e6\"/>\n      </svg>\n      <div class=\"mlx__t\">Front-lit</div>\n      <div class=\"mlx__d\">LED strips face forward, casting even light directly onto your face with no shadows.</div>\n      <span class=\"mlx__best\">Best for makeup &amp; shaving</span>\n    </div>\n\n    <!-- BACKLIT -->\n    <div class=\"mlx__card\">\n      <svg viewBox=\"0 0 200 120\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n        <defs><radialGradient id=\"glow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n          <stop offset=\"60%\" stop-color=\"#fff4cf\"/><stop offset=\"100%\" stop-color=\"#fff4cf\" stop-opacity=\"0\"/>\n        </radialGradient></defs>\n        <ellipse cx=\"100\" cy=\"60\" rx=\"78\" ry=\"52\" fill=\"url(#glow)\"/>\n        <rect x=\"68\" y=\"20\" width=\"64\" height=\"80\" rx=\"8\" fill=\"#eaf1f8\" stroke=\"#016FD0\" stroke-width=\"2.5\"/>\n      </svg>\n      <div class=\"mlx__t\">Backlit</div>\n      <div class=\"mlx__d\">Light glows from behind the mirror onto the wall, creating a soft halo and calm atmosphere.</div>\n      <span class=\"mlx__best\">Best for ambience</span>\n    </div>\n\n    <!-- BOTH -->\n    <div class=\"mlx__card\">\n      <svg viewBox=\"0 0 200 120\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n        <defs><radialGradient id=\"glow2\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n          <stop offset=\"60%\" stop-color=\"#fff4cf\"/><stop offset=\"100%\" stop-color=\"#fff4cf\" stop-opacity=\"0\"/>\n        </radialGradient></defs>\n        <ellipse cx=\"100\" cy=\"60\" rx=\"78\" ry=\"52\" fill=\"url(#glow2)\"/>\n        <rect x=\"68\" y=\"20\" width=\"64\" height=\"80\" rx=\"8\" fill=\"#eaf1f8\" stroke=\"#016FD0\" stroke-width=\"2.5\"/>\n        <rect x=\"74\" y=\"26\" width=\"5\" height=\"68\" rx=\"2.5\" fill=\"#016FD0\"/>\n        <rect x=\"121\" y=\"26\" width=\"5\" height=\"68\" rx=\"2.5\" fill=\"#016FD0\"/>\n      </svg>\n      <div class=\"mlx__t\">Front &amp; backlit</div>\n      <div class=\"mlx__d\">The best of both — bright task light on your face plus a warm ambient glow around the edges.</div>\n      <span class=\"mlx__best\">Best all-rounder</span>\n    </div>\n\n  </div>\n</section>"
      }
    },
    "custom_liquid_jnhHej": {
      "type": "custom-liquid",
      "name": "IP44",
      "settings": {
        "title": "",
        "include_margins": true,
        "liquid": "{%- comment -%}\n  =====================================================================\n  MIRROR — IP44 / Bathroom Zone safety block (Liquid block)\n  UK trust + objection handling. Inline SVG zone diagram, no JS.\n  =====================================================================\n{%- endcomment -%}\n\n<style>\n  .mzn{font-family:\"Roboto\",sans-serif;max-width:1000px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:center;background:#f7f8f9;border:1px solid #e6e8eb;border-radius:16px;padding:30px}\n  .mzn__h{font-family:\"Fraunces\",serif;font-weight:700;font-size:28px;color:#016FD0;margin:0 0 6px}\n  .mzn__badge{display:inline-flex;align-items:center;gap:7px;background:#016FD0;color:#fff;font-weight:800;font-size:13px;border-radius:30px;padding:6px 14px;margin-bottom:14px}\n  .mzn__p{font-size:14.5px;color:#3a4047;line-height:1.65;margin-bottom:12px}\n  .mzn__list{list-style:none;margin:0;padding:0}\n  .mzn__list li{font-size:13.5px;color:#1a1d24;font-weight:500;padding:6px 0 6px 24px;position:relative}\n  .mzn__list li::before{content:\"✓\";position:absolute;left:0;color:#1f8a4c;font-weight:800}\n  .mzn svg{width:100%;height:auto}\n  @media(max-width:760px){.mzn{grid-template-columns:1fr;padding:22px}.mzn__h{font-size:24px}}\n</style>\n\n<section class=\"mzn\">\n  <div>\n    <svg viewBox=\"0 0 320 230\" xmlns=\"http://www.w3.org/2000/svg\" aria-label=\"UK bathroom electrical zones\">\n      <rect x=\"0\" y=\"0\" width=\"320\" height=\"230\" rx=\"10\" fill=\"#fff\" stroke=\"#e6e8eb\"/>\n      <!-- Zone 3 (room) -->\n      <rect x=\"10\" y=\"14\" width=\"300\" height=\"200\" rx=\"6\" fill=\"#eef6ee\"/>\n      <text x=\"250\" y=\"30\" font-family=\"Roboto\" font-size=\"11\" font-weight=\"700\" fill=\"#3f8a4c\">Zone 3</text>\n      <!-- Zone 2 around bath -->\n      <rect x=\"14\" y=\"40\" width=\"150\" height=\"170\" rx=\"4\" fill=\"#fdf4e3\"/>\n      <text x=\"80\" y=\"56\" font-family=\"Roboto\" font-size=\"11\" font-weight=\"700\" fill=\"#c79518\">Zone 2</text>\n      <!-- Zone 1 above bath -->\n      <rect x=\"22\" y=\"60\" width=\"120\" height=\"150\" rx=\"4\" fill=\"#fbe6e6\"/>\n      <text x=\"60\" y=\"76\" font-family=\"Roboto\" font-size=\"11\" font-weight=\"700\" fill=\"#c0392b\">Zone 1</text>\n      <!-- Bath / Zone 0 -->\n      <rect x=\"22\" y=\"176\" width=\"120\" height=\"34\" rx=\"6\" fill=\"#dfe9f3\" stroke=\"#9bb6cf\"/>\n      <text x=\"60\" y=\"198\" font-family=\"Roboto\" font-size=\"10\" font-weight=\"700\" fill=\"#5b7a98\">Bath · Zone 0</text>\n      <!-- Basin + mirror in zone 2/3 -->\n      <rect x=\"214\" y=\"150\" width=\"64\" height=\"16\" rx=\"4\" fill=\"#cdd9e6\"/>\n      <text x=\"222\" y=\"184\" font-family=\"Roboto\" font-size=\"10\" fill=\"#5a6068\">Basin</text>\n      <!-- the mirror -->\n      <rect x=\"228\" y=\"70\" width=\"36\" height=\"54\" rx=\"5\" fill=\"#eaf1f8\" stroke=\"#016FD0\" stroke-width=\"3\"/>\n      <rect x=\"244\" y=\"58\" width=\"6\" height=\"10\" fill=\"#016FD0\"/>\n      <text x=\"208\" y=\"138\" font-family=\"Roboto\" font-size=\"10\" font-weight=\"700\" fill=\"#016FD0\">Your mirror</text>\n    </svg>\n  </div>\n  <div>\n    <span class=\"mzn__badge\">🛡 IP44 RATED</span>\n    <h2 class=\"mzn__h\">Safe for your bathroom</h2>\n    <p class=\"mzn__p\">An <strong>IP44</strong> rating means the mirror is protected against splashing water from any direction. Under UK wiring regulations that makes it safe for <strong>Zone 2</strong> — the area around your basin — and anywhere beyond it.</p>\n    <ul class=\"mzn__list\">\n      <li>Ideal above a basin or vanity (Zone 2)</li>\n      <li>Fit at least 60cm from a bath or shower edge</li>\n      <li>Hardwired models: fit via a qualified electrician (Part P)</li>\n      <li>Mount portrait or landscape to suit your space</li>\n    </ul>\n  </div>\n</section>"
      }
    }
