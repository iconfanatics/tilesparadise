x}.pcaro__card{flex-basis:165px}}\n</style>\n\n<section class=\"pcaro\">\n  <h2 class=\"pcaro__h\">{{ heading }}</h2>\n  <div class=\"pcaro__track\">\n    {%- for h in source_handles -%}\n      {%- assign coll = collections[h] -%}\n      {%- if coll != blank -%}\n        {%- for p in coll.products limit: per_collection -%}\n          <a class=\"pcaro__card\" href=\"{{ p.url }}\">\n            <div class=\"pcaro__img\">\n              {%- if p.compare_at_price > p.price -%}\n                {%- assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}\n                <span class=\"pcaro__save\">Save {{ pct }}%</span>\n              {%- endif -%}\n              {%- if p.featured_image -%}\n                <img src=\"{{ p.featured_image | image_url: width: 440 }}\" alt=\"{{ p.featured_image.alt | escape | default: p.title }}\" loading=\"lazy\">\n              {%- endif -%}\n            </div>\n            <div class=\"pcaro__body\">\n              <div class=\"pcaro__title\">{{ p.title }}</div>\n              <div class=\"pcaro__price\">{{ p.price | money }}{%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}</div>\n            </div>\n          </a>\n        {%- endfor -%}\n      {%- endif -%}\n    {%- endfor -%}\n  </div>\n</section>"
      }
