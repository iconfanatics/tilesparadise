<script>
document.addEventListener("DOMContentLoaded", function () {
  const addToCartBtn = document.querySelector('.product-form__add-button');

  if (addToCartBtn) {
    addToCartBtn.addEventListener('click', function (event) {
      event.preventDefault(); // prevent default form submit

      const form = addToCartBtn.closest('form');
      const formData = new FormData(form);

      // Step 1: Add to cart via AJAX
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData,
      })
      .then(response => {
        if (response.ok) {
          // Step 2: Reload the page
          // But first set a flag in localStorage to trigger cart icon click after reload
          localStorage.setItem('openCartAfterReload', 'true');
          location.reload();
        } else {
          return response.json().then(err => {
            console.error("Add to cart failed:", err);
          });
        }
      })
      .catch(err => {
        console.error("Add to cart error:", err);
      });
    });
  }

  // Step 3: After reload, click cart icon if flag is set
  if (localStorage.getItem('openCartAfterReload') === 'true') {
    localStorage.removeItem('openCartAfterReload'); // clear the flag

    // Wait a little to ensure cart icon exists
    setTimeout(() => {
      const cartIcon = document.querySelector('.header__cart-toggle');
      if (cartIcon) {
        cartIcon.click();
      }
    }, 1000); // wait 1 second after reload
  }
});
</script>

