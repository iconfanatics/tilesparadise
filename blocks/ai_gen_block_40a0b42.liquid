{% doc %}
  @prompt
    a carousel that shows epcial offer using this collection page new-year-tile-sale-2026-unbeatable-discounts-on-luxury-tiles, where it shows price can you add per m2 next to it, Can you add a view all offers link which will take customers to the full collection page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sale-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-sale-carousel__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-sale-carousel__header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ai-sale-carousel__header-text-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    flex: 1;
  }

  .ai-sale-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
    font-weight: 600;
  }

  .ai-sale-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-sale-carousel__view-all-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: {{ block.settings.view_all_background }};
    color: {{ block.settings.view_all_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.view_all_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .ai-sale-carousel__view-all-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.view_all_hover_background }};
  }

  .ai-sale-carousel__view-all-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  .ai-sale-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-sale-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 10px;
  }

  .ai-sale-carousel__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-sale-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.product_gap }}px * ({{ block.settings.products_per_row_desktop | minus: 1 }})) / {{ block.settings.products_per_row_desktop }});
    min-width: 250px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.card_shadow }};
    transition: transform 0.3s ease;
  }

  .ai-sale-carousel__item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-sale-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-sale-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-sale-carousel__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-sale-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-sale-carousel__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    z-index: 1;
  }

  .ai-sale-carousel__content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-sale-carousel__product-title-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 10px;
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-sale-carousel__product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-sale-carousel__product-title-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.accent_color }};
  }

  .ai-sale-carousel__price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 15px;
    flex-wrap: wrap;
  }

  .ai-sale-carousel__price-{{ ai_gen_id }} {
    font-size: 18px;
    color: {{ block.settings.sale_price_color }};
    font-weight: 600;
  }

  .ai-sale-carousel__price-unit-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.product_title_color }};
    font-weight: 400;
  }

  .ai-sale-carousel__compare-price-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-sale-carousel__button-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 12px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-sale-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-sale-carousel__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 30px;
  }

  .ai-sale-carousel__nav-button-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-sale-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_background }};
  }

  .ai-sale-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-sale-carousel__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
  }

  @media screen and (max-width: 749px) {
    .ai-sale-carousel__item-{{ ai_gen_id }} {
      flex: 0 0 calc(100% - 20px);
      min-width: 280px;
    }

    .ai-sale-carousel__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-sale-carousel__subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-sale-carousel__header-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
    }

    .ai-sale-carousel__view-all-{{ ai_gen_id }} {
      align-self: center;
    }
  }
{% endstyle %}

<sale-carousel-{{ ai_gen_id }} class="ai-sale-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-sale-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.show_view_all %}
      <div class="ai-sale-carousel__header-{{ ai_gen_id }}">
        <div class="ai-sale-carousel__header-text-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-sale-carousel__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.subheading != blank %}
            <p class="ai-sale-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
          {% endif %}
        </div>
        
        {% if block.settings.show_view_all and block.settings.collection != blank %}
          <a href="{{ block.settings.collection.url }}" class="ai-sale-carousel__view-all-{{ ai_gen_id }}">
            {{ block.settings.view_all_text }}
            <svg class="ai-sale-carousel__view-all-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      <div class="ai-sale-carousel__wrapper-{{ ai_gen_id }}">
        <div class="ai-sale-carousel__track-{{ ai_gen_id }}" data-carousel-track>
          {% for product in block.settings.collection.products limit: block.settings.products_limit %}
            <div class="ai-sale-carousel__item-{{ ai_gen_id }}">
              <div class="ai-sale-carousel__image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  {% capture primary_class %}ai-product-carousel__image-{{ ai_gen_id }} ai-product-carousel__primary-image-{{ ai_gen_id }}{% endcapture %}
                  {{ product.featured_image | image_tag: class: primary_class, loading: 'lazy', sizes: '(max-width: 768px) 50vw, 315px', widths: '315, 600' }}
                {% else %}
                  <div class="ai-sale-carousel__image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if product.compare_at_price > product.price %}
                  {% assign discount_percentage = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                  <div class="ai-sale-carousel__badge-{{ ai_gen_id }}">
                    {{ block.settings.badge_text | replace: '[discount]', discount_percentage }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-sale-carousel__content-{{ ai_gen_id }}">
                <h3 class="ai-sale-carousel__product-title-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>

                <div class="ai-sale-carousel__price-wrapper-{{ ai_gen_id }}">
                  <span class="ai-sale-carousel__price-{{ ai_gen_id }}">
                    {{ product.price | money }} <span class="ai-sale-carousel__price-unit-{{ ai_gen_id }}">per m²</span>
                  </span>
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-sale-carousel__compare-price-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>

                <a href="{{ product.url }}" class="ai-sale-carousel__button-{{ ai_gen_id }}">
                  {{ block.settings.button_text }}
                </a>
              </div>
            </div>
          {% endfor %}
        </div>

        {% if block.settings.show_navigation %}
          <div class="ai-sale-carousel__nav-{{ ai_gen_id }}">
            <button
              class="ai-sale-carousel__nav-button-{{ ai_gen_id }}"
              data-carousel-prev
              aria-label="Previous products"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              class="ai-sale-carousel__nav-button-{{ ai_gen_id }}"
              data-carousel-next
              aria-label="Next products"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="ai-sale-carousel__empty-{{ ai_gen_id }}">
        <p>Select a collection to display special offer products</p>
      </div>
    {% endif %}
  </div>
</sale-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class SaleCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');

        if (!this.track) return;

        this.setupNavigation();
        this.updateButtonStates();
      }

      setupNavigation() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.scroll('prev'));
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.scroll('next'));
        }

        this.track.addEventListener('scroll', () => this.updateButtonStates());
      }

      scroll(direction) {
        const scrollAmount = this.track.offsetWidth * 0.8;
        const currentScroll = this.track.scrollLeft;

        if (direction === 'prev') {
          this.track.scrollLeft = currentScroll - scrollAmount;
        } else {
          this.track.scrollLeft = currentScroll + scrollAmount;
        }
      }

      updateButtonStates() {
        if (!this.prevButton || !this.nextButton) return;

        const isAtStart = this.track.scrollLeft <= 0;
        const isAtEnd = this.track.scrollLeft + this.track.offsetWidth >= this.track.scrollWidth - 10;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('sale-carousel-{{ ai_gen_id }}', SaleCarousel{{ ai_gen_id }});
  })();
</script>

