{% schema %}
{
  "name": "Shop by Category Carousel",
  "settings": [
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class",
    },
    {
    "type": "text",
    "id": "view_all_text",
    "label": "View all text",
    "default": "View All Categories"
    },
    {
    "type": "url",
    "id": "view_all_link",
    "label": "View all link"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "collections_to_show",
      "label": "Number of collections",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Slides per view (Desktop)",
      "min": 2,
      "max": 6,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Slides per view (Mobile)",
      "min": 1,
      "max": 3,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Shop by Category Carousel"
    }
  ]
}
{% endschema %}

<section class="category-section {{ section.settings.custom_class }}">
  <div class="page-width">

    <!-- Header -->
    <div class="category-header">
      <h2>{{ section.settings.title }}</h2>

      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="view-all">
          {{ section.settings.view_all_text }} <img class="right-arrow-icon" src="{{ 'right-arrow.png' | file_url }}" alt="arrow" loading="lazy">
        </a>
      {% endif %}
    </div>

    <!-- Swiper -->
    <div class="swiper categorySwiper">
      <div class="swiper-wrapper">

        {% for collection in collections limit: section.settings.collections_to_show %}
          <div class="swiper-slide">
            <div class="category-card">
              <a href="{{ collection.url }}">
                
                <div class="image">
                  {% if collection.image %}
                    <img src="{{ collection.image | image_url: width: 600 }}" loading="lazy" alt="{{ collection.title | escape }}">
                  {% elsif collection.products.first.featured_image %}
                    <img src="{{ collection.products.first.featured_image | image_url: width: 600 }}" loading="lazy" alt="{{ collection.title | escape }}">
                  {% endif %}
                </div>

                <div class="content">
                  <h3>{{ collection.title }}</h3>
                  <span class="shop-btn-cst">Shop now</span>
                </div>

              </a>
            </div>
          </div>
        {% endfor %}

      </div>

      {% if section.settings.show_arrows %}
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      {% endif %}

      {% if section.settings.show_dots %}
        <div class="swiper-pagination"></div>
      {% endif %}
    </div>

  </div>
</section>

<style>
.category-section {
  padding: 40px 0;
  background: #fff;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}


.category-card {
    background: #fff;
    border-radius: 12px;
    border: 2px solid #016FD0;
    overflow: hidden;
}

.category-card .image {
    opacity: 1;
    border-top-left-radius: 11px;
    border-top-right-radius: 10px;
} 


.category-card .content {
  padding: 15px;
}


.category-card span {
    color: #016FD0;
    font-family: Roboto;
    font-weight: 500;
    font-size: 20px;
    line-height: 30px;
    letter-spacing: 0%;
    text-decoration: underline;
    text-decoration-style: solid;
    text-decoration-thickness: 0%;
    text-decoration-skip-ink: auto;
}

/* Swiper arrows */
.swiper-button-prev,
.swiper-button-next {
  color: #000;
}

/* Dots */
.swiper-pagination-bullet {
  background: #ccc;
  opacity: 1;
}

.swiper-pagination-bullet-active {
  background: #000;
  width: 20px;
  border-radius: 10px;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

  new Swiper('.categorySwiper', {
    loop: true,
    slidesPerView: {{ section.settings.columns_mobile }},
    spaceBetween: 20,

    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },

    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },

    breakpoints: {
      750: {
        slidesPerView: {{ section.settings.columns_desktop }}
      }
    }
  });

});
</script>