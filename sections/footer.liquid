<footer class="footer" data-section-id="{{ section.id }}" data-section-type="footer" role="contentinfo">
  <div class="container">
    <div class="footer__wrapper">
      {%- if section.blocks.size > 0 -%}
        <div class="footer__block-list">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {% when 'logo' %}
              <div class="footer__block-item footer__block-item--logo" {{ block.shopify_attributes }}>
                
                {% if block.settings.logo %}
                  {% capture logo_style %}max-width: {{ block.settings.logo_width }}px;{% endcapture %}
                  {{ block.settings.logo | image_tag: alt: 'Logo', class: 'footer-logo', loading: 'lazy', style: logo_style }}
                {% endif %}

              </div>
              {%- when 'text' -%}
                <div class="footer__block-item footer__block-item--text" {{ block.shopify_attributes }}>

                  {% if block.settings.logo %}
                    <div class="footer-logo-wrapper">
                      {{ block.settings.logo | image_tag: alt: 'Logo', class: 'footer-logo', loading: 'lazy' }}
                    </div>
                  {% endif %}

                  <button class="footer__title heading h6" disabled>
                    <span>{{ block.settings.title | escape }}</span>
                  </button>

                  <div class="footer__collapsible-content">
                    <div class="rte">
                      {{ block.settings.content }}
                    </div>
                  </div>

                </div>

              {%- when 'links' -%}
                {%- assign menu = linklists[block.settings.menu] -%}

                {%- unless menu.empty? -%}
                  <div class="footer__block-item footer__block-item--links" {{ block.shopify_attributes }}>
                    <button class="footer__title heading h6" disabled aria-expanded="false" aria-controls="block-{{ block.id }}" data-action="toggle-collapsible">
                      <span>{{ menu.title }}</span>
                      <span class="plus-button"></span>
                    </button>

                    <div id="block-{{ block.id }}" class="footer__collapsible">
                      <div class="footer__collapsible-content">
                        <ul class="footer__linklist list--unstyled" role="list">
                          {%- for link in menu.links -%}
                            <li>
                              <a href="{{ link.url }}" class="footer__link-item link">{{ link.title }}</a>
                              
                            </li>
                          {%- endfor -%}
                          
                        </ul>
                      </div>
                    </div>
                  </div>
                {%- endunless -%}

                {% when 'newsletter_custom' %}
                  <div class="footer__block-item footer__block-item--newsletter" {{ block.shopify_attributes }}>

                    <p class="footer__title heading h6">
                      {{ block.settings.heading }}
                    </p>

                    {% if block.settings.subtext != blank %}
                      <div class="footer__newsletter-text">
                        {{ block.settings.subtext }}
                      </div>
                    {% endif %}

                    {% form 'customer', class: 'footer__newsletter-form custom-newsletter-form' %}
                      <input type="hidden" name="contact[tags]" value="newsletter">

                      <div class="custom-input-wrapper">
                        
                        <input 
                          type="email" 
                          name="contact[email]" 
                          placeholder="Email" 
                          required
                          class="custom-newsletter-input"
                        >

                        <button type="submit" class="custom-submit-btn">
                          →
                        </button>

                      </div>
                    {% endform %}

                  </div>
              {%- when 'newsletter' -%}
                <div class="footer__block-item footer__block-item--newsletter" {{ block.shopify_attributes }}>
                  <p class="footer__title heading h6">{{ block.settings.title | escape }}</p>

                  <div class="footer__newsletter-wrapper">
                    {%- if block.settings.subheading != blank -%}
                      <div class="footer__newsletter-text rte">{{ block.settings.subheading }}</div>
                    {%- endif -%}

                    {%- form 'customer', id: 'footer-newsletter', class: 'footer__newsletter-form' -%}
                      {%- if form.posted_successfully? -%}
                        <p class="alert alert--success alert--center">{{ 'footer.newsletter.success' | t }}</p>
                      {%- else -%}
                        {%- if form.errors -%}
                          <p class="alert alert--error alert--center">{{ form.errors.messages['email'] }}</p>
                        {%- endif -%}

                        <input type="hidden" name="contact[tags]" value="newsletter">

                        <div class="form__input-wrapper form__input-wrapper--labelled">
                          <input type="email" id="footer[{{ section.id }}][contact][email]" name="contact[email]" class="form__field form__field--text" required="">
                          <label for="footer[{{ section.id }}][contact][email]" class="form__floating-label">{{ 'footer.newsletter.input' | t }}</label>
                        </div>

                        <button type="submit" class="form__submit form__submit--tight button button--primary">{{ 'footer.newsletter.submit' | t }}</button>
                      {%- endif -%}
                    {%- endform -%}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <aside class="footer__aside">
        {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
          {%- assign country_selector = true -%}
        {%- endif -%}

        {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
          {%- assign locale_selector = true -%}
        {%- endif -%}

        <div class="footer__aside-item footer__aside-item--localization {% if country_selector == false and locale_selector == false %}hidden-pocket{% endif %}">
          {%- if locale_selector or country_selector -%}
            {%- form 'localization', id: 'localization_form_footer', class: 'footer__localization-form' -%}
              {%- if locale_selector -%}
                <div class="footer__localization-form-item">
                  <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
                  <span class="visually-hidden">{{ 'footer.general.language' | t }}</span>

                  <div class="value-picker-wrapper">
                    <button type="button" class="select-button select-button--mini" aria-haspopup="true" aria-expanded="false" aria-controls="footer-locale-picker" data-action="open-value-picker">
                      {{- localization.language.endonym_name | capitalize -}}
                      {%- render 'icon', icon: 'arrow-bottom' -%}
                    </button>

                    <div id="footer-locale-picker" class="value-picker value-picker--small" data-picker-position="top" aria-hidden="true">
                      {% render 'icon', icon: 'nav-triangle-borderless' %}

                      <div class="value-picker__inner">
                        <header class="value-picker__header">
                          <span class="value-picker__title text--strong">{{ 'footer.general.language' | t }}</span>
                          <button type="button" class="value-picker__close" data-action="close-value-picker" aria-controls="footer-locale-picker" aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
                        </header>

                        <ul class="value-picker__choice-list" role="list">
                          {%- for language in localization.available_languages -%}
                            <li class="value-picker__choice-list-item">
                              <button type="submit" name="locale_code" class="value-picker__choice-item" value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}aria-current="true"{% endif %}>
                                {{- language.endonym_name | capitalize -}}
                              </button>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}

              {%- if country_selector -%}
                <div class="footer__localization-form-item">
                  <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">
                  <span class="visually-hidden">{{ 'footer.general.country' | t }}</span>

                  <div class="value-picker-wrapper">
                    <button type="button" class="select-button select-button--mini" aria-haspopup="true" aria-expanded="false" aria-controls="footer-currency-picker" data-action="open-value-picker">
                      {{- localization.country.name }} ({{ localization.country.currency.iso_code }} {% if localization.country.currency.symbol %}{{ localization.country.currency.symbol }}{%- endif -%})
                      {%- render 'icon', icon: 'arrow-bottom' -%}
                    </button>

                    <div id="footer-currency-picker" class="value-picker value-picker--auto value-picker--small" data-picker-position="top" aria-hidden="true">
                      {% render 'icon', icon: 'nav-triangle-borderless' %}

                      <div class="value-picker__inner value-picker__inner--restrict">
                        <header class="value-picker__header">
                          <span class="value-picker__title text--strong">{{ 'footer.general.country' | t }}</span>
                          <button type="button" class="value-picker__close" data-action="close-value-picker" aria-controls="footer-currency-picker" aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
                        </header>

                        <ul class="value-picker__choice-list" role="list">
                          {%- for country in localization.available_countries -%}
                            <li class="value-picker__choice-list-item">
                              <button type="submit" name="country_code" class="value-picker__choice-item" value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}aria-current="true"{% endif %}>
                                {{- country.name }} ({{ country.currency.iso_code }} {% if country.currency.symbol %}{{ country.currency.symbol }}{%- endif -%})
                              </button>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endform -%}
          {%- endif -%}

          {%- capture copyright_info -%}© {{ 'now' | date: '%Y' }} {{ shop.name }}<br>{{ powered_by_link }}{%- endcapture -%}
          <p class="hidden-pocket">{{ copyright_info }}</p>
        </div>

        {%- if section.settings.show_social_media -%}
          {%- capture social_media -%}{% render 'social-media', show_social_media_name: false %}{%- endcapture -%}

          {%- if social_media != blank -%}
            <div class="footer__aside-item footer__aside-item--social">
              <p class="footer__aside-title">{{ 'footer.general.follow_us' | t }}</p>

              {{ social_media }}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="footer__aside-item footer__aside-item--payment">
            <p class="footer__aside-title">{{ 'footer.general.we_accept' | t }}</p>

            <div class="payment-list">
              {% for type in shop.enabled_payment_types %}
                {{ type | payment_type_svg_tag: class: 'payment-list__item' }}
              {% endfor %}
            </div>
          </div>
        {%- endif -%}

        <div class="footer__aside-item footer__aside-item--copyright hidden-lap-and-up">
          <p>{{ copyright_info }}</p>
        </div>
      </aside>
    </div>
  </div>
</footer>


{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "Show social media",
      "info": "Make sure to have properly configured your social media in the theme settings.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Language selector",
      "info": "To add a language, go to your [language settings.](/admin/settings/languages)"
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Country/region selector",
      "info": "To add a country/region, go to your [currency settings.](/admin/settings/payments)"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country/region selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo Width",
          "min": 80,
          "max": 250,
          "step": 10,
          "default": 150
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "About our store"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Use this text area to tell your customers about your brand and vision. You can change it in the theme editor.</p>"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo (optional)"
        }
      ]
    },
    {
      "type": "links",
      "name": "Links",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "This menu won't show dropdown items."
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Customers who subscribe will have their email address added to the \"accepts marketing\" [customer list](/admin/customers?query=&accepts_marketing=1)."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading",
          "default": "<p>A short sentence describing what someone will receive by subscribing</p>"
        }
      ]
    },
    {
      "type": "newsletter_custom",
      "name": "Custom Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Lets Stay in Touch"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Sub Text"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "text",
        "settings": {}
      },
      {
        "type": "links",
        "settings": {
          "menu": "footer"
        }
      },
      {
        "type": "newsletter",
        "settings": {}
      }
    ]
  }
}
{% endschema %}
<style>
/* Custom Newsletter Fix */
.custom-newsletter-form {
  margin-top: 15px;
}

.custom-input-wrapper {
  position: relative;
  border-bottom: 1px solid rgba(255,255,255,0.4);
  display: flex;
  align-items: center;
}

.custom-newsletter-input {
  width: 100%;
  background: transparent;
  border: none;
  padding: 10px 30px 10px 0;
  color: #fff;
  font-size: 14px;
  outline: none;
}

.custom-newsletter-input::placeholder {
  color: rgba(255,255,255,0.6);
}

/* Arrow button */
.custom-submit-btn {
  position: absolute;
  right: 0;
  background: transparent;
  border: none;
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  padding: 0;
}

/* Hover effect */
.custom-submit-btn:hover {
  opacity: 0.7;
}
.footer__block-item--logo {
  margin-bottom: 15px;
}

.footer-logo {
  display: block;
}

/* Make it align nicely with text */
.footer__block-list {
  align-items: flex-start;
}

.footer-logo-wrapper {
  margin-bottom: 15px;
}

.footer-logo {
  max-width: 160px;
  display: block;
}

button.footer__title.heading.h6 {
    font-family: Roboto;
    font-weight: 700;
    font-size: 20px;
    line-height: 130%;
    letter-spacing: 0px;
}

p.footer__title.heading.h6 {
    font-family: Roboto;
    font-weight: 700;
    font-size: 20px;
    line-height: 130%;
    letter-spacing: 0px;
}

p.footer__aside-title {
    display: none;
}

aside.footer__aside {
    border-top: 1px solid;
    padding: 20px;
}

/* Make all footer columns equal */
.footer__block-list {
  display: grid;
  grid-template-columns: repeat(5, 1fr); /* 5 columns */
  gap: 40px;
}

/* Responsive */
@media (max-width: 768px) {
  .footer__block-list {
    grid-template-columns: repeat(2, 1fr);
  }
}

.footer__block-item--newsletter {
  max-width: 260px;
}

/* Title */
.footer__block-item--newsletter .footer__title {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 10px;
}

/* Text */
.footer__newsletter-text {
    font-family: Roboto;
    font-weight: 400;
    font-size: 16px;
    line-height: 22px;
    letter-spacing: 0px;
    color: #fff;
}

/* Input row */
.custom-input-wrapper {
  display: flex;
  align-items: center;
  border-bottom: 1px solid rgba(255,255,255,0.4);
}

/* Input */
.custom-newsletter-input {
  flex: 1;
  padding: 8px 0;
}

/* Arrow */
.custom-submit-btn {
  position: static; /* ✅ keeps in same row */
}
</style>
