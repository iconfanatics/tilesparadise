{%- comment -%}
This file has been modified by the Yoast SEO for Shopify app.
You can learn more about this (and learn how to cleanly revert these changes) at https://yoa.st/removing-theme-changes.
{%- endcomment -%}
<div class="container container--flush container--narrow">
  <details class="mobile-faq-wrapper" id="faq-wrapper-{{ section.id }}">
    <summary class="mobile-faq-summary">
      <span class="mobile-faq-title">Frequently Asked Questions</span>
      <span class="mobile-faq-icon"></span>
    </summary>
  <div class="faq" {% if disabled_by_yoast_seo %}itemscope{% endif %} {% if disabled_by_yoast_seo %}itemtype="https://schema.org/FAQPage"{% endif %}>
    <div class="faq__group-list">
      {%- for block in section.blocks -%}
        {%- if forloop.first or block.type == 'separator' -%}
          <div class="faq__group">
        {%- endif -%}

        {%- case block.type -%}
          {%- when 'separator' -%}
            <h2 class="faq__group-title heading h2" {{ block.shopify_attributes }}>
              <span class="anchor" id="block-{{ block.id }}"></span>
              {{- block.settings.title | escape -}}
            </h2>
          {%- when 'question' -%}
            <div class="faq__item" {% if disabled_by_yoast_seo %}itemscope{% endif %} {% if disabled_by_yoast_seo %}itemprop="mainEntity"{% endif %} {% if disabled_by_yoast_seo %}itemtype="https://schema.org/Question"{% endif %} {{ block.shopify_attributes }}>
              <div class="faq__item-wrapper">
                <button class="faq__question heading h4" data-action="toggle-collapsible" aria-expanded="false" aria-controls="block-{{ block.id }}" {% if disabled_by_yoast_seo %}itemprop="name"{% endif %}>{{ block.settings.title | escape }} <span class="plus-button plus-button--large"></span></button>

                <div id="block-{{ block.id }}" class="faq__answer-wrapper" {% if disabled_by_yoast_seo %}itemscope{% endif %} {% if disabled_by_yoast_seo %}itemprop="acceptedAnswer"{% endif %} {% if disabled_by_yoast_seo %}itemtype="https://schema.org/Answer"{% endif %}>
                  <div class="faq__answer rte" {% if disabled_by_yoast_seo %}itemprop="text"{% endif %}>
                    {{ block.settings.answer }}
                  </div>
                </div>
              </div>
            </div>
        {%- endcase -%}

        {%- if forloop.last or block.type == 'question' and section.blocks[forloop.index].type == 'separator' -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_contact_info -%}
      <div class="container--unflush">
        <div class="faq__contact-info">
          <header class="page__header page__header--stack page__header--centered">
            {%- if section.settings.contact_info_heading != blank -%}
              <h2 class="page__title heading h2">{{ section.settings.contact_info_heading | escape }}</h2>
            {%- endif -%}

            {%- if section.settings.contact_info_text != blank -%}
              <div class="page__description rte">
                {{ section.settings.contact_info_text }}
              </div>
            {%- endif -%}
          </header>

          <div class="text-with-icons text-with-icons--boxed">
            {%- if section.settings.contact_1_heading != blank or section.settings.contact_1_text != blank -%}
              <div class="text-with-icons__item">
                <div class="text-with-icons__icon-wrapper">
                  {%- render 'icon', icon: section.settings.contact_1_icon, stroke_width: 1.5 -%}
                </div>

                <div class="text-with-icons__content-wrapper">
                  {%- if section.settings.contact_1_heading != blank -%}
                    <p class="text-with-icons__title text--strong">{{ section.settings.contact_1_heading | escape }}</p>
                  {%- endif -%}

                  {%- if section.settings.contact_1_text != blank -%}
                    <div class="text-with-icons__content rte">
                      {{ section.settings.contact_1_text }}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.contact_2_heading != blank or section.settings.contact_2_text != blank -%}
              <div class="text-with-icons__item">
                <div class="text-with-icons__icon-wrapper">
                  {%- render 'icon', icon: section.settings.contact_2_icon, stroke_width: 1.5 -%}
                </div>

                <div class="text-with-icons__content-wrapper">
                  {%- if section.settings.contact_2_heading != blank -%}
                    <p class="text-with-icons__title text--strong">{{ section.settings.contact_2_heading | escape }}</p>
                  {%- endif -%}

                  {%- if section.settings.contact_2_text != blank -%}
                    <div class="text-with-icons__content rte">
                      {{ section.settings.contact_2_text }}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
    </div>
  </details>
</div>
<script>
  function updateFaqWrapper() {
    var wrapper = document.getElementById('faq-wrapper-{{ section.id }}');
    if (wrapper && window.innerWidth > 768) {
      wrapper.setAttribute('open', 'true');
    }
  }
  updateFaqWrapper();
  window.addEventListener('resize', updateFaqWrapper);
</script>
{% unless disabled_by_yoast_seo %}
  {% assign faq_blocks = section.blocks | where: "type", "question" %}
  {% if faq_blocks.size > 0 %}
    {%- comment -%}Yoast SEO schema control block: start.{%- endcomment -%}
{%- assign yoast_seo_settings = shop.metafields.yoast_seo.settings.value | default: shop.metafields.yoast_seo.settings -%}
{%- if disabled_by_yoast_seo or yoast_seo_settings.schema.useTheme.schema or yoast_seo_settings.schema.useTheme.webpage -%}
<script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for block in faq_blocks %}
          {
            "@type": "Question",
            "name": {{ block.settings.title | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
    {%- comment -%}Yoast SEO schema control block: end.{%- endcomment -%}
</script>
{%- endif -%}
  {% endif %}
{% endunless %}

<style>
/* Overall Container */
.faq {
  max-width: 1000px;
  margin: 0 auto;
}

/* Category Headings */
.faq__group-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
}
.faq__group {
  width: calc(50% - 20px);
  margin: 0 !important;
  padding: 0 !important;
}
.faq__group-title {
  width: 100%;
  font-family: var(--heading-font-family) !important;
  font-size: 20px !important;
  font-weight: 700 !important;
  color: #1a1a1a !important;
  margin: 0 0 15px 0 !important;
  padding-top: 0 !important;
  text-align: left !important;
  border-bottom: 2px solid #1a1a1a !important;
  padding-bottom: 8px !important;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* FAQ Minimal Accordion Items */
.faq__item {
  width: 100%;
  background: transparent !important;
  border: none !important;
  border-bottom: 1px solid #e5e5e5 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  margin-bottom: 0 !important;
}

/* Question Button */
.faq__question {
  width: 100% !important;
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  padding: 16px 0 !important;
  font-family: var(--base-font-family) !important;
  font-size: 15px !important;
  font-weight: 600 !important;
  color: #222 !important;
  background: transparent !important;
  text-align: left !important;
  transition: color 0.2s ease !important;
  border: none !important;
  letter-spacing: 0.2px;
}
.faq__question:hover,
.faq__question[aria-expanded="true"] {
  color: #016fd0 !important;
}

.faq__question .plus-button {
  transform: scale(0.6);
  opacity: 0.6;
}
.faq__question:hover .plus-button {
  opacity: 1;
}

/* Answer Area */
.faq__answer {
  padding: 0 0 16px 0 !important;
  font-size: 14px !important;
  color: #666 !important;
  line-height: 1.5 !important;
  border-top: none !important;
}
.faq__answer p {
  margin-bottom: 8px !important;
}
.faq__answer p:last-child {
  margin-bottom: 0 !important;
}

@media screen and (max-width: 768px) {
  .faq__group {
    width: 100%;
  }
}

/* Contact Info Section Redesign (Any question?) */
.faq__contact-info {
  background: #f8f9fa !important;
  border-radius: 16px !important;
  padding: 50px 40px !important;
  margin-top: 60px !important;
  text-align: center !important;
  border: 1px solid #eaeaea !important;
}

.faq__contact-info .page__title {
  font-family: var(--heading-font-family) !important;
  font-size: 32px !important;
  font-weight: 800 !important;
  color: #1a1a1a !important;
  margin-bottom: 15px !important;
  letter-spacing: -0.5px !important;
}

.faq__contact-info .page__description {
  font-size: 16px !important;
  color: #555 !important;
  max-width: 600px !important;
  margin: 0 auto 40px auto !important;
  line-height: 1.5 !important;
}

/* Contact Cards */
.faq__contact-info .text-with-icons {
  display: flex !important;
  justify-content: center !important;
  gap: 20px !important;
  flex-wrap: wrap !important;
  margin: 0 !important;
}

.faq__contact-info .text-with-icons__item {
  background: #ffffff !important;
  border-radius: 12px !important;
  padding: 30px 20px !important;
  width: calc(50% - 10px) !important;
  min-width: 250px !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  box-shadow: 0 4px 15px rgba(0,0,0,0.03) !important;
  border: 1px solid #f0f0f0 !important;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease !important;
}

.faq__contact-info .text-with-icons__item:hover {
  transform: translateY(-5px) !important;
  box-shadow: 0 10px 25px rgba(0,0,0,0.06) !important;
  border-color: #1e73be !important;
}

.faq__contact-info .text-with-icons__icon-wrapper {
  color: #1e73be !important;
  background: #f0f7ff !important;
  width: 65px !important;
  height: 65px !important;
  border-radius: 50% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin-bottom: 20px !important;
  border: none !important;
}

.faq__contact-info .text-with-icons__icon-wrapper svg {
  width: 28px !important;
  height: 28px !important;
  stroke-width: 2px !important;
}

.faq__contact-info .text-with-icons__title {
  font-size: 18px !important;
  font-weight: 700 !important;
  color: #1a1a1a !important;
  margin-bottom: 10px !important;
}

.faq__contact-info .text-with-icons__content p {
  font-size: 15px !important;
  color: #666 !important;
  line-height: 1.5 !important;
  margin: 0 !important;
}

/* Mobile adjustments */
@media screen and (max-width: 768px) {
  .faq__group-title {
    font-size: 15px !important;
    margin: 8px 0 2px 0 !important;
  }
  .faq__question {
    font-size: 12px !important;
    padding: 2px 0 !important;
    line-height: 1 !important;
  }
  .faq__answer {
    padding: 0 0 8px 0 !important;
    font-size: 13px !important;
  }
  .faq__contact-info {
    padding: 35px 20px !important;
    margin-top: 40px !important;
  }
  .faq__contact-info .page__title {
    font-size: 26px !important;
  }
  .faq__contact-info .text-with-icons__item {
    width: 100% !important;
  }
  
  .mobile-faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 15px;
    background: #fff;
    border: 1px solid #eaeaea;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    color: #1a1a1a;
  }
  .mobile-faq-summary::-webkit-details-marker {
    display: none;
  }
  .mobile-faq-icon {
    font-size: 26px;
    font-weight: 400;
  }
  .mobile-faq-icon::before {
    content: '+';
  }
  .mobile-faq-wrapper[open] .mobile-faq-icon::before {
    content: '-';
  }
  .faq {
    margin-top: 15px;
  }
}
.mobile-faq-summary {
  display: none;
}
@media screen and (max-width: 768px) {
  .mobile-faq-summary {
    display: flex;
  }
}
.mobile-faq-summary {
  display: none;
}
@media screen and (max-width: 768px) {
  .mobile-faq-summary {
    display: flex;
  }
}
</style>

