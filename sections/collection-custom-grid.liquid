<style>
/* ================= LAYOUT ================= */
.collection-wrapper {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 30px;
  margin-top: 40px;
}

/* ================= TOOLBAR ================= */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.toolbar-left p {
  font-size: 14px;
  color: #555;
}

.toolbar-right {
  display: flex;
  align-items: center;
  gap: 15px;
}

.view-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
}

.view-toggle span {
  font-size: 13px;
  color: #000;
}

.view-toggle button {
  border: 1px solid #000;
  background: #fff;
  padding: 0px 8px;
  cursor: pointer;
  border-radius: 4px;
}

.view-toggle button.active {
  background: #000;
  color: #fff;
}

.toolbar select {
  padding: 6px 10px;
  border: 1px solid #000;
  border-radius: 4px;
}

.toolbar select option {
  color: #000;
}

/* ================= PRODUCT GRID ================= */
.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  align-items: stretch;
}

.product-card {
  background: #fff;
  border-radius: 4px;
  border: 1px solid #eaeaea;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow .18s ease, transform .18s ease;
}

.product-card:hover {
  box-shadow: 0 10px 28px rgba(16,24,40,.10);
  transform: translateY(-3px);
}

/* Image */
.product-card .image {
  position: relative;
  display: block;
  overflow: hidden;
  background: #f7f8f9;
}

.product-card img {
  width: 100%;
  height: 240px;
  object-fit: cover;
  display: block;
  transition: transform .35s ease;
}

.product-card:hover img {
  transform: scale(1.05);
}

/* Save badge */
.badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: #e40012;
  color: #fff;
  border-radius: 2px;
  padding: 4px 8px;
  display: flex;
  flex-direction: row;
  align-items: center;
  line-height: 1;
  z-index: 2;
}

.badge small {
  display: none;
}

.badge strong {
  font-size: 13px;
  font-weight: 800;
}

/* ================= NEW CARD FOOTER ELEMENTS ================= */
.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}
.vendor {
  font-size: 11px;
  color: #fff;
  background: #000;
  padding: 3px 6px;
  text-transform: uppercase;
  font-weight: 700;
}
.rating-wrapper {
  display: flex;
  align-items: center;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  margin-bottom: 12px;
}

.stock-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #1e2d7d;
  font-size: 15px;
  line-height: 1;
  font-weight: 400;
}
.stock-icon {
  display: inline-flex;
  width: 22px;
  height: 22px;
  align-items: center;
  justify-content: center;
  border-radius: 3px;
  background: #3fa33f;
}
.stock-icon svg {
  width: 14px;
  height: 14px;
}
.stock--out {
  color: #e40012;
}

/* Content */
.product-card .content {
  padding: 16px 18px 18px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.product-card .content h3 {
  margin: 0;
  font-family: Roboto, sans-serif;
  font-weight: 700;
  font-size: 14px;
  line-height: 1.4;
  color: #1e2d7d;
}

.product-card .content h3 a {
  color: inherit;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-transform: capitalize;
}

.product-card .content h3 a:hover {
  color: #e40012;
}

/* ================= REVIEW STARS ================= */
.vitals-collection-rating {
  min-height: 16px;
  margin: 0;
}

.card-rating {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin: 0;
  text-decoration: none;
}

.card-stars {
  font-size: 20px;
  line-height: 1;
  letter-spacing: 3px;
}

.card-stars::before {
  content: "★★★★★";
  background: linear-gradient(90deg, #ffb400 calc(var(--rating) / 5 * 100%), #d9d9d9 calc(var(--rating) / 5 * 100%));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.card-rating-count {
  font-size: 12px;
  color: #6b7280;
  font-weight: 500;
}

/* ================= PRICE ================= */
.price {
  margin-top: 6px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
}

.price--highlight {
  display: inline-flex;
  align-items: baseline;
  gap: 5px;
}

.product-card span.actual-price-value {
  font-family: Roboto, sans-serif;
  font-weight: 800;
  font-size: 26px;
  color: #055ba6;
  letter-spacing: -0.5px;
}

.product-card span.per-m-text {
  color: #777;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0;
}

.price--compare {
  display: flex;
  align-items: center;
  font-size: 13px;
  color: #777;
  margin-top: 2px;
}

.price--compare .rrp-strike {
  color: #888;
  margin-right: 8px;
}

.price--compare .save_amount {
  color: #108548;
  font-weight: 700;
  font-size: 14px;
}

/* ================= ACTIONS ================= */
.actions {
  display: flex;
  gap: 8px;
  margin-top: 0;
  padding-top: 0;
}

.actions .btn {
  flex: 1;
  margin: 0;
}

.btn {
  background: #016FD0;
  color: #fff;
  padding: 10px;
  display: block;
  text-align: center;
  border-radius: 2px;
  font-family: Roboto, sans-serif;
  font-weight: 700;
  font-size: 13.5px;
  border: 1.5px solid #016FD0;
  cursor: pointer;
}

.btn:hover {
  background: #015aa8;
  border-color: #015aa8;
}

.btn-sample {
  background: #fff;
  color: #016FD0;
  border: 1.5px solid #016FD0;
}

.btn-sample:hover {
  background: #016FD0;
  color: #fff;
}

/* ================= LIST VIEW ================= */
.product-grid.list-view {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.product-grid.list-view .product-card {
  flex-direction: row;
  align-items: stretch;
}

.product-grid.list-view .image {
  flex: 0 0 240px;
}

.product-grid.list-view .product-card img {
  height: 100%;
  min-height: 180px;
}

.product-grid.list-view .content {
  flex: 1;
}

.product-grid.list-view .actions {
  max-width: 360px;
}

/* ================= PAGINATION (no-JS fallback) ================= */
.custom-pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6px;
  margin-top: 30px;
  margin-bottom: 60px;
}

.page-number {
  min-width: 32px;
  height: 32px;
  border: 1px solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  border-radius: 4px;
  color: #333;
  text-decoration: none;
  background: #fff;
  transition: 0.2s;
}

.page-number:hover {
  border-color: #016FD0;
  color: #016FD0;
}

.page-number.active {
  background: #016FD0;
  color: #fff;
  border-color: #016FD0;
}

.page-arrow {
  min-width: 32px;
  height: 32px;
  border: 1px solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  text-decoration: none;
  color: #333;
}

.page-arrow:hover {
  border-color: #016FD0;
  color: #016FD0;
}

/* ================= LOAD MORE ================= */
.tp-loadmore-wrap {
  text-align: center;
  margin: 30px 0 60px;
}

.tp-loadmore {
  background: #fff;
  border: 1.5px solid #016FD0;
  color: #016FD0;
  font-family: Roboto, sans-serif;
  font-weight: 700;
  font-size: 15px;
  padding: 13px 40px;
  border-radius: 12px;
  cursor: pointer;
}

.tp-loadmore:hover {
  background: #016FD0;
  color: #fff;
}

.tp-loadmore[disabled] {
  opacity: .6;
  cursor: default;
}

/* ================= FILTERS ================= */
.filters {
  background: #fff;
  border-radius: 12px;
}

.filters h4 {
  font-size: 16px;
  margin-bottom: 10px;
}

.clear-filters {
  font-size: 13px;
  color: #016FD0;
  display: inline-block;
  margin-bottom: 15px;
}

.filter-group {
  border-top: 1px solid #eee;
  padding: 10px 0;
}

.filter-group summary {
  font-weight: 600;
  cursor: pointer;
  font-size: 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arrow {
  width: 6px;
  height: 6px;
  border-right: 2px solid #333;
  border-bottom: 2px solid #333;
  transform: rotate(45deg);
  transition: 0.3s;
}

.filter-group[open] .arrow {
  transform: rotate(-135deg);
}

.filter-options {
  margin-top: 10px;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px 10px;
}

.filter-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  cursor: pointer;
  position: relative;
}

.filter-item input[type="checkbox"] {
  position: absolute !important;
  left: -9999px !important;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

.color-swatch {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 1px solid #ccc;
  display: inline-block;
}

.filter-item input:checked + .color-swatch {
  border: 2px solid #000;
}

.label-text {
  flex: 1;
}

.count {
  font-size: 12px;
  color: #888;
}

/* ================= BOTTOM BUYING GUIDE ================= */
.collection__guide {
  max-width: 980px;
  margin: 40px auto 60px;
  padding-top: 30px;
  border-top: 1px solid #e6e8eb;
  font-family: Roboto, sans-serif;
}

.collection__guide h2 {
  font-family: Fraunces, serif;
  color: #016FD0;
  font-size: 26px;
  margin: 0 0 10px;
}

.collection__guide h3 {
  font-family: Fraunces, serif;
  color: #1a1d24;
  font-size: 18px;
  margin: 22px 0 7px;
}

.collection__guide p {
  color: #374151;
  font-size: 15px;
  line-height: 1.6;
  margin-bottom: 12px;
}

.collection__guide a {
  color: #016FD0;
  text-decoration: underline;
}

/* ================= RESPONSIVE ================= */
@media (max-width: 990px) {
  .collection-wrapper {
    grid-template-columns: 1fr;
  }

  .product-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .product-grid.list-view .product-card {
    flex-direction: column;
  }

  .product-grid.list-view .image {
    flex: none;
  }
}

@media (max-width: 560px) {
  .product-card .content h3 a {
    -webkit-line-clamp: 3;
  }
  .actions {
    flex-direction: column;
  }
}
</style>

<section class="collection-page page-width {{ section.settings.custom_class }}">

  <div class="collection-wrapper">

    <!-- Sidebar -->
    <aside class="filters">

      <!-- Mobile Filter Toggle -->
      <div class="mobile-filter-toggle">

        <span class="filter-toggle-text">
          Filter By
        </span>

        <div class="filter-btn-right">

          <a href="{{ collection.url }}" class="clear-filters-mobile">
            Clear all
          </a>

          <span class="filter-arrow"></span>

        </div>

      </div>

      <!-- Filter Content -->
      <div class="filters-wrapper">

        <div class="filter-header">
          <h4>Filter By</h4>

          <a href="{{ collection.url }}" class="clear-filters">
            Clear all
          </a>
        </div>

        <form method="get">

          {% for filter in collection.filters %}
            <details class="filter-group" {% if filter.active_values.size > 0 %}open{% endif %}>
              
              <summary>
                {{ filter.label }}
                <span class="arrow"></span>
              </summary>

              <div class="filter-options {% if filter.label == 'Colour' or filter.label == 'Color' %}color-grid{% endif %}">

                {% for value in filter.values %}
                  <label class="filter-item">

                    <input 
                      type="checkbox"
                      name="{{ filter.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      onchange="this.form.submit()"
                    >

                    {% if filter.label == 'Colour' or filter.label == 'Color' %}
                      <span 
                        class="color-swatch"
                        style="background-color: {{ value.label | downcase }}"
                      ></span>
                    {% endif %}

                    <span class="label-text">
                      {{ value.label }}
                    </span>

                    <span class="count">
                      ({{ value.count }})
                    </span>

                  </label>
                {% endfor %}

              </div>

            </details>
          {% endfor %}

        </form>

      </div>

    </aside>

    <!-- Products -->
    <div class="products">

      {% paginate collection.products by 20 %}

        <!-- Top bar -->
        <div class="toolbar">

          <!-- LEFT -->
          <div class="toolbar-left">
            <p>
              Showing {{ paginate.current_offset | plus: 1 }}–
              {{ paginate.current_offset | plus: paginate.items }}
              of {{ collection.all_products_count }} products
            </p>
          </div>

          <!-- RIGHT -->
          <div class="toolbar-right">

            <!-- View icons -->
            <div class="view-toggle">
              <span>View</span>

              <button type="button" class="grid-view active">▦</button>
              <button type="button" class="list-view">☰</button>
            </div>

            <!-- Sort -->
            <form method="get">
              <select name="sort_by" aria-label="Sort by" onchange="this.form.submit()">
                {% for option in collection.sort_options %}
                  <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                    {{ option.name }}
                  </option>
                {% endfor %}
              </select>
            </form>

          </div>

        </div>

        <!-- Grid -->
        <div class="product-grid" id="productGrid">
          {% for product in collection.products %}
{% assign outer_loop_index = forloop.index %}

            {% assign show_per_m2 = true %}
            {% for col in product.collections %}
              {% if col.title contains 'Adhesive'
                or col.title contains 'Underfloor Heating'
                or col.title contains 'Grout'
                or col.title contains 'Matting'
                or col.title contains 'Backerboards'
                or col.title contains 'Showers'
                or col.title contains 'LED Mirrors'
                or col.title contains 'Mirrors'
                or col.title contains 'Toilets'
                or col.title contains 'Radiators'
                or col.title == 'Stylish Radiators & Heated Towel Rails'
                or col.title contains 'Adhesives Checkout'
                or col.title contains 'Job Lot Deals'
                or col.title contains 'Wholesale Pallet Deals' %}
                {% assign show_per_m2 = false %}
                {% break %}
              {% endif %}
            {% endfor %}

            <div class="product-card">

              <a href="{{ product.url }}" class="image">
                {% if product.featured_image %}
                  {%- assign loading_attr = 'lazy' -%}
                  {%- assign fetchpriority_attr = 'auto' -%}
                  {%- if outer_loop_index <= 4 -%}
                    {%- assign loading_attr = 'eager' -%}
                    {%- assign fetchpriority_attr = 'high' -%}
                  {%- endif -%}
                  {{ product.featured_image | image_url: width: 600 | image_tag: class: 'primary-img', loading: loading_attr, fetchpriority: fetchpriority_attr, sizes: '(max-width: 768px) 50vw, 315px', widths: '315, 600' }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'primary-img' }}
                {% endif %}

                {% if product.images[1] %}
                  {{ product.images[1] | image_url: width: 600 | image_tag: class: 'secondary-img', loading: 'lazy', sizes: '(max-width: 768px) 50vw, 315px', widths: '315, 600' }}
                {% endif %}

                {% if product.compare_at_price > product.price %}
                  {% assign discount = product.compare_at_price | minus: product.price %}
                  {% assign percent = discount | times: 100.0 | divided_by: product.compare_at_price | round %}
                  <span class="badge">
                    <strong>SAVE {{ percent }}%</strong>
                  </span>
                {% endif %}
              </a>

              <div class="content">

                <div class="brand-row">
                  {%- if false -%}
                    <span class="vendor">{{ product.vendor }}</span>
                  {%- endif -%}
                  <div class="rating-wrapper">
                    {%- assign r = product.metafields.reviews.rating.value -%}
                    {%- assign rc = product.metafields.reviews.rating_count.value | default: 0 -%}
                    {% if rc > 0 and r %}
                      {%- assign rating = r.rating | round: 1 -%}
                      <a href="{{ product.url }}" class="card-rating" aria-label="Rated {{ rating }} out of 5 from {{ rc }} reviews">
                        <span class="card-stars" style="--rating: {{ rating }};"></span>
                        <span class="card-rating-count">({{ rc }})</span>
                      </a>
                    {% else %}
                      <div class="vitals-collection-rating" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}"></div>
                    {% endif %}
                  </div>
                </div>

                <h3>
                  <a href="{{ product.url }}" class="product-title-link">
                    {{ product.title }}
                  </a>
                </h3>

                <div class="price">
                  <div class="price--highlight">
                    <span class="current actual-price-value">
                      {%- if settings.currency_code_enabled -%}
                        {{- product.price | money_with_currency -}} 
                      {%- else -%}
                        {{- product.price | money -}}
                      {%- endif -%}
                    </span>
                    {% if show_per_m2 %}
                      <span class="per-m-text">Per m²</span>
                    {% endif %}
                  </div>

                  {% if product.compare_at_price > product.price %}
                    <div class="price--compare">
                      <span class="rrp-strike">
                        <s>
                        {%- if settings.currency_code_enabled -%}
                          {{- product.compare_at_price | money_with_currency -}} 
                        {%- else -%}
                          {{- product.compare_at_price | money -}}
                        {%- endif -%}
                        </s>
                      </span>
                      {% assign saving = product.compare_at_price | minus: product.price %}
                      <span class="save_amount">
                        Save 
                        {%- if settings.currency_code_enabled -%}
                          {{ saving | money_with_currency }}
                        {%- else -%}
                          {{ saving | money }}
                        {%- endif -%}
                      </span>
                    </div>
                  {% endif %}
                </div>

                <div class="card-footer">
                  {% if product.available %}
                    <span class="stock-status">
                      <span class="stock-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      </span>
                      In Stock
                    </span>
                  {% else %}
                    <span class="stock-status stock--out">
                      Out of Stock
                    </span>
                  {% endif %}
                </div>

                <div class="actions">
                  {% if product.metafields.custom.item_has_a_free_sample == true and product.metafields.custom.sample_product != blank %}
                    {% assign sample_prod = all_products[product.metafields.custom.sample_product] %}
                    {% if sample_prod.variants.first.id %}
                      <button type="button" class="btn btn-sample js-sample-add" data-variant-id="{{ sample_prod.variants.first.id }}">Order Sample</button>
                    {% endif %}
                  {% endif %}
                  <a href="{{ product.url }}" class="btn">Shop Now</a>
                </div>

              </div>

            </div>

          {% endfor %}
        </div>

        <!-- Pagination (becomes "Load more" via JS; numbered shown only if JS disabled) -->
        <div class="custom-pagination" {% if paginate.next %}data-next-url="{{ paginate.next.url }}"{% endif %}>

          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="page-arrow">‹</a>
          {% endif %}

          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="page-number">{{ part.title }}</a>
            {% else %}
              {% if part.title == paginate.current_page %}
                <span class="page-number active">{{ part.title }}</span>
              {% else %}
                <span class="page-number">{{ part.title }}</span>
              {% endif %}
            {% endif %}
          {% endfor %}

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="page-arrow">›</a>
          {% endif %}

        </div>

      {% endpaginate %}

    </div>

  </div>

  {%- comment -%} BOTTOM = the full collection description (long buying guide) for SEO / GEO / AI {%- endcomment -%}
  {% if collection.description != blank %}
    <div class="collection__guide rte">{{ collection.description }}</div>
  {% endif %}

</section>




{% schema %}
{
  "name": "Custom Collection Grid",
  "settings": [
        {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class",
    },
  ],
   "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Grid"
    }
  ]
}
{% endschema %}

<script>
document.addEventListener("DOMContentLoaded", function () {

  const gridBtn = document.querySelector(".grid-view");
  const listBtn = document.querySelector(".list-view");
  const grid = document.getElementById("productGrid");

  const savedView = localStorage.getItem("collectionView");

  if (savedView === "list") {
    grid.classList.add("list-view");
    listBtn.classList.add("active");
    gridBtn.classList.remove("active");
  }

  gridBtn.addEventListener("click", function () {
    grid.classList.remove("list-view");
    gridBtn.classList.add("active");
    listBtn.classList.remove("active");
    localStorage.setItem("collectionView", "grid");
  });

  listBtn.addEventListener("click", function () {
    grid.classList.add("list-view");
    listBtn.classList.add("active");
    gridBtn.classList.remove("active");
    localStorage.setItem("collectionView", "list");
  });

});

/* ================= ORDER SAMPLE (AJAX add to cart) ================= */
document.addEventListener("click", function (e) {
  var b = e.target.closest(".js-sample-add");
  if (!b) return;
  e.preventDefault();
  var id = b.getAttribute("data-variant-id");
  if (!id) return;
  var orig = b.textContent;
  b.disabled = true;
  b.textContent = "Adding…";
  fetch("/cart/add.js", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
  })
  .then(function (r) { return r.json(); })
  .then(function () { window.location.href = "/cart"; })
  .catch(function () {
    b.disabled = false;
    b.textContent = orig;
    alert("Sorry, we couldn't add that sample. Please try again.");
  });
});

/* ================= LOAD MORE ================= */
(function () {
  var grid = document.getElementById("productGrid");
  var pag = document.querySelector(".custom-pagination");
  if (!grid || !pag) return;

  var nextUrl = pag.getAttribute("data-next-url");
  if (!nextUrl) return;

  pag.style.display = "none";

  var wrap = document.createElement("div");
  wrap.className = "tp-loadmore-wrap";
  var btn = document.createElement("button");
  btn.type = "button";
  btn.className = "tp-loadmore";
  btn.textContent = "Load more";
  wrap.appendChild(btn);
  pag.parentNode.insertBefore(wrap, pag);

  btn.addEventListener("click", function () {
    btn.disabled = true;
    btn.textContent = "Loading…";
    fetch(nextUrl)
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, "text/html");
        var cards = doc.querySelectorAll("#productGrid .product-card");
        cards.forEach(function (c) { grid.appendChild(document.importNode(c, true)); });

        var newPag = doc.querySelector(".custom-pagination");
        nextUrl = newPag ? newPag.getAttribute("data-next-url") : null;

        if (nextUrl) {
          btn.disabled = false;
          btn.textContent = "Load more";
        } else {
          wrap.style.display = "none";
        }

        document.dispatchEvent(new CustomEvent("tp:products-appended"));
        if (window.Vitals && window.Vitals.reviews && window.Vitals.reviews.scan) {
          try { window.Vitals.reviews.scan(); } catch (e) {}
        }
      })
      .catch(function () {
        btn.disabled = false;
        btn.textContent = "Load more";
      });
  });
})();
</script>
