{% schema %}
{
  "name": "Custom Product",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
        {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ]
}
{% endschema %}
<section class="product-page page-width {{ section.settings.custom_class }}">

  <div class="product-wrapper">

    <!-- LEFT: IMAGES -->
    <div class="product-gallery">

      <div class="main-image">
        <img 
          id="mainProductImage"
          src="{{ product.featured_image | image_url: width: 800 }}"
        >
      </div>

      <!-- Thumbnails -->
        <div class="swiper thumb-slider">
        <div class="swiper-wrapper">

            {% for image in product.images %}
            <div class="swiper-slide">
                <img 
                src="{{ image | image_url: width: 150 }}"
                onclick="document.getElementById('mainProductImage').src='{{ image | image_url: width: 800 }}'"
                >
            </div>
            {% endfor %}

        </div>
        </div>

    </div>

 
     


    <!-- RIGHT: DETAILS -->
     <div class="product-info">
        <!-- Rating -->
        <div class="vtl-pr-badge" data-product-id="{{ product.id }}"></div>

        {% render 'custom-product-meta' %}

        {% render 'custom-product-variant-selector',
          product: product,
          block: section.blocks[0],
          section: section,
          form: form,
          hide_quantity_selector: true
        %}

        {% assign sale_by = product.metafields.custom.sale_by %}


        <!-- SAMPLE BUTTONS -->
        {% assign sample_product = product.metafields.custom.sample_product.value %}
        {% assign second_sample_product = product.metafields.custom.second_sample_product.value %}

        {% if sample_product or second_sample_product %}

        <div class="sample-buttons">

          {% if sample_product %}

            <a
              href="/cart/add?id={{ sample_product.selected_or_first_available_variant.id }}&quantity=1"
              class="sample-btn"
            >
              Cut Sample -
              {{ sample_product.price | money }}
            </a>

          {% endif %}

          {% if second_sample_product %}

            <a
              href="/cart/add?id={{ second_sample_product.selected_or_first_available_variant.id }}&quantity=1"
              class="sample-btn"
            >
              Large Sample -
              {{ second_sample_product.price | money }}
            </a>

          {% endif %}

        </div>

        {% endif %}




        <!-- Time Estimator / App Blocks -->
        {% for block in section.blocks %}

          {% case block.type %}

            {% when '@app' %}
              <div class="product-app-block">
                {% render block %}
              </div>

          {% endcase %}

        {% endfor %}
        <hr>
                <!-- Delivery -->
      <span class="delivery-text">
        <span class="delivery-text-main"></span>
      </span>
        <!-- Add to cart -->
          {% form 'product', product %}

            <input
              type="hidden"
              name="id"
              value="{{ product.selected_or_first_available_variant.id }}"
              class="product-variant-id"
            >
              <div class="payment-term-prod-section"> {{ form | payment_terms }} </div>
              
          <input type="number" name="quantity" value="1" min="1" style="display:none" id="real-quantity-input">
            <button
              type="submit"
              class="add-to-cart"
              {% unless product.available %}disabled{% endunless %}
            >

              {% if product.available %}
                Add to Basket
              {% else %}
                Sold Out
              {% endif %}

            </button>

          {% endform %}

        <!-- Payment icons -->
        <div class="payment-security">

        <h4>Payment & Security</h4>

        <!-- Payment Icons -->
        <div class="payment-icons">

          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}

        </div>

        <!-- Text -->
        <p>
            Your payment information is processed securely. We do not store credit card details nor have access to your credit card information.
        </p>

        </div>

    </div> 

  </div>

  <!-- TABS -->
  <div class="product-tabs">

    <button class="tab active" data-tab="desc">Description</button>
    <button class="tab" data-tab="details">Product Detail</button>
    {% comment %} <button class="tab" data-tab="reviews">Reviews</button> {% endcomment %}
    <button class="tab" data-tab="delivery">Delivery, Damage & Returns</button>

    <div class="tab-content active" id="desc">
      {{ product.description }}
    </div>
    <div class="tab-content" id="details">

      <div class="details-card">

        <h3>Product Details</h3>

        <div class="details-grid">

          {% if product.first_available_variant.sku != blank %}
          <div class="detail-row">
            <span>SKU</span>
            <strong>{{ product.first_available_variant.sku }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.tile_material != blank %}
          <div class="detail-row">
            <span>Material</span>
            <strong>
              {{ product.metafields.custom.tile_material | default: '—' }}
            </strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.tile_color != blank %}
          <div class="detail-row">
            <span>Colour</span>
            <strong>{{ product.metafields.custom.tile_color }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.thickness != blank %}
          <div class="detail-row">
            <span>Thickness</span>
            <strong>{{ product.metafields.custom.thickness }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.slip_rating != blank %}
          <div class="detail-row">
            <span>Anti-Slip Rating</span>
            <strong>{{ product.metafields.custom.slip_rating }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.tile_finish != blank %}
          <div class="detail-row">
            <span>Finish</span>
            <strong>{{ product.metafields.custom.tile_finish }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.floor_or_wall != blank %}
          <div class="detail-row">
            <span>Floor or Wall</span>
            <strong>{{ product.metafields.custom.floor_or_wall }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.size != blank %}
          <div class="detail-row">
            <span>Size</span>
            <strong>{{ product.metafields.custom.size }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.rectified != blank %}
          <div class="detail-row">
            <span>Rectified</span>
            <strong>{{ product.metafields.custom.rectified }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.suitable_for_underfloor_heating != blank %}
          <div class="detail-row">
            <span>Underfloor Heating</span>
            <strong>{{ product.metafields.custom.suitable_for_underfloor_heating }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.box_quantity != blank %}
          <div class="detail-row">
            <span>Box Quantity</span>
            <strong>{{ product.metafields.custom.box_quantity }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.weight != blank %}
          <div class="detail-row">
            <span>Weight</span>
            <strong>{{ product.metafields.custom.weight }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.pattern_repeats != blank %}
          <div class="detail-row">
            <span>Pattern Repeats</span>
            <strong>{{ product.metafields.custom.pattern_repeats }}</strong>
          </div>
          {% endif %}

          {% if product.metafields.custom.sale_by != blank %}
          <div class="detail-row">
            <span>Sale By</span>
            <strong>{{ product.metafields.custom.sale_by }}</strong>
          </div>
          {% endif %}

        </div>

      </div>

    </div>

    <div class="tab-content" id="reviews">

      

    </div>
    <div class="tab-content" id="delivery">

    <div class="delivery-card">

      <h3>🚚 Delivery, Damage & Returns</h3>

      <div class="delivery-item">
        <strong>🚛 Pallet Delivery (Tiles & SPC)</strong>
        <p>Delivered on a pallet (kerbside only). Driver cannot unpack or move goods inside.</p>
      </div>

      <div class="delivery-item">
        <strong>💥 Damage / Incorrect Delivery</strong>
        <p>Notify us within <b>2 working days</b>. Provide photos while items are still on pallet.</p>
        <p>Email: <a href="mailto:sales@tilesparadiseuk.com">sales@tilesparadiseuk.com</a></p>
      </div>

      <div class="delivery-item">
        <strong>✅ Check Before Installation</strong>
        <p>Inspect all tiles before cutting or installation.</p>
      </div>

      <div class="delivery-item">
        <strong>🔄 Returns</strong>
        <p>Returns allowed within 14 days. Must be unused & sealed.</p>
      </div>

    </div>

    </div>

  </div>

</section>
