<script>
document.querySelectorAll(".tab").forEach(btn => {
  btn.addEventListener("click", () => {

    document.querySelectorAll(".tab").forEach(b => b.classList.remove("active"));
    document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));

    btn.classList.add("active");
    document.getElementById(btn.dataset.tab).classList.add("active");

  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  const container = document.getElementById('bundle-product_reviews');
  if (!container) return;

  const MAX_WAIT = 4000;
  const start = Date.now();

  function hasReviews() {
    return document.querySelector('.vtl-pr-review, .vtl-pr-main-widget');
  }

  function check(final = false) {
    if (hasReviews()) {
      return; // show normally
    }

    if (final) {
      // Hide Reviews tab if empty
      const tabBtn = document.querySelector('[data-tab="reviews"]');
      const tabContent = document.getElementById('reviews');

      if (tabBtn) tabBtn.style.display = 'none';
      if (tabContent) tabContent.style.display = 'none';
    }
  }

  const observer = new MutationObserver(() => {
    check(false);
    if (Date.now() - start > MAX_WAIT) check(true);
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

  setTimeout(() => check(true), MAX_WAIT);
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  function addBusinessDays(date, days) {
    let result = new Date(date);
    let added = 0;

    while (added < days) {
      result.setDate(result.getDate() + 1);
      if (result.getDay() !== 0) added++; // skip Sunday
    }

    return result;
  }

  function formatDate(date) {
    return date.toLocaleDateString('en-GB', {
      weekday: 'long',
      month: 'long',
      day: 'numeric'
    });
  }

  function updateDelivery() {
    const now = new Date();

    let startDays = 2;
    let endDays = 3;

    if (now.getHours() >= 14) {
      startDays = 3;
      endDays = 4;
    }

    const start = addBusinessDays(now, startDays);
    const end = addBusinessDays(now, endDays);

    const text = `<strong>Get it Between </strong>${formatDate(start)} and ${formatDate(end)}.`;

    const el = document.querySelector(".delivery-text-main");
    if (el) el.innerHTML = text;
  }

  function updateCountdown() {
    const now = new Date();
    const cutoff = new Date();

    cutoff.setHours(14, 0, 0, 0);

    if (now > cutoff) {
      cutoff.setDate(cutoff.getDate() + 1);
    }

    const diff = cutoff - now;

    const hours = Math.floor(diff / (1000 * 60 * 60));

    const el = document.querySelector(".delivery-text-main");
    if (el && !el.innerText.includes("Order in")) {
      el.innerHTML += ` Order in ${hours} hour${hours !== 1 ? 's' : ''}`;
    }
  }

  updateDelivery();
  updateCountdown();

});
</script>

<script>
  
document.addEventListener("DOMContentLoaded", function () {

  const realQtyInput = document.getElementById("real-quantity-input");
  if (!realQtyInput) return;

  const sqmInput    = document.getElementById("sqmInput");
  const boxInput    = document.getElementById("boxQuantityDisplay");
  const tileEl      = document.querySelector(".tile_nu");
  const actualPrice = document.getElementById("actualPrice");

  /*
  ============================================
  CLEAN NUMBER
  ============================================
  */

  function extractNumber(value) {

    if (!value) return 0;

    value = String(value)
      .replace(",", ".")
      .replace(/[^\d.]/g, "")
      .trim();

    return parseFloat(value) || 0;
  }

  /*
  ============================================
  PRODUCT DATA
  ============================================
  */

  const tileSizeText =
    `{{ product.metafields.custom.size.value | default: '' }}`;

  const tilesPerSq =
    extractNumber(
      `{{ product.metafields.custom.tiles_per_sq.value | default: '' }}`
    );

  const tilesPerBox =
    extractNumber(
      `{{ product.metafields.custom.box_quantity.value | default: '' }}`
    );

  /*
  ============================================
  CALCULATE COVERAGE
  ============================================
  */

  let coveragePerBox = 1;

  /*
  --------------------------------------------
  METHOD 1:
  Tile Size + Box Qty
  --------------------------------------------
  */

  /*
  --------------------------------------------
  METHOD 1:
  Tile Size in MM + Box Qty
  --------------------------------------------
  */

  if (
    tileSizeText.toLowerCase().includes("x") &&
    tileSizeText.toLowerCase().includes("mm")
  ) {

    const parts =
      tileSizeText.toLowerCase().split("x");

    const width =
      extractNumber(parts[0]);

    const height =
      extractNumber(parts[1]);

    if (width && height && tilesPerBox) {

      coveragePerBox =
        ((width * height * tilesPerBox) / 1000000);

    }

  }

  /*
  --------------------------------------------
  METHOD 2:
  Tiles Per Sq + Box Qty
  --------------------------------------------
  */

  else if (tilesPerSq && tilesPerBox) {

    coveragePerBox =
      (tilesPerSq * tilesPerBox);

  }


  /*
  ============================================
  FINAL COVERAGE
  ============================================
  */

  coveragePerBox =
    parseFloat(coveragePerBox.toFixed(2));

  console.log("coveragePerBox:", coveragePerBox);

  /*
  ============================================
  PRICE
  ============================================
  */

  const unitPrice =
    {{ product.price | divided_by: 100.0 }};

  console.log("unitPrice:", unitPrice);

  /*
  ============================================
  UPDATE CALCULATOR
  ============================================
  */

  function updateCalculator(boxes, manualSqm = null) {

    boxes = Math.max(1, Math.ceil(boxes));

    const sqm = boxes * coveragePerBox;

    const totalTiles =
      boxes * tilesPerBox;

    // quantity sent to Shopify = whole m² (your price is per m²)
    const chargeQty = Math.max(1, Math.round(sqm));

    const totalPrice =
      chargeQty * unitPrice;

    /*
    ============================================
    SHOPIFY QUANTITY
    ============================================
    */

    realQtyInput.value = chargeQty;

    realQtyInput.dispatchEvent(
      new Event("change", { bubbles: true })
    );

    /*
    ============================================
    UPDATE INPUTS
    ============================================
    */

    if (document.activeElement !== sqmInput) {

      sqmInput.value =
        parseFloat(sqm).toFixed(2);

    }

    if (document.activeElement !== boxInput) {

      boxInput.value = boxes;

    }

    /*
    ============================================
    UPDATE TILES
    ============================================
    */

    if (tileEl) {

      tileEl.textContent = totalTiles;

    }

    /*
    ============================================
    UPDATE PRICE
    ============================================
    */

    if (actualPrice) {

      const safePrice =
        isNaN(totalPrice) ? 0 : totalPrice;

      actualPrice.textContent =
        safePrice.toFixed(2);

    }

    /*
    ============================================
    COVERAGE TEXT
    ============================================
    */

    const coverageText =
      document.getElementById("coverageText");

    if (coverageText) {

      coverageText.innerHTML =
        `1 box will cover ${coveragePerBox} m²`;

    }

  }

  /*
  ============================================
  LIVE INPUT HANDLING
  ============================================
  */

  let sqmTimeout;
  let boxTimeout;

  /*
  ============================================
  SQM INPUT
  ============================================
  */

  sqmInput.addEventListener("input", function () {

    clearTimeout(sqmTimeout);

    sqmTimeout = setTimeout(() => {

      let sqm =
        Number(this.value);

      if (isNaN(sqm) || sqm <= 0) {

        sqm = coveragePerBox;

      }

      const boxes =
        Math.ceil(sqm / coveragePerBox);

      updateCalculator(boxes, sqm);

    }, 300);

  });

  /*
  ============================================
  BOX INPUT
  ============================================
  */

  boxInput.addEventListener("input", function () {

    clearTimeout(boxTimeout);

    boxTimeout = setTimeout(() => {

      let boxes =
        Number(this.value);

      if (isNaN(boxes) || boxes <= 0) {

        boxes = 1;

      }

      updateCalculator(boxes);

    }, 300);

  });

  /*
  ============================================
  INITIAL LOAD
  ============================================
  */

  updateCalculator(1);

});
</script>

