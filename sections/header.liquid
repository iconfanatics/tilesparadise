{%- capture section_settings -%}
{
  "navigationLayout": {{ section.settings.desktop_navigation_layout | json }},
  "desktopOpenTrigger": {{ section.settings.desktop_navigation_open_trigger | json }},
  "useStickyHeader": {{ section.settings.enable_sticky_header | json }}
}
{%- endcapture -%}

{%- assign navigation_menu_handle = section.settings.navigation_menu | default: 'main-menu' -%}
{%- assign navigation_menu = linklists[navigation_menu_handle] -%}

{%- assign navigation_mobile_menu_handle = section.settings.navigation_mobile_menu | default: navigation_menu_handle -%}
{%- assign navigation_mobile_menu = linklists[navigation_mobile_menu_handle] -%}

<section data-section-id="{{ section.id }}" data-section-type="header" data-section-settings='{{ section_settings }}'>
  <header class="header header--{{ section.settings.desktop_navigation_layout }} {% unless section.settings.show_condensed_search %}header--search-expanded{% endunless %}" role="banner">
    <div class="container">
 
      <div class="header__inner">
        {%- comment -%}
        --------------------------------------------------------------------------------------
        MOBILE NAV
        --------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- if navigation_menu.links.size > 0 -%}
          <div class="header__mobile-nav hidden-lap-and-up">
            <button class="header__mobile-nav-toggle icon-state touch-area" aria-expanded="false" aria-haspopup="true" aria-controls="mobile-menu" aria-label="{{ 'header.navigation.open_menu' | t }}">
              <span class="icon-state__primary">{%- render 'icon', icon: 'hamburger-mobile' -%}</span>
              <span class="icon-state__secondary">{%- render 'icon', icon: 'close' -%}</span>
            </button>

            {%- render 'mobile-menu', menu: navigation_mobile_menu -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          --------------------------------------------------------------------------------------
          DESKTOP NAV
          --------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- if section.settings.desktop_navigation_layout == 'condensed' and navigation_menu.links.size > 0 -%}
          <nav class="header__desktop-nav hidden-pocket">
            <button class="header__desktop-nav-toggle" data-action="toggle-menu" aria-expanded="false" aria-haspopup="true" aria-label="{{ 'header.navigation.open_menu' | t }}">
              <span>{%- render 'icon', icon: 'hamburger' -%} <span class="header__desktop-nav-text">{{- 'header.navigation.menu' | t -}}</span></span>
            </button>

            {%- render 'desktop-menu', menu: navigation_menu, index: 'desktop-menu-0' -%}
          </nav>
        {%- endif -%}

        {%- comment -%}
        --------------------------------------------------------------------------------------
        LOGO COMPONENT
        --------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- capture header_logo -%}
          <a href="{{ routes.root_url }}" class="header__logo-link">
            {%- if section.settings.logo != blank -%}
              {%- capture image_size -%}{{ section.settings.logo_max_width }}x{%- endcapture -%}
              <span class="visually-hidden">{{ shop.name }}</span>
              <img class="header__logo-image"
                   style="max-width: {{ section.settings.logo_max_width }}px"
                   width="{{ section.settings.logo.width }}"
                   height="{{ section.settings.logo.height }}"
                   src="{{ section.settings.logo | img_url: image_size, scale: 2 }}"
                   alt="{{ section.settings.logo.alt | default: shop.name | escape }}">
            {%- else -%}
              <span class="header__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        {%- endcapture -%}


        <div class="header__logo">
          {{ header_logo }}
        </div>
          <div class="header-inner-search-and-action">
        {%- comment -%}
        --------------------------------------------------------------------------------------
        SEARCH COMPONENT
        --------------------------------------------------------------------------------------
        {%- endcomment -%}

        <div class="header__search-bar-wrapper {% unless section.settings.show_condensed_search %}is-visible{% endunless %}">
          <form action="{{ routes.search_url }}" method="get" role="search" class="search-bar">
            {%- assign search_menu = linklists[section.settings.search_menu] -%}

            <div class="search-bar__top-wrapper">
              <div class="search-bar__top">
                <input type="hidden" name="type" value="product">

                <div class="search-bar__input-wrapper">
                  <input class="search-bar__input" type="text" name="q" autocomplete="off" autocorrect="off" aria-label="{{ 'header.search.input_placeholder' | t }}" placeholder="{{ 'header.search.input_placeholder' | t }}">
                  <button type="button" class="search-bar__input-clear hidden-lap-and-up" data-action="clear-input">
                    <span class="visually-hidden">{{ 'header.search.clear' | t }}</span>
                    {% render 'icon', icon: 'close' %}
                  </button>
                </div>

                {%- comment -%}The type detection is sometimes a bit inaccurate as it returns empty type, so we do an additional logic{%- endcomment -%}

                {%- assign has_at_least_one_type = false -%}
                {%- for product_type in shop.types -%}
                  {%- if product_type != blank -%}
                    {%- assign has_at_least_one_type = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if section.settings.show_search_filter and has_at_least_one_type -%}
                  <div class="search-bar__filter">
                    <label for="search-product-type" class="search-bar__filter-label">
                      <span class="search-bar__filter-active">{{ 'header.search.all_categories' | t }}</span> {%- render 'icon', icon: 'arrow-bottom' -%}
                    </label>

                    <select id="search-product-type">
                      <option value="" selected="selected">{{ 'header.search.all_categories' | t }}</option>

                      {%- for product_type in shop.types -%}
                        {%- if product_type != blank -%}
                          <option value="{{ product_type | escape }}">{{ product_type | escape }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endif -%}

                <button type="submit" class="search-bar__submit" aria-label="{{ 'header.search.submit' | t }}">
                  {%- render 'icon', icon: 'search' -%}
                  {%- render 'icon', icon: 'search-loader' -%}
                </button>
              </div>

              <button type="button" class="search-bar__close-button hidden-tablet-and-up" data-action="unfix-search">
                <span class="search-bar__close-text">{{ 'header.search.close_search' | t }}</span>
              </button>
            </div>

            <div class="search-bar__inner">
              <div class="search-bar__results" aria-hidden="true">
                <div class="skeleton-container">
                  {%- for i in (1..3) -%}
                    <div class="search-bar__result-item search-bar__result-item--skeleton">
                      <div class="search-bar__image-container">
                        <div class="aspect-ratio aspect-ratio--square">
                          <div class="skeleton-image"></div>
                        </div>
                      </div>

                      <div class="search-bar__item-info">
                        <div class="skeleton-paragraph">
                          <div class="skeleton-text"></div>
                          <div class="skeleton-text"></div>
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}
                </div>

                <div class="search-bar__results-inner">
                  {%- comment -%}Placeholder div for real results{%- endcomment -%}
                </div>
              </div>

              {%- if search_menu.links.size > 0 -%}
                <div class="search-bar__menu-wrapper" aria-hidden="true">
                  {%- if section.settings.show_search_menu_title -%}
                    <p class="search-bar__menu-title heading">{{ search_menu.title }}</p>
                  {%- endif -%}

                  <ul class="search-bar__menu-linklist list--unstyled" role="list">
                    {%- for link in search_menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="search-bar__menu-link">{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>
          </form>
        </div>


        {%- comment -%}
        --------------------------------------------------------------------------------------
        HEADER ACTIONS
        --------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
          {%- assign country_selector = true -%}
        {%- endif -%}

        {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
          {%- assign locale_selector = true -%}
        {%- endif -%}

        <div class="header__action-list custom-header-final">

          <!-- PHONE -->
          {% if section.settings.show_mobile_contact %}
            <div class="ch-item ch-phone">

              {% if section.settings.mobile_icon != blank %}
                <img 
                  src="{{ section.settings.mobile_icon | image_url: width: 40 }}" 
                  alt="Phone"
                >
              {% endif %}

              <div class="ch-text">
                <a href="tel:{{ section.settings.mobile_phone | remove: ' ' }}" class="ch-title">
                  {{ section.settings.mobile_phone }}
                </a>
                <span class="ch-sub">{{ section.settings.mobile_timing }}</span>
              </div>
            </div>
          {% endif %}

          <!-- SEARCH -->
          <div class="ch-item">
            <button
              type="button"
              class="header__search-button">
              {% render 'icon', icon: 'search' %}
            </button>
          </div>

          <!-- ACCOUNT -->
          <div class="ch-item">
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="ch-link">
              
              {% comment %} {% render 'icon', icon: 'account' %} {% endcomment %}
               <img src="{{ 'account.png' | file_url }}" alt="Account" width="24" height="24">

              <div class="ch-text">
                <span class="ch-title">Account</span>
                <span class="ch-sub">
                  {% if customer %}
                    {{ customer.first_name }}
                  {% else %}
                    Sign In
                  {% endif %}
                </span>
              </div>
            </a>
          </div>

          <!-- WISHLIST -->
          <div class="ch-item ch-item-heart">
            <a href="/pages/wishlist" class="ch-link">
              {% comment %} {% render 'icon', icon: 'heart' %} {% endcomment %}
               <img src="{{ 'wishlist.png' | file_url }}" alt="wishlist" width="24" height="24">
              <div class="ch-text">
                <span class="ch-title">Wishlist</span>
              </div>
            </a>
          </div>

          <!-- CART -->
          <div class="ch-item ch-item-cart">
            <a href="{{ routes.cart_url }}" class="ch-link header__cart-toggle" 
              {% if settings.cart_type != 'page' %}data-action="toggle-mini-cart"{% endif %}>
              
              <div class="ch-icon-cart">
                {% comment %} {% render 'icon', icon: 'cart' %} {% endcomment %}
               <img src="{{ 'cart.png' | file_url }}" alt="cart" width="24" height="24">

                <span class="ch-cart-count">{{ cart.item_count }}</span>
              </div>

              <div class="ch-text">
                <span class="ch-title">Basket</span>
              </div>
            </a>
          </div>

        </div>
        </div>
      </div>
    </div>
  </header>

  {%- if section.settings.desktop_navigation_layout == 'inline' and navigation_menu.links.size > 0 -%}
    <nav class="nav-bar tabbed-mega-nav" aria-label="{{ 'header.navigation.menu' | t }}">
      <div class="tabbed-mega-nav__outer">
        <div class="container tabbed-mega-nav__container">
          <ul class="tabbed-mega-nav__tabs list--unstyled" role="list">
            {%- for link in navigation_menu.links -%}
              {%- assign top_title_downcase = link.title | downcase | strip -%}
              {%- assign menu_promo_block = blank -%}

              {%- for block in section.blocks -%}
                {%- assign block_menu_item_downcase = block.settings.menu_item | downcase | strip -%}
                {%- if block_menu_item_downcase == top_title_downcase -%}
                  {%- assign menu_promo_block = block -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              <li class="tabbed-mega-nav__tab-item {% if link.links.size > 0 %}has-children{% endif %}">
                <a href="{{ link.url }}" class="tabbed-mega-nav__tab">
                  <span>{{ link.title }}</span>
                  {%- if link.links.size > 0 -%}
                    {%- render 'icon', icon: 'arrow-bottom' -%}
                  {%- endif -%}
                </a>

                {%- if link.links.size > 0 -%}
                  <div class="tabbed-mega-nav__flyout">
                    <div class="tabbed-mega-nav__secondary-wrap">
                      <ul class="tabbed-mega-nav__secondary-list list--unstyled" role="list">
                        {%- for child_link in link.links -%}
                          {%- assign child_title_downcase = child_link.title | downcase | strip -%}
                          
                          {%- assign child_promo_block = menu_promo_block -%}
                          {%- for block in section.blocks -%}
                            {%- assign block_menu_item_downcase = block.settings.menu_item | downcase | strip -%}
                            {%- if block_menu_item_downcase == child_title_downcase -%}
                              {%- assign child_promo_block = block -%}
                              {%- break -%}
                            {%- endif -%}
                          {%- endfor -%}

                          <li class="tabbed-mega-nav__secondary-item {% if child_link.links.size > 0 %}has-panel{% endif %} {% if child_title_downcase == 'offers' %}is-offers{% endif %}">
                            <a href="{{ child_link.url }}" class="tabbed-mega-nav__secondary-link">
                              {{ child_link.title }}
                            </a>

                            {%- if child_link.links.size > 0 -%}
                              <div class="tabbed-mega-nav__panel">
                                <div class="tabbed-mega-nav__panel-inner {% if child_promo_block != blank and child_promo_block.settings.image_1 != blank %}has-promo{% endif %}">
                                  <div class="tabbed-mega-nav__columns">
                                    <div class="tabbed-mega-nav__column">
                                      <a href="{{ child_link.url }}" class="tabbed-mega-nav__column-title">
                                        {{ child_link.title }}
                                      </a>
                                      <ul class="tabbed-mega-nav__link-grid list--unstyled" role="list">
                                        {%- for grandchild_link in child_link.links -%}
                                          <li>
                                            <a href="{{ grandchild_link.url }}" class="tabbed-mega-nav__panel-link">
                                              {{ grandchild_link.title }}
                                            </a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    </div>
                                  </div>

                                  {%- if child_promo_block != blank and child_promo_block.settings.image_1 != blank -%}
                                    <a href="{{ child_promo_block.settings.image_1_link | default: link.url }}" class="tabbed-mega-nav__promo">
                                      {{ child_promo_block.settings.image_1 | image_url: width: 520 | image_tag: loading: 'lazy', sizes: '292px', widths: '292,420,520', alt: child_promo_block.settings.image_1_heading }}
                                      {%- if child_promo_block.settings.image_1_heading != blank or child_promo_block.settings.image_1_text != blank -%}
                                        <span class="tabbed-mega-nav__promo-copy">
                                          {%- if child_promo_block.settings.image_1_heading != blank -%}
                                            <strong>{{ child_promo_block.settings.image_1_heading }}</strong>
                                          {%- endif -%}
                                          {%- if child_promo_block.settings.image_1_text != blank -%}
                                            <small>{{ child_promo_block.settings.image_1_text }}</small>
                                          {%- endif -%}
                                        </span>
                                      {%- endif -%}
                                    </a>
                                  {%- endif -%}
                                </div>
                              </div>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </nav>
  {%- endif -%}
</section>

<style>
  :root {
    --header-is-sticky: {% if section.settings.enable_sticky_header %}1{% else %}0{% endif %};
    --header-inline-navigation: {% if section.settings.desktop_navigation_layout == 'inline' %}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 5;


  }

  {%- if section.settings.logo -%}
    .header__logo-image {
      max-width: {{ section.settings.mobile_logo_max_width }}px !important;
    }

    @media screen and (min-width: 641px) {
      .header__logo-image {
        max-width: {{ section.settings.logo_max_width }}px !important;
      }
    }
  {%- endif -%}

  {%- if settings.header_background == settings.secondary_background -%}
    .search-bar__top {
      box-shadow: 1px 1px var(--header-border-color) inset, -1px -1px var(--header-border-color) inset;
    }

    @media screen and (min-width: 1000px) {
      /* This allows to reduce the padding if header background is the same as secondary background to avoid space that is too big */
      .header:not(.header--condensed) {
        padding-bottom: 0;
      }
    }
  {%- else -%}
    @media screen and (min-width: 1000px) {
      .search-bar.is-expanded .search-bar__top {
        box-shadow: 0 -1px var(--border-color) inset;
      }
    }
  {%- endif -%}

  .mobile-number-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  border-left: 1px solid #e5e5e5;
}

/* ICON */
.mobile-number-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mobile-number-icon img {
  width: 18px;
  height: 18px;
  object-fit: contain;
}

/* TEXT BLOCK */
.mobile-number-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

/* PHONE NUMBER */
.mobile-number {
  font-size: 13px;
  font-weight: 600;
  color: #000;
}

/* TIMING */
.mobile-timing {
  font-size: 11px;
  color: #666;
}

.custom-header-actions {
  display: flex;
  align-items: center;
}

/* EACH ITEM */
.custom-header-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 16px;
  position: relative;
}

/* VERTICAL DIVIDER */
.custom-header-item:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 24px;
  width: 1px;
  background: #e5e5e5;
}

/* ICON */
.custom-icon svg {
  width: 18px;
  height: 18px;
}

/* TEXT BLOCK */
.custom-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

/* MAIN LABEL */
.custom-text .title {
  font-size: 13px;
  font-weight: 500;
  color: #000;
}

/* SUB TEXT */
.custom-text .sub {
  font-size: 11px;
  color: #777;
}

.custom-header-final {
  display: flex;
  align-items: center;
}

/* ITEM */
.ch-item {
  display: flex;
  align-items: center;
  padding: 0 18px;
  position: relative;
}

/* DIVIDER */
.ch-item:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 26px;
  width: 1px;
  background: #e5e5e5;
}

/* LINK */
.ch-link {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: inherit;
}

/* ICON */
.ch-link svg {
  width: 18px;
  height: 18px;
}

/* TEXT */
.ch-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

/* TITLE */
.ch-title {
  font-size: 13px;
  font-weight: 500;
  color: #000;
}

/* SUBTEXT */
.ch-sub {
  font-size: 11px;
  color: #777;
}

/* PHONE */
.ch-phone img {
  width: 18px;
  height: 18px;
  margin-right: 6px;
}

/* CART COUNT */
.ch-icon-cart {
  position: relative;
}

.ch-cart-count {
  position: absolute;
  top: -6px;
  right: -8px;
  background: #000;
  color: #fff;
  font-size: 10px;
  border-radius: 50%;
  padding: 2px 5px;
}

.header__search-button{
display:none;
}

/* MOBILE HEADER */
@media (max-width:767px){
.header__search-button{
display:block;
}
.header-inner-search-and-action{
      margin-left: auto;
      width: auto !important;
      gap: 0 !important;
      justify-content: flex-end !important;
      flex: 1;
  }

  .custom-header-final{
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
  }
  } /* Close max-width:767px */

  @media screen and (max-width: 999px) {
  /* Ensure hamburger menu is clickable */
  .header__mobile-nav,
  .header__mobile-nav-toggle {
      position: relative;
      z-index: 99999999 !important; /* 8 nines to sit above the menu overlay */
  }

    /* Mobile Menu Drawer Fallback CSS (Since it's missing from theme.css) */
    .mobile-menu {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        max-height: 100vh !important;
        z-index: 9999999 !important;
        visibility: hidden;
        pointer-events: none;
        transition: visibility 0.4s linear;
        background: rgba(0, 0, 0, 0.5); /* Overlay */
    }
    .mobile-menu[aria-hidden="false"] {
        visibility: visible !important;
        pointer-events: auto !important;
    }
    .mobile-menu__inner {
        position: absolute !important;
        top: 0 !important;
        left: 0 !important;
        width: 85vw !important;
        max-width: 380px !important;
        height: 100% !important;
        background: #ffffff !important; /* Drawer background */
        transform: translateX(-100%) !important;
        transition: transform 0.4s cubic-bezier(0.18, 1.25, 0.4, 1) !important;
        overflow-y: auto !important;
        box-shadow: 2px 0 10px rgba(0,0,0,0.1) !important;
    }
    .mobile-menu[aria-hidden="false"] .mobile-menu__inner {
        transform: translateX(0) !important;
    }
    
    /* Mobile Tabs Layout Fix */
    .tabbed-mega-nav {
        display: block !important; /* Force show on mobile on all pages, overriding hidden-pocket */
        padding-bottom: 45px !important; /* Space for the visible flyout menu */
        background: transparent !important;
    }
    .tabbed-mega-nav__outer {
        background: transparent !important;
    }
    .tabbed-mega-nav__tabs {
        display: flex !important;
        width: 100% !important; /* Force full width */
        justify-content: space-between !important;
        overflow-x: visible !important;
        flex-wrap: nowrap !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        gap: 0 !important;
        border-bottom: 4px solid var(--tabbed-menu-active) !important; /* Beautiful anchor base */
    }
    
    /* Hide "All" tab completely on mobile */
    .tabbed-mega-nav__tab-item:first-child {
        display: none !important;
    }
    
    /* Make the 2nd child (Bathroom) flyout visible by default */
    .tabbed-mega-nav__tab-item:nth-child(2) .tabbed-mega-nav__flyout {
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        left: 0 !important;
        width: 100% !important;
    }
    
    /* Make the 2nd child tab look active */
    .tabbed-mega-nav__tab-item:nth-child(2) .tabbed-mega-nav__tab {
        background: var(--tabbed-menu-active) !important;
    }

    /* Remaining tabs styling */
    .tabbed-mega-nav__tab-item {
        position: static !important; /* So flyout can span full screen width */
        flex: 1 !important; /* Grow to fill available space */
        width: 100% !important; /* Force them to stretch */
        max-width: none !important; /* CRITICAL: Override the max-width: 20% from custom.css */
        margin-right: 2px !important; /* 2px separator so tabs don't blend into one giant brick */
        border-radius: 8px 8px 0 0 !important;
        overflow: hidden !important;
    }
    .tabbed-mega-nav__tab-item:last-child {
        margin-right: 0 !important;
    }
    .tabbed-mega-nav__tab {
        width: 100% !important;
        height: 54px !important;
        padding: 0 2px !important; 
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
    }
    .tabbed-mega-nav__tab span {
        font-size: 15px !important; 
        width: 100% !important;
