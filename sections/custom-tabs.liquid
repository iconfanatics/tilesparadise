<section class="custom-tabs-section" style="background-color: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width container">

    <!-- DESKTOP TABS — Pure CSS, no JavaScript needed -->
    <div class="css-tabs-wrapper">
      {% for block in section.blocks %}
        <input type="radio" name="tabs-{{ section.id }}" id="tab-{{ section.id }}-{{ forloop.index0 }}" class="css-tab-radio" {% if forloop.first %}checked{% endif %}>
      {% endfor %}

      <div class="css-tabs-header">
        {% for block in section.blocks %}
          <label for="tab-{{ section.id }}-{{ forloop.index0 }}" class="css-tab-label">
            {{ block.settings.title }}
          </label>
        {% endfor %}
      </div>

      <div class="css-tabs-content-container">
        {% for block in section.blocks %}
          <div class="css-tab-content" id="content-{{ section.id }}-{{ forloop.index0 }}">
            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading }}</h3>
            {% endif %}
            <div class="css-tab-text">
              {{ block.settings.content }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- MOBILE ACCORDION -->
    <div class="custom-accordion-wrapper">
      {% for block in section.blocks %}
        <details class="custom-accordion-item" {{ block.shopify_attributes }}>
          <summary class="custom-accordion-header">
            <span class="custom-accordion-title">{{ block.settings.title }}</span>
            <span class="custom-accordion-icon"></span>
          </summary>
          <div class="custom-accordion-content-wrapper">
            <div class="custom-accordion-content">
              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading }}</h3>
              {% endif %}
              <div class="custom-accordion-text">
                {{ block.settings.content }}
              </div>
            </div>
          </div>
        </details>
      {% endfor %}
    </div>

  </div>
</section>

<style>
/* ===================== RESPONSIVE TOGGLES ===================== */
.css-tabs-wrapper { display: block; }
.custom-accordion-wrapper { display: none; }

@media (max-width: 768px) {
  .css-tabs-wrapper { display: none; }
  .custom-accordion-wrapper { display: block; }
}

/* ===================== DESKTOP TABS (Pure CSS) ===================== */
/* Hide the radio inputs visually */
.css-tab-radio {
  display: none;
}

.css-tabs-wrapper {
  max-width: 1200px;
  margin: 0 auto;
}

/* Tab Header */
.css-tabs-header {
  display: flex;
  justify-content: space-between;
  border-bottom: 2px solid #eaeaea;
  margin-bottom: 30px;
}

/* Tab Labels (clickable like buttons) */
.css-tab-label {
  flex: 1;
  padding: 15px 10px;
  font-size: 16px;
  font-weight: 700;
  color: #666;
  cursor: pointer;
  text-align: center;
  position: relative;
  transition: color 0.3s ease;
  font-family: inherit;
  display: block;
}

.css-tab-label:hover {
  color: #333;
}

/* Tab Content — hidden by default */
.css-tab-content {
  display: none;
  animation: fadeInTabs 0.4s ease;
}

.css-tab-content h3 {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 20px;
  text-align: center;
  color: #1a1a1a;
}

.css-tab-text {
  font-size: 15px;
  line-height: 1.6;
  color: #444;
  text-align: left;
}

.css-tab-text p { margin-bottom: 15px; }
.css-tab-text p:last-child { margin-bottom: 0; }

/* === MAGIC: CSS sibling selectors to show active tab === */
/* For up to 20 tabs — covers all cases */
{% for block in section.blocks %}
  #tab-{{ section.id }}-{{ forloop.index0 }}:checked ~ .css-tabs-header .css-tab-label:nth-child({{ forloop.index }}) {
    color: {{ section.settings.active_color }};
  }
  #tab-{{ section.id }}-{{ forloop.index0 }}:checked ~ .css-tabs-header .css-tab-label:nth-child({{ forloop.index }})::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: {{ section.settings.active_color }};
  }
  #tab-{{ section.id }}-{{ forloop.index0 }}:checked ~ .css-tabs-content-container .css-tab-content:nth-child({{ forloop.index }}) {
    display: block;
  }
{% endfor %}

@keyframes fadeInTabs {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===================== MOBILE ACCORDION ===================== */
.custom-accordion-wrapper {
  background: #fff;
  border: 1px solid #eaeaea;
  border-radius: 4px;
}
.custom-accordion-item {
  border-bottom: 1px solid #eaeaea;
}
.custom-accordion-item:last-child {
  border-bottom: none;
}
.custom-accordion-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: transparent;
  border: none;
  padding: 16px 20px !important;
  font-size: 15px !important;
  line-height: 1.4 !important;
  font-weight: 700;
  color: #002244;
  cursor: pointer;
  text-align: left;
  transition: background 0.3s ease;
  font-family: inherit;
  list-style: none;
}
.custom-accordion-header::-webkit-details-marker { display: none; }
.custom-accordion-header:hover { background: #f9f9f9; }

.custom-accordion-icon {
  font-size: 26px;
  font-weight: 400;
  line-height: 1;
  color: #002244;
}
.custom-accordion-icon::before { content: '+'; }
details[open] .custom-accordion-icon::before { content: '-'; }

.custom-accordion-content-wrapper {
  animation: slideDown 0.3s ease-out;
}
.custom-accordion-content {
  padding: 0 20px 20px 20px !important;
  color: #444;
}
.custom-accordion-content h3 {
  font-size: 18px;
  font-weight: 700;
  margin-bottom: 15px;
  color: #222;
}
.custom-accordion-text { font-size: 15px; line-height: 1.6; }
.custom-accordion-text p { margin-bottom: 15px; }
.custom-accordion-text p:last-child { margin-bottom: 0; }

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
  .custom-tabs-section {
    padding-top: 0 !important;
    margin-top: -15px !important;
  }
}
</style>

{% schema %}
{
  "name": "Custom Tabs",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active Tab Color",
      "default": "#016fd0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 5
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title",
          "default": "Tab Title"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Content Heading",
          "default": "Heading for this tab"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Content for this tab goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Tabs",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
