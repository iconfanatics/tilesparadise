{% if collection %}

<section class="collection-intro">
  <div class="page-width">

    <h1 class="collection-intro__title">
      {{ collection.title }}
    </h1>

    {%- comment -%} TOP intro = the SEO meta description (short). Full description shows below the grid. {%- endcomment -%}
    {% assign intro_text = page_description | default: collection.description | strip_html | truncatewords: 40 %}

    {% if intro_text != blank %}
      <div class="collection-intro__description rte">
        <p>{{ intro_text }}</p>
      </div>
    {% endif %}

  </div>
</section>

<style>
.collection-intro {
  padding: 40px 20px 6px;
  text-align: center;
}

.collection-intro__title {
    margin-bottom: 16px;
    font-family: Roboto;
    font-weight: 600;
    font-size: 29.1px;
    line-height: 33px;
    letter-spacing: 0%;
    text-align: center;
    color: #0D1F22;
}

.collection-intro__description {
    max-width: 820px;
    margin: 0 auto;
    font-family: Roboto;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    text-align: center;
    color: #4b5563;
}
</style>

{% endif %}

{% schema %}
{
  "name": "Collection Intro",
  "presets": [
    {
      "name": "Collection Intro"
    }
  ]
}
{% endschema %}
