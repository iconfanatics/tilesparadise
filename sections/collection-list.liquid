<section class="section collection-list-shop-by-color {{ section.settings.custom_class }}" data-section-id="{{ section.id }}" data-section-type="collection-list">
  <div class="container">
    {%- if section.settings.title != blank -%}
      <header class="section__header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 25px; text-align: left;">
        <h2 class="section__title custom-section-title" style="margin: 0;">{{ section.settings.title | escape }}</h2>

        {%- if section.settings.link_title != blank and section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="section__action-link link custom-view-all"><span>{{ section.settings.link_title | escape }}</span> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg></a>
        {%- endif -%}
      </header>
    {%- endif -%}

    <style>
      .custom-section-title {
        font-family: var(--heading-font-family), sans-serif !important;
        font-size: 26px !important;
        font-weight: 700 !important;
        color: #1a1a1a !important;
        text-transform: none !important;
        letter-spacing: normal !important;
      }
      .custom-view-all {
        color: #1e73be !important;
        font-weight: 500 !important;
        font-size: 14px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;
        text-decoration: none !important;
        margin: 0 !important;
        padding: 6px 16px !important;
        border: 1px solid rgba(30, 115, 190, 0.4) !important;
        border-radius: 4px !important;
        background-color: transparent !important;
        transition: all 0.3s ease !important;
      }
      .custom-view-all:hover {
        border-color: #1e73be !important;
        background-color: rgba(30, 115, 190, 0.04) !important;
      }
      .custom-view-all span {
        transform: translateX(10px);
        transition: transform 0.3s ease;
      }
      .custom-view-all:hover span {
        transform: translateX(0);
      }
      .custom-view-all svg {
        position: static !important;
        width: 14px;
        height: 14px;
        opacity: 0;
        transform: translateX(-10px);
        transition: all 0.3s ease;
      }
      .custom-view-all:hover svg {
        opacity: 1;
        transform: translateX(0);
      }
      
      /* Center align the collection boxes explicitly for Shop Bathrooms */
      .shop-bathrooms-sec .scroller__inner,
      .shop-bathrooms-sec .collection-list {
        display: flex !important;
        justify-content: center !important;
        flex-wrap: wrap !important;
        gap: 30px !important;
        width: 100% !important;
      }
      .shop-bathrooms-sec .collection-item {
        width: calc(25% - 30px) !important; /* Forces 4 columns on desktop without shrinking */
        min-width: 160px !important;
        text-align: center !important;
        margin: 0 !important;
      }
      .shop-bathrooms-sec .collection-item__title {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        text-align: center !important;
      }
      @media screen and (max-width: 768px) {
        .shop-bathrooms-sec .collection-item {
          width: calc(50% - 30px) !important; /* 2 columns on mobile */
        }
      }
    </style>

    {%- if section.settings.custom_class contains 'shop-by-room-grid' -%}
      {%- if section.settings.round_images -%}
        <style>
          .shop-room-card__image--rounded {
            border-radius: 50% !important;
            overflow: hidden;
            display: block;
          }
          .shop-room-card__image--rounded img {
            border-radius: 50% !important;
          }
        </style>
      {%- endif -%}
      <div class="shop-room-grid">
        {%- for block in section.blocks limit: section.settings.collections_to_show -%}
          {%- assign collection = block.settings.collection -%}
          {%- assign display_title = block.settings.title_override | default: collection.title -%}
          {%- assign collection_image = block.settings.image | default: collection.image | default: collection.products.first.featured_image -%}

          <a href="{{ block.settings.link | default: collection.url | default: '#' }}" class="shop-room-card" {{ block.shopify_attributes }}>
            <span class="shop-room-card__image {% if section.settings.round_images %}shop-room-card__image--rounded{% endif %}">
              {%- if collection_image != blank -%}
                {{- collection_image | image_url: width: collection_image.width | image_tag: loading: 'lazy', sizes: '180px', widths: '180,360,540' -}}
              {%- else -%}
                {%- capture placeholder -%}{% cycle 'collection-1', 'collection-2', 'collection-3', 'collection-4', 'collection-5', 'collection-6' %}{%- endcapture -%}
                {{- placeholder | placeholder_svg_tag: 'placeholder-svg' -}}
              {%- endif -%}
            </span>

            {%- if section.settings.show_collection_title -%}
              <span class="shop-room-card__title">{% if display_title != blank %}{{ display_title }}{% else %}{{ 'home_page.onboarding.collection_title' | t }}{% endif %}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    {%- elsif section.settings.custom_class contains 'trending-styles-sec' -%}
      <style>
        .trending-styles-grid {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 20px;
        }
        .trending-style-card {
          text-decoration: none;
          color: inherit;
          display: block;
        }
        .trending-style-image {
          border-radius: 8px;
          overflow: hidden;
          margin-bottom: 12px;
          position: relative;
          padding-bottom: 120%; /* Portrait aspect ratio */
        }
        .trending-style-image img, .trending-style-image svg {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
        .trending-style-title {
          font-weight: 700;
          font-size: 16px;
          margin-bottom: 4px;
          color: #353535;
        }
        .trending-style-link {
          color: #1e73be;
          font-size: 14px;
          font-weight: 600;
          text-decoration: underline;
        }
        @media screen and (max-width: 768px) {
          .trending-styles-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
          }
        }
      </style>
      <div class="trending-styles-grid">
        {%- for block in section.blocks limit: section.settings.collections_to_show -%}
          {%- assign collection = block.settings.collection -%}
          {%- assign display_title = block.settings.title_override | default: collection.title -%}
          {%- assign collection_image = block.settings.image | default: collection.image | default: collection.products.first.featured_image -%}

          <a href="{{ block.settings.link | default: collection.url | default: '#' }}" class="trending-style-card" {{ block.shopify_attributes }}>
            <div class="trending-style-image">
              {%- if collection_image != blank -%}
                {{- collection_image | image_url: width: collection_image.width | image_tag: loading: 'lazy', sizes: '280px', widths: '280,560,840' -}}
              {%- else -%}
                {%- capture placeholder -%}{% cycle 'collection-1', 'collection-2', 'collection-3', 'collection-4', 'collection-5', 'collection-6' %}{%- endcapture -%}
                {{- placeholder | placeholder_svg_tag: 'placeholder-svg' -}}
              {%- endif -%}
            </div>
            {%- if section.settings.show_collection_title -%}
              <div class="trending-style-title">
                {% if display_title != blank %}{{ display_title }}{% else %}{{ 'home_page.onboarding.collection_title' | t }}{% endif %}
              </div>
            {%- endif -%}
            <div class="trending-style-link">
              Shop now
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="scroller">
        <div class="scroller__inner">
          <div class="collection-list">
            {%- for block in section.blocks limit: section.settings.collections_to_show -%}
              {%- assign collection = block.settings.collection -%}
              {%- assign display_title = block.settings.title_override | default: collection.title -%}

              <a href="{{ block.settings.link | default: collection.url | default: '#' }}" class="collection-item" data-collection-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                {%- unless collection == blank -%}
                  {%- assign collection_image = block.settings.image | default: collection.image | default: collection.products.first.featured_image -%}

                  <div class="collection-item__image-wrapper {% if section.settings.round_images %}collection-item__image-wrapper--rounded{% endif %}">
                    <div class="aspect-ratio" style="padding-bottom: 100%">
                      {%- if collection_image != blank -%}
                        {{- collection_image | image_url: width: collection_image.width | image_tag: loading: 'lazy', sizes: '240px', widths: '240,480,720' -}}
                      {%- else -%}
                        {%- capture placeholder -%}{% cycle 'collection-1', 'collection-2', 'collection-3', 'collection-4', 'collection-5', 'collection-6' %}{%- endcapture -%}
                        {{- placeholder | placeholder_svg_tag: 'placeholder-svg' -}}
                      {%- endif -%}
                    </div>
                  </div>

                  {%- if section.settings.show_collection_title -%}
                    <span class="collection-item__title text--strong">{{ display_title }} {% render 'icon', icon: 'tail-right' %}</span>
                  {%- endif -%}
                {%- else -%}
                  <div class="collection-item__image-wrapper {% if section.settings.round_images %}collection-item__image-wrapper--rounded{% endif %}">
                    {%- capture placeholder -%}{% cycle 'collection-1', 'collection-2', 'collection-3', 'collection-4', 'collection-5', 'collection-6' %}{%- endcapture -%}
                    {{- placeholder | placeholder_svg_tag: 'placeholder-svg' -}}
                  </div>

                  {%- if section.settings.show_collection_title -%}
                    <span class="collection-item__title text--strong">{% if display_title != blank %}{{ display_title }}{% else %}{{ 'home_page.onboarding.collection_title' | t }}{% endif %} {% render 'icon', icon: 'tail-right' %}</span>
                  {%- endif -%}
                {%- endunless -%}
              </a>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our collections"
    },
    {
      "type": "text",
      "id": "link_title",
      "label": "Link title",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/collections"
    },
    {
      "type": "checkbox",
      "id": "round_images",
      "label": "Round images",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "label": "Show collection title",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class",
    },
    {
      "type": "range",
      "id": "collections_to_show",
      "label": "Maximum collections to show",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "600 x 600px .jpg recommended"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "If none is set, collection URL will be used."
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Collection",
      "name": "Collection list",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
