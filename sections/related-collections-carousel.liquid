{% assign section_id = section.id %}

<section class="rc-{{ section_id }} {{ section.settings.custom_class }}">
  <div class="rc-container">
    
    <!-- HEADER -->
    <div class="rc-header">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="rc-view-all">
          View All <img class="right-arrow-icon" src="{{ 'right-arrow.png' | file_url }}" alt="arrow" loading="lazy">
        </a>
      {% endif %}
    </div>

    <!-- SLIDER -->
    <div class="rc-slider-wrapper">
      <div class="rc-slider" id="slider-{{ section_id }}">
        
        {% for collection in product.collections limit: 10 %}
          <a href="{{ collection.url }}" class="rc-card">
            
            <div class="rc-img">
              {% if collection.featured_image %}
                <img 
                  src="{{ collection.featured_image | image_url: width: 400 }}" 
                  alt="{{ collection.title }}"
                  loading="lazy"
                >
              {% endif %}
            </div>

            <p class="rc-title">{{ collection.title }}</p>
          </a>
        {% endfor %}

      </div>
    </div>

    <!-- DOTS -->
    <div class="rc-dots" id="dots-{{ section_id }}"></div>

  </div>
</section>

<style>

.rc-container {
  padding-bottom: 50px;
}

.rc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
}

.rc-header h2 {
    color: #016FD0;
    font-family: Fraunces;
    font-weight: 900;
    font-style: Black;
    font-size: 48px;
    line-height: 130%;
    letter-spacing: 0px;
}

.rc-view-all {
    text-decoration: none;
    color: #000;
    font-family: Roboto;
    font-weight: 700;
    font-size: 25px;
    line-height: 24px;
    letter-spacing: 0%;
}

.rc-slider-wrapper {
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

.rc-slider-wrapper::-webkit-scrollbar {
  display: none;
}

.rc-slider {
  display: flex;
  gap: 20px;
  width: max-content;
  scroll-behavior: smooth;

  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  cursor: grab;
}

.rc-slider:active {
  cursor: grabbing;
}

.rc-slider::-webkit-scrollbar {
  display: none;
}

.rc-card {
  min-width: 285px;
  background: #fff;
  border-radius: 10px;
  padding: 10px;
  text-align: center;
  text-decoration: none;
  border: 1px solid #dbe3ef;
  transition: 0.3s;
   scroll-snap-align: start;
  flex-shrink: 0;
}

.rc-card:hover {
  border-color: #0a4fa3;
}

.rc-img {
  width: 100%;
  height: 120px;
  overflow: hidden;
  border-radius: 6px;
  margin-bottom: 10px;
}

.rc-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.rc-title {
  font-size: 13px;
  color: #222;
  font-weight: 500;
}

/* DOTS */
.rc-dots {
  text-align: center;
  margin-top: 15px;
}

.rc-dots span {
  display: inline-block;
  width: 6px;
  height: 6px;
  background: #ccc;
  border-radius: 50%;
  margin: 0 4px;
  cursor: pointer;
}

.rc-dots span.active {
  background: #000;
}


.rc-slider {
  cursor: grab;
  user-select: none;
}

.rc-slider.dragging {
  cursor: grabbing;
}

.rc-slider.dragging a {
  pointer-events: none;
}

.rc-slider {
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  touch-action: pan-x;
}

.rc-card {
  scroll-snap-align: start;
}
</style>

<script>
(function(){
  const slider = document.getElementById("slider-{{ section_id }}");
  const dotsContainer = document.getElementById("dots-{{ section_id }}");

  if (!slider) return;

  const cardWidth = 200;
  const total = Math.ceil(slider.scrollWidth / slider.clientWidth);

  // Create dots
  for (let i = 0; i < total; i++) {
    const dot = document.createElement("span");
    if (i === 0) dot.classList.add("active");

    dot.addEventListener("click", () => {
      slider.scrollTo({
        left: i * slider.clientWidth,
        behavior: "smooth"
      });
      updateDots(i);
    });

    dotsContainer.appendChild(dot);
  }

  function updateDots(index) {
    dotsContainer.querySelectorAll("span").forEach((d, i) => {
      d.classList.toggle("active", i === index);
    });
  }

  slider.addEventListener("scroll", () => {
    const index = Math.round(slider.scrollLeft / slider.clientWidth);
    updateDots(index);
  });
})();


const wrapper = document.querySelector(".rc-slider-wrapper");

let isDown = false;
let startX;
let scrollLeft;

wrapper.addEventListener("mousedown", (e) => {
  isDown = true;
  startX = e.pageX - wrapper.offsetLeft;
  scrollLeft = wrapper.scrollLeft;
});

wrapper.addEventListener("mouseleave", () => {
  isDown = false;
});

wrapper.addEventListener("mouseup", () => {
  isDown = false;
});

wrapper.addEventListener("mousemove", (e) => {
  if (!isDown) return;

  e.preventDefault();

  const x = e.pageX - wrapper.offsetLeft;
  const walk = (x - startX) * 2;

  wrapper.scrollLeft = scrollLeft - walk;
});

</script>

{% schema %}
{
  "name": "Related collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Related Collections"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class",
    }
  ],
  "presets": [
    {
      "name": "Related collections carousel"
    }
  ]
}
{% endschema %}